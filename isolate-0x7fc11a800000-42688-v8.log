script-source,676,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/utils/esm/fields.js,import { GraphQLObjectType\x2C } from 'graphql';\nimport { addTypes } from './addTypes.js';\nimport { MapperKind } from './Interfaces.js';\nimport { correctASTNodes\x2C mapSchema } from './mapSchema.js';\nexport function appendObjectFields(schema\x2C typeName\x2C additionalFields) {\n    if (schema.getType(typeName) == null) {\n        return addTypes(schema\x2C [\n            new GraphQLObjectType({\n                name: typeName\x2C\n                fields: additionalFields\x2C\n            })\x2C\n        ]);\n    }\n    return mapSchema(schema\x2C {\n        [MapperKind.OBJECT_TYPE]: type => {\n            if (type.name === typeName) {\n                const config = type.toConfig();\n                const originalFieldConfigMap = config.fields;\n                const newFieldConfigMap = {};\n                for (const fieldName in originalFieldConfigMap) {\n                    newFieldConfigMap[fieldName] = originalFieldConfigMap[fieldName];\n                }\n                for (const fieldName in additionalFields) {\n                    newFieldConfigMap[fieldName] = additionalFields[fieldName];\n                }\n                return correctASTNodes(new GraphQLObjectType({\n                    ...config\x2C\n                    fields: newFieldConfigMap\x2C\n                }));\n            }\n        }\x2C\n    });\n}\nexport function removeObjectFields(schema\x2C typeName\x2C testFn) {\n    const removedFields = {};\n    const newSchema = mapSchema(schema\x2C {\n        [MapperKind.OBJECT_TYPE]: type => {\n            if (type.name === typeName) {\n                const config = type.toConfig();\n                const originalFieldConfigMap = config.fields;\n                const newFieldConfigMap = {};\n                for (const fieldName in originalFieldConfigMap) {\n                    const originalFieldConfig = originalFieldConfigMap[fieldName];\n                    if (testFn(fieldName\x2C originalFieldConfig)) {\n                        removedFields[fieldName] = originalFieldConfig;\n                    }\n                    else {\n                        newFieldConfigMap[fieldName] = originalFieldConfig;\n                    }\n                }\n                return correctASTNodes(new GraphQLObjectType({\n                    ...config\x2C\n                    fields: newFieldConfigMap\x2C\n                }));\n            }\n        }\x2C\n    });\n    return [newSchema\x2C removedFields];\n}\nexport function selectObjectFields(schema\x2C typeName\x2C testFn) {\n    const selectedFields = {};\n    mapSchema(schema\x2C {\n        [MapperKind.OBJECT_TYPE]: type => {\n            if (type.name === typeName) {\n                const config = type.toConfig();\n                const originalFieldConfigMap = config.fields;\n                for (const fieldName in originalFieldConfigMap) {\n                    const originalFieldConfig = originalFieldConfigMap[fieldName];\n                    if (testFn(fieldName\x2C originalFieldConfig)) {\n                        selectedFields[fieldName] = originalFieldConfig;\n                    }\n                }\n            }\n            return undefined;\n        }\x2C\n    });\n    return selectedFields;\n}\nexport function modifyObjectFields(schema\x2C typeName\x2C testFn\x2C newFields) {\n    const removedFields = {};\n    const newSchema = mapSchema(schema\x2C {\n        [MapperKind.OBJECT_TYPE]: type => {\n            if (type.name === typeName) {\n                const config = type.toConfig();\n                const originalFieldConfigMap = config.fields;\n                const newFieldConfigMap = {};\n                for (const fieldName in originalFieldConfigMap) {\n                    const originalFieldConfig = originalFieldConfigMap[fieldName];\n                    if (testFn(fieldName\x2C originalFieldConfig)) {\n                        r