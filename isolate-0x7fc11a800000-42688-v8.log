script-source,1801,/Users/mac/Kelechi/node-chat-app/node_modules/color-convert/route.js,const conversions = require('./conversions');\n\n/*\n\x09This function routes a model to all other models.\n\n\x09all functions that are routed have a property `.conversion` attached\n\x09to the returned synthetic function. This property is an array\n\x09of strings\x2C each with the steps in between the 'from' and 'to'\n\x09color models (inclusive).\n\n\x09conversions that are not possible simply are not included.\n*/\n\nfunction buildGraph() {\n\x09const graph = {};\n\x09// https://jsperf.com/object-keys-vs-for-in-with-closure/3\n\x09const models = Object.keys(conversions);\n\n\x09for (let len = models.length\x2C i = 0; i < len; i++) {\n\x09\x09graph[models[i]] = {\n\x09\x09\x09// http://jsperf.com/1-vs-infinity\n\x09\x09\x09// micro-opt\x2C but this is simple.\n\x09\x09\x09distance: -1\x2C\n\x09\x09\x09parent: null\n\x09\x09};\n\x09}\n\n\x09return graph;\n}\n\n// https://en.wikipedia.org/wiki/Breadth-first_search\nfunction deriveBFS(fromModel) {\n\x09const graph = buildGraph();\n\x09const queue = [fromModel]; // Unshift -> queue -> pop\n\n\x09graph[fromModel].distance = 0;\n\n\x09while (queue.length) {\n\x09\x09const current = queue.pop();\n\x09\x09const adjacents = Object.keys(conversions[current]);\n\n\x09\x09for (let len = adjacents.length\x2C i = 0; i < len; i++) {\n\x09\x09\x09const adjacent = adjacents[i];\n\x09\x09\x09const node = graph[adjacent];\n\n\x09\x09\x09if (node.distance === -1) {\n\x09\x09\x09\x09node.distance = graph[current].distance + 1;\n\x09\x09\x09\x09node.parent = current;\n\x09\x09\x09\x09queue.unshift(adjacent);\n\x09\x09\x09}\n\x09\x09}\n\x09}\n\n\x09return graph;\n}\n\nfunction link(from\x2C to) {\n\x09return function (args) {\n\x09\x09return to(from(args));\n\x09};\n}\n\nfunction wrapConversion(toModel\x2C graph) {\n\x09const path = [graph[toModel].parent\x2C toModel];\n\x09let fn = conversions[graph[toModel].parent][toModel];\n\n\x09let cur = graph[toModel].parent;\n\x09while (graph[cur].parent) {\n\x09\x09path.unshift(graph[cur].parent);\n\x09\x09fn = link(conversions[graph[cur].parent][cur]\x2C fn);\n\x09\x09cur = graph[cur].parent;\n\x09}\n\n\x09fn.conversion = path;\n\x09return fn;\n}\n\nmodule.exports = function (fromModel) {\n\x09const graph = deriveBFS(fromModel);\n\x09const conversion = {};\n\n\x09const models = Object.keys(graph);\n\x09for (let len = models.length\x2C i = 0; i < len; i++) {\n\x09\x09const toModel = models[i];\n\x09\x09const node = graph[toModel];\n\n\x09\x09if (node.parent === null) {\n\x09\x09\x09// No possible conversion\x2C or this node is the source model.\n\x09\x09\x09continue;\n\x09\x09}\n\n\x09\x09conversion[toModel] = wrapConversion(toModel\x2C graph);\n\x09}\n\n\x09return conversion;\n};\n\n
