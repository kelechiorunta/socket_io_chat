script-source,1757,/Users/mac/Kelechi/node-chat-app/node_modules/sharp/lib/constructor.js,// Copyright 2013 Lovell Fuller and others.\n// SPDX-License-Identifier: Apache-2.0\n\n'use strict';\n\nconst util = require('node:util');\nconst stream = require('node:stream');\nconst is = require('./is');\n\nrequire('./sharp');\n\n// Use NODE_DEBUG=sharp to enable libvips warnings\nconst debuglog = util.debuglog('sharp');\n\n/**\n * Constructor factory to create an instance of `sharp`\x2C to which further methods are chained.\n *\n * JPEG\x2C PNG\x2C WebP\x2C GIF\x2C AVIF or TIFF format image data can be streamed out from this object.\n * When using Stream based output\x2C derived attributes are available from the `info` event.\n *\n * Non-critical problems encountered during processing are emitted as `warning` events.\n *\n * Implements the [stream.Duplex](http://nodejs.org/api/stream.html#stream_class_stream_duplex) class.\n *\n * When loading more than one page/frame of an animated image\x2C\n * these are combined as a vertically-stacked "toilet roll" image\n * where the overall height is the `pageHeight` multiplied by the number of `pages`.\n *\n * @constructs Sharp\n *\n * @emits Sharp#info\n * @emits Sharp#warning\n *\n * @example\n * sharp('input.jpg')\n *   .resize(300\x2C 200)\n *   .toFile('output.jpg'\x2C function(err) {\n *     // output.jpg is a 300 pixels wide and 200 pixels high image\n *     // containing a scaled and cropped version of input.jpg\n *   });\n *\n * @example\n * // Read image data from remote URL\x2C\n * // resize to 300 pixels wide\x2C\n * // emit an 'info' event with calculated dimensions\n * // and finally write image data to writableStream\n * const { body } = fetch('https://...');\n * const readableStream = Readable.fromWeb(body);\n * const transformer = sharp()\n *   .resize(300)\n *   .on('info'\x2C ({ height }) => {\n *     console.log(`Image height is ${height}`);\n *   });\n * readableStream.pipe(transformer).pipe(writableStream);\n *\n * @example\n * // Create a blank 300x200 PNG image of semi-translucent red pixels\n * sharp({\n *   create: {\n *     width: 300\x2C\n *     height: 200\x2C\n *     channels: 4\x2C\n *     background: { r: 255\x2C g: 0\x2C b: 0\x2C alpha: 0.5 }\n *   }\n * })\n * .png()\n * .toBuffer()\n * .then( ... );\n *\n * @example\n * // Convert an animated GIF to an animated WebP\n * await sharp('in.gif'\x2C { animated: true }).toFile('out.webp');\n *\n * @example\n * // Read a raw array of pixels and save it to a png\n * const input = Uint8Array.from([255\x2C 255\x2C 255\x2C 0\x2C 0\x2C 0]); // or Uint8ClampedArray\n * const image = sharp(input\x2C {\n *   // because the input does not contain its dimensions or how many channels it has\n *   // we need to specify it in the constructor options\n *   raw: {\n *     width: 2\x2C\n *     height: 1\x2C\n *     channels: 3\n *   }\n * });\n * await image.toFile('my-two-pixels.png');\n *\n * @example\n * // Generate RGB Gaussian noise\n * await sharp({\n *   create: {\n *     width: 300\x2C\n *     height: 200\x2C\n *     channels: 3\x2C\n *     noise: {\n *       type: 'gaussian'\x2C\n *       mean: 128\x2C\n *       sigma: 30\n *     }\n *  }\n * }).toFile('noise.png');\n *\n * @example\n * // Generate an image from text\n * await sharp({\n *   text: {\n *     text: 'Hello\x2C world!'\x2C\n *     width: 400\x2C // max width\n *     height: 300 // max height\n *   }\n * }).toFile('text_bw.png');\n *\n * @example\n * // Generate an rgba image from text using pango markup and font\n * await sharp({\n *   text: {\n *     text: '<span foreground="red">Red!</span><span background="cyan">blue</span>'\x2C\n *     font: 'sans'\x2C\n *     rgba: true\x2C\n *     dpi: 300\n *   }\n * }).toFile('text_rgba.png');\n *\n * @example\n * // Join four input images as a 2x2 grid with a 4 pixel gutter\n * const data = await sharp(\n *  [image1\x2C image2\x2C image3\x2C image4]\x2C\n *  { join: { across: 2\x2C shim: 4 } }\n * ).toBuffer();\n *\n * @example\n * // Generate a two-frame animated image from emoji\n * const images = ['\ud83d\ude00'\x2C '\ud83d\ude1b'].map(text => ({\n *   text: { text\x2C width: 64\x2C height: 64\x2C channels: 4\x2C rgba: true }\n * }));\n * await sharp(images\x2C { join: { animated: true } }).toFile('out.gif');\n *\n * @param {(Buffer|ArrayBuffer|Uint8Array|Uint8ClampedArray|Int8Array|Uint16Array|Int16Array|Uint32Array|Int32Array|Float32Array|Float64Array|string|Array)} [input] - if present\x2C can be\n *  a Buffer / ArrayBuffer / Uint8Array / Uint8ClampedArray containing JPEG\x2C PNG\x2C WebP\x2C AVIF\x2C GIF\x2C SVG or TIFF image data\x2C or\n *  a TypedArray containing raw pixel image data\x2C or\n *  a String containing the filesystem path to an JPEG\x2C PNG\x2C WebP\x2C AVIF\x2C GIF\x2C SVG or TIFF image file.\n *  An array of inputs can be provided\x2C and these will be joined together.\n *  JPEG\x2C PNG\x2C WebP\x2C AVIF\x2C GIF\x2C SVG\x2C TIFF or raw pixel image data can be streamed into the object when not present.\n * @param {Object} [options] - if present\x2C is an Object with optional attributes.\n * @param {string} [options.failOn='warning'] - When to abort processing of invalid pixel data\x2C one of (in order of sensitivity\x2C least to most): 'none'\x2C 'truncated'\x2C 'error'\x2C 'warning'. Higher levels imply lower levels. Invalid metadata will always abort.\n * @param {number|boolean} [options.limitInputPixels=268402689] - Do not process input images where the number of pixels\n *  (width x height) exceeds this limit. Assumes image dimensions contained in the input metadata can be trusted.\n *  An integral Number of pixels\x2C zero or false to remove limit\x2C true to use default limit of 268402689 (0x3FFF x 0x3FFF).\n * @param {boolean} [options.unlimited=false] - Set this to `true` to remove safety features that help prevent memory exhaustion (JPEG\x2C PNG\x2C SVG\x2C HEIF).\n * @param {boolean} [options.autoOrient=false] - Set this to `true` to rotate/flip the image to match EXIF `Orientation`\x2C if any.\n * @param {boolean} [options.sequentialRead=true] - Set this to `false` to use random access rather than sequential read. Some operations will do this automatically.\n * @param {number} [options.density=72] - number representing the DPI for vector images in the range 1 to 100000.\n * @param {number} [options.ignoreIcc=false] - should the embedded ICC profile\x2C if any\x2C be ignored.\n * @param {number} [options.pages=1] - Number of pages to extract for multi-page input (GIF\x2C WebP\x2C TIFF)\x2C use -1 for all pages.\n * @param {number} [options.page=0] - Page number to start extracting from for multi-page input (GIF\x2C WebP\x2C TIFF)\x2C zero based.\n * @param {boolean} [options.animated=false] - Set to `true` to read all frames/pages of an animated image (GIF\x2C WebP\x2C TIFF)\x2C equivalent of setting `pages` to `-1`.\n * @param {Object} [options.raw] - describes raw pixel input image data. See `raw()` for pixel ordering.\n * @param {number} [options.raw.width] - integral number of pixels wide.\n * @param {number} [options.raw.height] - integral number of pixels high.\n * @param {number} [options.raw.channels] - integral number of channels\x2C between 1 and 4.\n * @param {boolean} [options.raw.premultiplied] - specifies that the raw input has already been premultiplied\x2C set to `true`\n *  to avoid sharp premultiplying the image. (optional\x2C default `false`)\n * @param {number} [options.raw.pageHeight] - The pixel height of each page/frame for animated images\x2C must be an integral factor of `raw.height`.\n * @param {Object} [options.create] - describes a new image to be created.\n * @param {number} [options.create.width] - integral number of pixels wide.\n * @param {number} [options.create.height] - integral number of pixels high.\n * @param {number} [options.create.channels] - integral number of channels\x2C either 3 (RGB) or 4 (RGBA).\n * @param {string|Object} [options.create.background] - parsed by the [color](https://www.npmjs.org/package/color) module to extract values for red\x2C green\x2C blue and alpha.\n * @param {number} [options.create.pageHeight] - The pixel height of each page/frame for animated images\x2C must be an integral factor of `create.height`.\n * @param {Object} [options.create.noise] - describes a noise to be created.\n * @param {string} [options.create.noise.type] - type of generated noise\x2C currently only `gaussian` is supported.\n * @param {number} [options.create.noise.mean=128] - Mean value of pixels in the generated noise.\n * @param {number} [options.create.noise.sigma=30] - Standard deviation of pixel values in the generated noise.\n * @param {Object} [options.text] - describes a new text image to be created.\n * @param {string} [options.text.text] - text to render as a UTF-8 string. It can contain Pango markup\x2C for example `<i>Le</i>Monde`.\n * @param {string} [options.text.font] - font name to render with.\n * @param {string} [options.text.fontfile] - absolute filesystem path to a font file that can be used by `font`.\n * @param {number} [options.text.width=0] - Integral number of pixels to word-wrap at. Lines of text wider than this will be broken at word boundaries.\n * @param {number} [options.text.height=0] - Maximum integral number of pixels high. When defined\x2C `dpi` will be ignored and the text will automatically fit the pixel resolution defined by `width` and `height`. Will be ignored if `width` is not specified or set to 0.\n * @param {string} [options.text.align='left'] - Alignment style for multi-line text (`'left'`\x2C `'centre'`\x2C `'center'`\x2C `'right'`).\n * @param {boolean} [options.text.justify=false] - set this to true to apply justification to the text.\n * @param {number} [options.text.dpi=72] - the resolution (size) at which to render the text. Does not take effect if `height` is specified.\n * @param {boolean} [options.text.rgba=false] - set this to true to enable RGBA output. This is useful for colour emoji rendering\x2C or support for pango markup features like `<span foreground="red">Red!</span>`.\n * @param {number} [options.text.spacing=0] - text line height in points. Will use the font line height if none is specified.\n * @param {string} [options.text.wrap='word'] - word wrapping style when width is provided\x2C one of: 'word'\x2C 'char'\x2C 'word-char' (prefer word\x2C fallback to char) or 'none'.\n * @param {Object} [options.join] - describes how an array of input images should be joined.\n * @param {number} [options.join.across=1] - number of images to join horizontally.\n * @param {boolean} [options.join.animated=false] - set this to `true` to join the images as an animated image.\n * @param {number} [options.join.shim=0] - number of pixels to insert between joined images.\n * @param {string|Object} [options.join.background] - parsed by the [color](https://www.npmjs.org/package/color) module to extract values for red\x2C green\x2C blue and alpha.\n * @param {string} [options.join.halign='left'] - horizontal alignment style for images joined horizontally (`'left'`\x2C `'centre'`\x2C `'center'`\x2C `'right'`).\n * @param {string} [options.join.valign='top'] - vertical alignment style for images joined vertically (`'top'`\x2C `'centre'`\x2C `'center'`\x2C `'bottom'`).\n * @param {Object} [options.tiff] - Describes TIFF specific options.\n * @param {number} [options.tiff.subifd=-1] - Sub Image File Directory to extract for OME-TIFF\x2C defaults to main image.\n * @param {Object} [options.svg] - Describes SVG specific options.\n * @param {string} [options.svg.stylesheet] - Custom CSS for SVG input\x2C applied with a User Origin during the CSS cascade.\n * @param {boolean} [options.svg.highBitdepth=false] - Set to `true` to render SVG input at 32-bits per channel (128-bit) instead of 8-bits per channel (32-bit) RGBA.\n * @param {Object} [options.pdf] - Describes PDF specific options. Requires the use of a globally-installed libvips compiled with support for PDFium\x2C Poppler\x2C ImageMagick or GraphicsMagick.\n * @param {string|Object} [options.pdf.background] - Background colour to use when PDF is partially transparent. Parsed by the [color](https://www.npmjs.org/package/color) module to extract values for red\x2C green\x2C blue and alpha.\n * @param {Object} [options.openSlide] - Describes OpenSlide specific options. Requires the use of a globally-installed libvips compiled with support for OpenSlide.\n * @param {number} [options.openSlide.level=0] - Level to extract from a multi-level input\x2C zero based.\n * @param {Object} [options.jp2] - Describes JPEG 2000 specific options. Requires the use of a globally-installed libvips compiled with support for OpenJPEG.\n * @param {boolean} [options.jp2.oneshot=false] - Set to `true` to decode tiled JPEG 2000 images in a single operation\x2C improving compatibility.\n * @returns {Sharp}\n * @throws {Error} Invalid parameters\n */\nconst Sharp = function (input\x2C options) {\n  if (arguments.length === 1 && !is.defined(input)) {\n    throw new Error('Invalid input');\n  }\n  if (!(this instanceof Sharp)) {\n    return new Sharp(input\x2C options);\n  }\n  stream.Duplex.call(this);\n  this.options = {\n    // resize options\n    topOffsetPre: -1\x2C\n    leftOffsetPre: -1\x2C\n    widthPre: -1\x2C\n    heightPre: -1\x2C\n    topOffsetPost: -1\x2C\n    leftOffsetPost: -1\x2C\n    widthPost: -1\x2C\n    heightPost: -1\x2C\n    width: -1\x2C\n    height: -1\x2C\n    canvas: 'crop'\x2C\n    position: 0\x2C\n    resizeBackground: [0\x2C 0\x2C 0\x2C 255]\x2C\n    angle: 0\x2C\n    rotationAngle: 0\x2C\n    rotationBackground: [0\x2C 0\x2C 0\x2C 255]\x2C\n    rotateBeforePreExtract: false\x2C\n    flip: false\x2C\n    flop: false\x2C\n    extendTop: 0\x2C\n    extendBottom: 0\x2C\n    extendLeft: 0\x2C\n    extendRight: 0\x2C\n    extendBackground: [0\x2C 0\x2C 0\x2C 255]\x2C\n    extendWith: 'background'\x2C\n    withoutEnlargement: false\x2C\n    withoutReduction: false\x2C