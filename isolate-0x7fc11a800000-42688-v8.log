script-source,662,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/utils/esm/build-operation-for-field.js,import { getNamedType\x2C isEnumType\x2C isInterfaceType\x2C isListType\x2C isNonNullType\x2C isObjectType\x2C isScalarType\x2C isUnionType\x2C Kind\x2C } from 'graphql';\nimport { getDefinedRootType\x2C getRootTypeNames } from './rootTypes.js';\nlet operationVariables = [];\nlet fieldTypeMap = new Map();\nfunction addOperationVariable(variable) {\n    operationVariables.push(variable);\n}\nfunction resetOperationVariables() {\n    operationVariables = [];\n}\nfunction resetFieldMap() {\n    fieldTypeMap = new Map();\n}\nexport function buildOperationNodeForField({ schema\x2C kind\x2C field\x2C models\x2C ignore = []\x2C depthLimit\x2C circularReferenceDepth\x2C argNames\x2C selectedFields = true\x2C }) {\n    resetOperationVariables();\n    resetFieldMap();\n    const rootTypeNames = getRootTypeNames(schema);\n    const operationNode = buildOperationAndCollectVariables({\n        schema\x2C\n        fieldName: field\x2C\n        kind\x2C\n        models: models || []\x2C\n        ignore\x2C\n        depthLimit: depthLimit || Infinity\x2C\n        circularReferenceDepth: circularReferenceDepth || 1\x2C\n        argNames\x2C\n        selectedFields\x2C\n        rootTypeNames\x2C\n    });\n    // attach variables\n    operationNode.variableDefinitions = [...operationVariables];\n    resetOperationVariables();\n    resetFieldMap();\n    return operationNode;\n}\nfunction buildOperationAndCollectVariables({ schema\x2C fieldName\x2C kind\x2C models\x2C ignore\x2C depthLimit\x2C circularReferenceDepth\x2C argNames\x2C selectedFields\x2C rootTypeNames\x2C }) {\n    const type = getDefinedRootType(schema\x2C kind);\n    const field = type.getFields()[fieldName];\n    const operationName = `${fieldName}_${kind}`;\n    if (field.args) {\n        for (const arg of field.args) {\n            const argName = arg.name;\n            if (!argNames || argNames.includes(argName)) {\n                addOperationVariable(resolveVariable(arg\x2C argName));\n            }\n        }\n    }\n    return {\n        kind: Kind.OPERATION_DEFINITION\x2C\n        operation: kind\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: operationName\x2C\n        }\x2C\n        variableDefinitions: []\x2C\n        selectionSet: {\n            kind: Kind.SELECTION_SET\x2C\n            selections: [\n                resolveField({\n                    type\x2C\n                    field\x2C\n                    models\x2C\n                    firstCall: true\x2C\n                    path: []\x2C\n                    ancestors: []\x2C\n                    ignore\x2C\n                    depthLimit\x2C\n                    circularReferenceDepth\x2C\n                    schema\x2C\n                    depth: 0\x2C\n                    argNames\x2C\n                    selectedFields\x2C\n                    rootTypeNames\x2C\n                })\x2C\n            ]\x2C\n        }\x2C\n    };\n}\nfunction resolveSelectionSet({ parent\x2C type\x2C models\x2C firstCall\x2C path\x2C ancestors\x2C ignore\x2C depthLimit\x2C circularReferenceDepth\x2C schema\x2C depth\x2C argNames\x2C selectedFields\x2C rootTypeNames\x2C }) {\n    if (typeof selectedFields === 'boolean' && depth > depthLimit) {\n        return;\n    }\n    if (isUnionType(type)) {\n        const types = type.getTypes();\n        return {\n            kind: Kind.SELECTION_SET\x2C\n            selections: types\n                .filter(t => !hasCircularRef([...ancestors\x2C t]\x2C {\n                depth: circularReferenceDepth\x2C\n            }))\n                .map(t => {\n                return {\n                    kind: Kind.INLINE_FRAGMENT\x2C\n                    typeCondition: {\n                        kind: Kind.NAMED_TYPE\x2C\n                        name: {\n                            kind: Kind.NAME\x2C\n                            value: t.name\x2C\n                        }\x2C\n                    }\x2C\n                    selectionSet: resolveSelectionSet({\n                        parent: type\x2C\n                        type: t\x2C\n                        models\x2C\n                        path\x2C\n                        ancestors\x2C\n                        ignore\x2C\n                        depthLimit\x2C\n                        circularReferenceDepth\x2C\n                        schema\x2C\n                        depth\x2C\n                        argNames\x2C\n                        selectedFields\x2C\n                        rootTypeNames\x2C\n                    })\x2C\n                };\n            })\n                .filter(fragmentNode => fragmentNode?.selectionSet?.selections?.length > 0)\x2C\n        };\n    }\n    if (isInterfaceType(type)) {\n        const types = Object.values(schema.getTypeMap()).filter((t) => isObjectType(t) && t.getInterfaces().includes(type));\n        return {\n            kind: Kind.SELECTION_SET\x2C\n            selections: types\n                .filter(t => !hasCircularRef([...ancestors\x2C t]\x2C {\n                depth: circularReferenceDepth\x2C\n            }))\n                .map(t => {\n                return {\n                    kind: Kind.INLINE_FRAGMENT\x2C\n                    typeCondition: {\n                        kind: Kind.NAMED_TYPE\x2C\n                        name: {\n                            kind: Kind.NAME\x2C\n                            value: t.name\x2C\n                        }\x2C\n                    }\x2C\n                    selectionSet: resolveSelectionSet({\n                        parent: type\x2C\n                        type: t\x2C\n                        models\x2C\n                        path\x2C\n                        ancestors\x2C\n                        ignore\x2C\n                        depthLimit\x2C\n                        circularReferenceDepth\x2C\n                        schema\x2C\n                        depth\x2C\n                        argNames\x2C\n                        selectedFields\x2C\n                        rootTypeNames\x2C\n                    })\x2C\n                };\n            })\n                .filter(fragmentNode => fragmentNode?.selectionSet?.selections?.length > 0)\x2C\n        };\n    }\n    if (isObjectType(type) && !rootTypeNames.has(type.name)) {\n        const isIgnored = ignore.includes(type.name) || ignore.includes(`${parent.name}.${path[path.length - 1]}`);\n        const isModel = models.includes(type.name);\n        if (!firstCall && isModel && !isIgnored) {\n            return {\n                kind: Kind.SELECTION_SET\x2C\n                selections: [\n                    {\n                        kind: Kind.FIELD\x2C\n                        name: {\n                            kind: Kind.NAME\x2C\n                            value: 'id'\x2C\n                        }\x2C\n                    }\x2C\n                ]\x2C\n            };\n        }\n        const fields = type.getFields();\n        return {\n            kind: Kind.SELECTION_SET\x2C\n            selections: Object.keys(fields)\n                .filter(fieldName => {\n                return !hasCircularRef([...ancestors\x2C getNamedType(fields[fieldName].type)]\x2C {\n                    depth: circularReferenceDepth\x2C\n                });\n            })\n                .map(fieldName => {\n                const selectedSubFields = typeof selectedFields === 'object' ? selectedFields[fieldName] : true;\n                if (selectedSubFields) {\n                    return resolveField({\n                        type\x2C\n                        field: fields[fieldName]\x2C\n                        models\x2C\n                        path: [...path\x2C fieldName]\x2C\n                        ancestors\x2C\n                        ignore\x2C\n                        depthLimit\x2C\n                        circularReferenceDepth\x2C\n                        schema\x2C\n                        depth\x2C\n                        argNames\x2C\n                        selectedFields: selectedSubFields\x2C\n                        rootTypeNames\x2C\n                    });\n                }\n                return null;\n            })\n                .filter((f) => {\n                if (f == null) {\n                    return false;\n                }\n                else if ('selectionSet' in f) {\n                    return !!f.selectionSet?.selections?.length;\n                }\n                return true;\n            })\x2C\n        };\n    }\n}\nfunction resolveVariable(arg\x2C name) {\n    function resolveVariableType(type) {\n        if (isListType(type)) {\n            return {\n                kind: Kind.LIST_TYPE\x2C\n                type: resolveVariableType(type.ofType)\x2C\n            };\n        }\n        if (isNonNullType(type)) {\n            return {\n                kind: Kind.NON_NULL_TYPE\x2C\n                // for v16 compatibility\n                type: resolveVariableType(type.ofType)\x2C\n            };\n        }\n        return {\n            kind: Kind.NAMED_TYPE\x2C\n            name: {\n                kind: Kind.NAME\x2C\n                value: type.name\x2C\n            }\x2C\n        };\n    }\n    return {\n        kind: Kind.VARIABLE_DEFINITION\x2C\n        variable: {\n            kind: Kind.VARIABLE\x2C\n            name: {\n                kind: Kind.NAME\x2C\n                value: name || arg.name\x2C\n            }\x2C\n        }\x2C\n        type: resolveVariableType(arg.type)\x2C\n    };\n}\nfunction getArgumentName(name\x2C path) {\n    return [...path\x2C name].join('_');\n}\nfunction resolveField({ type\x2C field\x2C models\x2C firstCall\x2C path\x2C ancestors\x2C ignore\x2C depthLimit\x2C circularReferenceDepth\x2C schema\x2C depth\x2C argNames\x2C selectedFields\x2C rootTypeNames\x2C }) {\n    const namedType = getNamedType(field.type);\n    let args = [];\n    let removeField = false;\n    if (field.args && field.args.length) {\n        args = field.args\n            .map(arg => {\n            const argumentName = getArgumentName(arg.name\x2C path);\n            if (argNames && !argNames.includes(argumentName)) {\n                if (isNonNullType(arg.type)) {\n                    removeField = true;\n                }\n                return null;\n            }\n            if (!firstCall) {\n                addOperationVariable(resolveVariable(arg\x2C argumentName));\n            }\n            return {\n                kind: Kind.ARGUMENT\x2C\n                name: {\n                    kind: Kind.NAME\x2C\n                    value: arg.name\x2C\n                }\x2C\n                value: {\n                    kind: Kind.VARIABLE\x2C\n                    name: {\n                        kind: Kind.NAME\x2C\n                        value: getArgumentName(arg.name\x2C path)\x2C\n                    }\x2C\n                }\x2C\n            };\n        })\n            .filter(Boolean);\n    }\n    if (removeField) {\n        return null;\n    }\n    const fieldPath = [...path\x2C field.name];\n    const fieldPathStr = fieldPath.join('.');\n    let fieldName = field.name;\n    if (fieldTypeMap.has(fieldPathStr) && fieldTypeMap.get(fieldPathStr) !== field.type.toString()) {\n        fieldName += field.type\n            .toString()\n            .replace(/!/g\x2C 'NonNull')\n            .replace(/\\[/g\x2C 'List')\n            .replace(/\\]/g\x2C '');\n    }\n    fieldTypeMap.set(fieldPathStr\x2C field.type.toString());\n    if (!isScalarType(namedType) && !isEnumType(namedType)) {\n        return {\n            kind: Kind.FIELD\x2C\n            name: {\n                kind: Kind.NAME\x2C\n                value: field.name\x2C\n            }\x2C\n            ...(fieldName !== field.name && { alias: { kind: Kind.NAME\x2C value: fieldName } })\x2C\n            selectionSet: resolveSelectionSet({\n                parent: type\x2C\n                type: namedType\x2C\n                models\x2C\n                firstCall\x2C\n                path: fieldPath\x2C\n                ancestors: [...ancestors\x2C type]\x2C\n                ignore\x2C\n                depthLimit\x2C\n                circularReferenceDepth\x2C\n                schema\x2C\n                depth: depth + 1\x2C\n                argNames\x2C\n                selectedFields\x2C\n                rootTypeNames\x2C\n            }) || undefined\x2C\n            arguments: args\x2C\n        };\n    }\n    return {\n        kind: Kind.FIELD\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: field.name\x2C\n        }\x2C\n        ...(fieldName !== field.name && { alias: { kind: Kind.NAME\x2C value: fieldName } })\x2C\n        arguments: args\x2C\n    };\n}\nfunction hasCircularRef(types\x2C config = {\n    depth: 1\x2C\n}) {\n    const type = types[types.length - 1];\n    if (isScalarType(type)) {\n        return false;\n    }\n    const size = types.filter(t => t.name === type.name).length;\n    return size > config.depth;\n}\n
