script-source,1489,/Users/mac/Kelechi/node-chat-app/node_modules/mongoose/lib/schema/union.js,'use strict';\n\n/*!\n * ignore\n */\n\nconst SchemaUnionOptions = require('../options/schemaUnionOptions');\nconst SchemaType = require('../schemaType');\n\nconst firstValueSymbol = Symbol('firstValue');\n\n/*!\n * ignore\n */\n\nclass Union extends SchemaType {\n  constructor(key\x2C options\x2C schemaOptions = {}) {\n    super(key\x2C options\x2C 'Union');\n    if (!options || !Array.isArray(options.of) || options.of.length === 0) {\n      throw new Error('Union schema type requires an array of types');\n    }\n    this.schemaTypes = options.of.map(obj => options.parentSchema.interpretAsType(key\x2C obj\x2C schemaOptions));\n  }\n\n  cast(val\x2C doc\x2C init\x2C prev\x2C options) {\n    let firstValue = firstValueSymbol;\n    let lastError;\n    // Loop through each schema type in the union. If one of the schematypes returns a value that is `=== val`\x2C then\n    // use `val`. Otherwise\x2C if one of the schematypes casted successfully\x2C use the first successfully casted value.\n    // Finally\x2C if none of the schematypes casted successfully\x2C throw the error from the last schema type in the union.\n    // The `=== val` check is a workaround to ensure that the original value is returned if it matches one of the schema types\x2C\n    // avoiding cases like where numbers are casted to strings or dates even if the schema type is a number.\n    for (let i = 0; i < this.schemaTypes.length; ++i) {\n      try {\n        const casted = this.schemaTypes[i].cast(val\x2C doc\x2C init\x2C prev\x2C options);\n        if (casted === val) {\n          return casted;\n        }\n        if (firstValue === firstValueSymbol) {\n          firstValue = casted;\n        }\n      } catch (error) {\n        lastError = error;\n      }\n    }\n    if (firstValue !== firstValueSymbol) {\n      return firstValue;\n    }\n    throw lastError;\n  }\n\n  // Setters also need to be aware of casting - we need to apply the setters of the entry in the union we choose.\n  applySetters(val\x2C doc\x2C init\x2C prev\x2C options) {\n    let firstValue = firstValueSymbol;\n    let lastError;\n    // Loop through each schema type in the union. If one of the schematypes returns a value that is `=== val`\x2C then\n    // use `val`. Otherwise\x2C if one of the schematypes casted successfully\x2C use the first successfully casted value.\n    // Finally\x2C if none of the schematypes casted successfully\x2C throw the error from the last schema type in the union.\n    // The `=== val` check is a workaround to ensure that the original value is returned if it matches one of the schema types\x2C\n    // avoiding cases like where numbers are casted to strings or dates even if the schema type is a number.\n    for (let i = 0; i < this.schemaTypes.length; ++i) {\n      try {\n        let castedVal = this.schemaTypes[i]._applySetters(val\x2C doc\x2C init\x2C prev\x2C options);\n        if (castedVal == null) {\n          castedVal = this.schemaTypes[i]._castNullish(castedVal);\n        } else {\n          castedVal = this.schemaTypes[i].cast(castedVal\x2C doc\x2C init\x2C prev\x2C options);\n        }\n        if (castedVal === val) {\n          return castedVal;\n        }\n        if (firstValue === firstValueSymbol) {\n          firstValue = castedVal;\n        }\n      } catch (error) {\n        lastError = error;\n      }\n    }\n    if (firstValue !== firstValueSymbol) {\n      return firstValue;\n    }\n    throw lastError;\n  }\n\n  clone() {\n    const schematype = super.clone();\n\n    schematype.schemaTypes = this.schemaTypes.map(schemaType => schemaType.clone());\n    return schematype;\n  }\n}\n\n/**\n * This schema type's name\x2C to defend against minifiers that mangle\n * function names.\n *\n * @api public\n */\nUnion.schemaName = 'Union';\n\nUnion.defaultOptions = {};\n\nUnion.prototype.OptionsConstructor = SchemaUnionOptions;\n\nmodule.exports = Union;\n
