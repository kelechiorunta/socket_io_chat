script-source,667,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/utils/esm/forEachDefaultValue.js,import { getNamedType\x2C isInputObjectType\x2C isObjectType } from 'graphql';\nexport function forEachDefaultValue(schema\x2C fn) {\n    const typeMap = schema.getTypeMap();\n    for (const typeName in typeMap) {\n        const type = typeMap[typeName];\n        if (!getNamedType(type).name.startsWith('__')) {\n            if (isObjectType(type)) {\n                const fields = type.getFields();\n                for (const fieldName in fields) {\n                    const field = fields[fieldName];\n                    for (const arg of field.args) {\n                        arg.defaultValue = fn(arg.type\x2C arg.defaultValue);\n                    }\n                }\n            }\n            else if (isInputObjectType(type)) {\n                const fields = type.getFields();\n                for (const fieldName in fields) {\n                    const field = fields[fieldName];\n                    field.defaultValue = fn(field.type\x2C field.defaultValue);\n                }\n            }\n        }\n    }\n}\n
