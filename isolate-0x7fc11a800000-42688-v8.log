script-source,657,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/utils/esm/get-implementing-types.js,export function getImplementingTypes(interfaceName\x2C schema) {\n    const allTypesMap = schema.getTypeMap();\n    const result = [];\n    for (const graphqlTypeName in allTypesMap) {\n        const graphqlType = allTypesMap[graphqlTypeName];\n        if ('getInterfaces' in graphqlType) {\n            const allInterfaces = graphqlType.getInterfaces();\n            if (allInterfaces.find(int => int.name === interfaceName)) {\n                result.push(graphqlType.name);\n            }\n        }\n    }\n    return result;\n}\n
