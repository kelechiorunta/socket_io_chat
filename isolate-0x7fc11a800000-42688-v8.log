script-source,407,file:///Users/mac/Kelechi/node-chat-app/server/pictureRouter.js,import { Router } from 'express';\nimport mongoose from 'mongoose';\nimport { GridFSBucket\x2C ObjectId } from 'mongodb';\n\nconst pictureRouter = Router();\n\npictureRouter.get('/:id'\x2C async (req\x2C res) => {\n  try {\n    const db = mongoose.connection.db;\n    const bucket = new GridFSBucket(db\x2C { bucketName: 'chatPictures' });\n\n    const fileId = new ObjectId(req.params.id);\n    const files = await bucket.find({ _id: fileId }).toArray();\n\n    if (!files || files.length === 0) {\n      return res.status(404).json({ error: 'File not found' });\n    }\n\n    res.set('Content-Type'\x2C files[0].contentType || 'application/octet-stream');\n    res.set('Cache-Control'\x2C 'no-store'); // \ud83d\udea8 Disable caching for real-time updates\n\n    bucket.openDownloadStream(fileId).pipe(res);\n  } catch (err) {\n    console.error('\u274c GridFS error:'\x2C err);\n    res.status(500).json({ error: 'Image not found' });\n  }\n});\n\nexport default pictureRouter;\n
