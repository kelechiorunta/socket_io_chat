script-source,1000,/Users/mac/Kelechi/node-chat-app/node_modules/socket.io/node_modules/debug/src/node.js,/**\n * Module dependencies.\n */\n\nconst tty = require('tty');\nconst util = require('util');\n\n/**\n * This is the Node.js implementation of `debug()`.\n */\n\nexports.init = init;\nexports.log = log;\nexports.formatArgs = formatArgs;\nexports.save = save;\nexports.load = load;\nexports.useColors = useColors;\nexports.destroy = util.deprecate(\n\x09() => {}\x2C\n\x09'Instance method `debug.destroy()` is deprecated and no longer does anything. It will be removed in the next major version of `debug`.'\n);\n\n/**\n * Colors.\n */\n\nexports.colors = [6\x2C 2\x2C 3\x2C 4\x2C 5\x2C 1];\n\ntry {\n\x09// Optional dependency (as in\x2C doesn't need to be installed\x2C NOT like optionalDependencies in package.json)\n\x09// eslint-disable-next-line import/no-extraneous-dependencies\n\x09const supportsColor = require('supports-color');\n\n\x09if (supportsColor && (supportsColor.stderr || supportsColor).level >= 2) {\n\x09\x09exports.colors = [\n\x09\x09\x0920\x2C\n\x09\x09\x0921\x2C\n\x09\x09\x0926\x2C\n\x09\x09\x0927\x2C\n\x09\x09\x0932\x2C\n\x09\x09\x0933\x2C\n\x09\x09\x0938\x2C\n\x09\x09\x0939\x2C\n\x09\x09\x0940\x2C\n\x09\x09\x0941\x2C\n\x09\x09\x0942\x2C\n\x09\x09\x0943\x2C\n\x09\x09\x0944\x2C\n\x09\x09\x0945\x2C\n\x09\x09\x0956\x2C\n\x09\x09\x0957\x2C\n\x09\x09\x0962\x2C\n\x09\x09\x0963\x2C\n\x09\x09\x0968\x2C\n\x09\x09\x0969\x2C\n\x09\x09\x0974\x2C\n\x09\x09\x0975\x2C\n\x09\x09\x0976\x2C\n\x09\x09\x0977\x2C\n\x09\x09\x0978\x2C\n\x09\x09\x0979\x2C\n\x09\x09\x0980\x2C\n\x09\x09\x0981\x2C\n\x09\x09\x0992\x2C\n\x09\x09\x0993\x2C\n\x09\x09\x0998\x2C\n\x09\x09\x0999\x2C\n\x09\x09\x09112\x2C\n\x09\x09\x09113\x2C\n\x09\x09\x09128\x2C\n\x09\x09\x09129\x2C\n\x09\x09\x09134\x2C\n\x09\x09\x09135\x2C\n\x09\x09\x09148\x2C\n\x09\x09\x09149\x2C\n\x09\x09\x09160\x2C\n\x09\x09\x09161\x2C\n\x09\x09\x09162\x2C\n\x09\x09\x09163\x2C\n\x09\x09\x09164\x2C\n\x09\x09\x09165\x2C\n\x09\x09\x09166\x2C\n\x09\x09\x09167\x2C\n\x09\x09\x09168\x2C\n\x09\x09\x09169\x2C\n\x09\x09\x09170\x2C\n\x09\x09\x09171\x2C\n\x09\x09\x09172\x2C\n\x09\x09\x09173\x2C\n\x09\x09\x09178\x2C\n\x09\x09\x09179\x2C\n\x09\x09\x09184\x2C\n\x09\x09\x09185\x2C\n\x09\x09\x09196\x2C\n\x09\x09\x09197\x2C\n\x09\x09\x09198\x2C\n\x09\x09\x09199\x2C\n\x09\x09\x09200\x2C\n\x09\x09\x09201\x2C\n\x09\x09\x09202\x2C\n\x09\x09\x09203\x2C\n\x09\x09\x09204\x2C\n\x09\x09\x09205\x2C\n\x09\x09\x09206\x2C\n\x09\x09\x09207\x2C\n\x09\x09\x09208\x2C\n\x09\x09\x09209\x2C\n\x09\x09\x09214\x2C\n\x09\x09\x09215\x2C\n\x09\x09\x09220\x2C\n\x09\x09\x09221\n\x09\x09];\n\x09}\n} catch (error) {\n\x09// Swallow - we only care if `supports-color` is available; it doesn't have to be.\n}\n\n/**\n * Build up the default `inspectOpts` object from the environment variables.\n *\n *   $ DEBUG_COLORS=no DEBUG_DEPTH=10 DEBUG_SHOW_HIDDEN=enabled node script.js\n */\n\nexports.inspectOpts = Object.keys(process.env).filter(key => {\n\x09return /^debug_/i.test(key);\n}).reduce((obj\x2C key) => {\n\x09// Camel-case\n\x09const prop = key\n\x09\x09.substring(6)\n\x09\x09.toLowerCase()\n\x09\x09.replace(/_([a-z])/g\x2C (_\x2C k) => {\n\x09\x09\x09return k.toUpperCase();\n\x09\x09});\n\n\x09// Coerce string value into JS value\n\x09let val = process.env[key];\n\x09if (/^(yes|on|true|enabled)$/i.test(val)) {\n\x09\x09val = true;\n\x09} else if (/^(no|off|false|disabled)$/i.test(val)) {\n\x09\x09val = false;\n\x09} else if (val === 'null') {\n\x09\x09val = null;\n\x09} else {\n\x09\x09val = Number(val);\n\x09}\n\n\x09obj[prop] = val;\n\x09return obj;\n}\x2C {});\n\n/**\n * Is stdout a TTY? Colored output is enabled when `true`.\n */\n\nfunction useColors() {\n\x09return 'colors' in exports.inspectOpts ?\n\x09\x09Boolean(exports.inspectOpts.colors) :\n\x09\x09tty.isatty(process.stderr.fd);\n}\n\n/**\n * Adds ANSI color escape codes if enabled.\n *\n * @api public\n */\n\nfunction formatArgs(args) {\n\x09const {namespace: name\x2C useColors} = this;\n\n\x09if (useColors) {\n\x09\x09const c = this.color;\n\x09\x09const colorCode = '\\u001B[3' + (c < 8 ? c : '8;5;' + c);\n\x09\x09const prefix = `  ${colorCode};1m${name} \\u001B[0m`;\n\n\x09\x09args[0] = prefix + args[0].split('\\n').join('\\n' + prefix);\n\x09\x09args.push(colorCode + 'm+' + module.exports.humanize(this.diff) + '\\u001B[0m');\n\x09} else {\n\x09\x09args[0] = getDate() + name + ' ' + args[0];\n\x09}\n}\n\nfunction getDate() {\n\x09if (exports.inspectOpts.hideDate) {\n\x09\x09return '';\n\x09}\n\x09return new Date().toISOString() + ' ';\n}\n\n/**\n * Invokes `util.formatWithOptions()` with the specified arguments and writes to stderr.\n */\n\nfunction log(...args) {\n\x09return process.stderr.write(util.formatWithOptions(exports.inspectOpts\x2C ...args) + '\\n');\n}\n\n/**\n * Save `namespaces`.\n *\n * @param {String} namespaces\n * @api private\n */\nfunction save(namespaces) {\n\x09if (namespaces) {\n\x09\x09process.env.DEBUG = namespaces;\n\x09} else {\n\x09\x09// If you set a process.env field to null or undefined\x2C it gets cast to the\n\x09\x09// string 'null' or 'undefined'. Just delete instead.\n\x09\x09delete process.env.DEBUG;\n\x09}\n}\n\n/**\n * Load `namespaces`.\n *\n * @return {String} returns the previously persisted debug modes\n * @api private\n */\n\nfunction load() {\n\x09return process.env.DEBUG;\n}\n\n/**\n * Init logic for `debug` instances.\n *\n * Create a new `inspectOpts` object in case `useColors` is set\n * differently for a particular `debug` instance.\n */\n\nfunction init(debug) {\n\x09debug.inspectOpts = {};\n\n\x09const keys = Object.keys(exports.inspectOpts);\n\x09for (let i = 0; i < keys.length; i++) {\n\x09\x09debug.inspectOpts[keys[i]] = exports.inspectOpts[keys[i]];\n\x09}\n}\n\nmodule.exports = require('./common')(exports);\n\nconst {formatters} = module.exports;\n\n/**\n * Map %o to `util.inspect()`\x2C all on a single line.\n */\n\nformatters.o = function (v) {\n\x09this.inspectOpts.colors = this.useColors;\n\x09return util.inspect(v\x2C this.inspectOpts)\n\x09\x09.split('\\n')\n\x09\x09.map(str => str.trim())\n\x09\x09.join(' ');\n};\n\n/**\n * Map %O to `util.inspect()`\x2C allowing multiple lines if needed.\n */\n\nformatters.O = function (v) {\n\x09this.inspectOpts.colors = this.useColors;\n\x09return util.inspect(v\x2C this.inspectOpts);\n};\n
