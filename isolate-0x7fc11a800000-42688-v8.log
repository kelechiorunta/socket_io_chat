script-source,422,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/schema/esm/makeExecutableSchema.js,import { buildASTSchema\x2C buildSchema\x2C isSchema } from 'graphql';\nimport { applyExtensions\x2C mergeResolvers\x2C mergeTypeDefs } from '@graphql-tools/merge';\nimport { asArray } from '@graphql-tools/utils';\nimport { addResolversToSchema } from './addResolversToSchema.js';\nimport { assertResolversPresent } from './assertResolversPresent.js';\n/**\n * Builds a schema from the provided type definitions and resolvers.\n *\n * The type definitions are written using Schema Definition Language (SDL). They\n * can be provided as a string\x2C a `DocumentNode`\x2C a function\x2C or an array of any\n * of these. If a function is provided\x2C it will be passed no arguments and\n * should return an array of strings or `DocumentNode`s.\n *\n * Note: You can use GraphQL magic comment provide additional syntax\n * highlighting in your editor (with the appropriate editor plugin).\n *\n * ```js\n * const typeDefs = /* GraphQL *\\/ `\n *   type Query {\n *     posts: [Post]\n *     author(id: Int!): Author\n *   }\n * `;\n * ```\n *\n * The `resolvers` object should be a map of type names to nested object\x2C which\n * themselves map the type's fields to their appropriate resolvers.\n * See the [Resolvers](/docs/resolvers) section of the documentation for more details.\n *\n * ```js\n * const resolvers = {\n *   Query: {\n *     posts: (obj\x2C args\x2C ctx\x2C info) => getAllPosts()\x2C\n *     author: (obj\x2C args\x2C ctx\x2C info) => getAuthorById(args.id)\n *   }\n * };\n * ```\n *\n * Once you've defined both the `typeDefs` and `resolvers`\x2C you can create your\n * schema:\n *\n * ```js\n * const schema = makeExecutableSchema({\n *   typeDefs\x2C\n *   resolvers\x2C\n * })\n * ```\n */\nexport function makeExecutableSchema({ typeDefs\x2C resolvers = {}\x2C resolverValidationOptions = {}\x2C inheritResolversFromInterfaces = false\x2C updateResolversInPlace = false\x2C schemaExtensions\x2C defaultFieldResolver\x2C ...otherOptions }) {\n    // Validate and clean up arguments\n    if (typeof resolverValidationOptions !== 'object') {\n        throw new Error('Expected `resolverValidationOptions` to be an object');\n    }\n    if (!typeDefs) {\n        throw new Error('Must provide typeDefs');\n    }\n    let schema;\n    if (isSchema(typeDefs)) {\n        schema = typeDefs;\n    }\n    else if (otherOptions?.commentDescriptions) {\n        const mergedTypeDefs = mergeTypeDefs(typeDefs\x2C {\n            ...otherOptions\x2C\n            commentDescriptions: true\x2C\n        });\n        schema = buildSchema(mergedTypeDefs\x2C otherOptions);\n    }\n    else {\n        const mergedTypeDefs = mergeTypeDefs(typeDefs\x2C otherOptions);\n        schema = buildASTSchema(mergedTypeDefs\x2C otherOptions);\n    }\n    // We allow passing in an array of resolver maps\x2C in which case we merge them\n    schema = addResolversToSchema({\n        schema\x2C\n        resolvers: mergeResolvers(resolvers)\x2C\n        resolverValidationOptions\x2C\n        inheritResolversFromInterfaces\x2C\n        updateResolversInPlace\x2C\n        defaultFieldResolver\x2C\n    });\n    if (Object.keys(resolverValidationOptions).length > 0) {\n        assertResolversPresent(schema\x2C resolverValidationOptions);\n    }\n    if (schemaExtensions) {\n        for (const schemaExtension of asArray(schemaExtensions)) {\n            applyExtensions(schema\x2C schemaExtension);\n        }\n    }\n    return schema;\n}\n
