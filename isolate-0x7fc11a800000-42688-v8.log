script-source,1759,/Users/mac/Kelechi/node-chat-app/node_modules/sharp/lib/sharp.js,// Copyright 2013 Lovell Fuller and others.\n// SPDX-License-Identifier: Apache-2.0\n\n'use strict';\n\n// Inspects the runtime environment and exports the relevant sharp.node binary\n\nconst { familySync\x2C versionSync } = require('detect-libc');\n\nconst { runtimePlatformArch\x2C isUnsupportedNodeRuntime\x2C prebuiltPlatforms\x2C minimumLibvipsVersion } = require('./libvips');\nconst runtimePlatform = runtimePlatformArch();\n\nconst paths = [\n  `../src/build/Release/sharp-${runtimePlatform}.node`\x2C\n  '../src/build/Release/sharp-wasm32.node'\x2C\n  `@img/sharp-${runtimePlatform}/sharp.node`\x2C\n  '@img/sharp-wasm32/sharp.node'\n];\n\nlet path\x2C sharp;\nconst errors = [];\nfor (path of paths) {\n  try {\n    sharp = require(path);\n    break;\n  } catch (err) {\n    /* istanbul ignore next */\n    errors.push(err);\n  }\n}\n\n/* istanbul ignore next */\nif (sharp && path.startsWith('@img/sharp-linux-x64') && !sharp._isUsingX64V2()) {\n  const err = new Error('Prebuilt binaries for linux-x64 require v2 microarchitecture');\n  err.code = 'Unsupported CPU';\n  errors.push(err);\n  sharp = null;\n}\n\n/* istanbul ignore next */\nif (sharp) {\n  module.exports = sharp;\n} else {\n  const [isLinux\x2C isMacOs\x2C isWindows] = ['linux'\x2C 'darwin'\x2C 'win32'].map(os => runtimePlatform.startsWith(os));\n\n  const help = [`Could not load the "sharp" module using the ${runtimePlatform} runtime`];\n  errors.forEach(err => {\n    if (err.code !== 'MODULE_NOT_FOUND') {\n      help.push(`${err.code}: ${err.message}`);\n    }\n  });\n  const messages = errors.map(err => err.message).join(' ');\n  help.push('Possible solutions:');\n  // Common error messages\n  if (isUnsupportedNodeRuntime()) {\n    const { found\x2C expected } = isUnsupportedNodeRuntime();\n    help.push(\n      '- Please upgrade Node.js:'\x2C\n      `    Found ${found}`\x2C\n      `    Requires ${expected}`\n    );\n  } else if (prebuiltPlatforms.includes(runtimePlatform)) {\n    const [os\x2C cpu] = runtimePlatform.split('-');\n    const libc = os.endsWith('musl') ? ' --libc=musl' : '';\n    help.push(\n      '- Ensure optional dependencies can be installed:'\x2C\n      '    npm install --include=optional sharp'\x2C\n      '- Ensure your package manager supports multi-platform installation:'\x2C\n      '    See https://sharp.pixelplumbing.com/install#cross-platform'\x2C\n      '- Add platform-specific dependencies:'\x2C\n      `    npm install --os=${os.replace('musl'\x2C '')}${libc} --cpu=${cpu} sharp`\n    );\n  } else {\n    help.push(\n      `- Manually install libvips >= ${minimumLibvipsVersion}`\x2C\n      '- Add experimental WebAssembly-based dependencies:'\x2C\n      '    npm install --cpu=wasm32 sharp'\x2C\n      '    npm install @img/sharp-wasm32'\n    );\n  }\n  if (isLinux && /(symbol not found|CXXABI_)/i.test(messages)) {\n    try {\n      const { config } = require(`@img/sharp-libvips-${runtimePlatform}/package`);\n      const libcFound = `${familySync()} ${versionSync()}`;\n      const libcRequires = `${config.musl ? 'musl' : 'glibc'} ${config.musl || config.glibc}`;\n      help.push(\n        '- Update your OS:'\x2C\n        `    Found ${libcFound}`\x2C\n        `    Requires ${libcRequires}`\n      );\n    } catch (errEngines) {}\n  }\n  if (isLinux && /\\/snap\\/core[0-9]{2}/.test(messages)) {\n    help.push(\n      '- Remove the Node.js Snap\x2C which does not support native modules'\x2C\n      '    snap remove node'\n    );\n  }\n  if (isMacOs && /Incompatible library version/.test(messages)) {\n    help.push(\n      '- Update Homebrew:'\x2C\n      '    brew update && brew upgrade vips'\n    );\n  }\n  if (errors.some(err => err.code === 'ERR_DLOPEN_DISABLED')) {\n    help.push('- Run Node.js without using the --no-addons flag');\n  }\n  // Link to installation docs\n  if (isWindows && /The specified procedure could not be found/.test(messages)) {\n    help.push(\n      '- Using the canvas package on Windows?'\x2C\n      '    See https://sharp.pixelplumbing.com/install#canvas-and-windows'\x2C\n      '- Check for outdated versions of sharp in the dependency tree:'\x2C\n      '    npm ls sharp'\n    );\n  }\n  help.push(\n    '- Consult the installation documentation:'\x2C\n    '    See https://sharp.pixelplumbing.com/install'\n  );\n  throw new Error(help.join('\\n'));\n}\n
