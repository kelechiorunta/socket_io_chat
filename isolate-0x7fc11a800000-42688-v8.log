script-source,1267,/Users/mac/Kelechi/node-chat-app/node_modules/whatwg-url/lib/infra.js,"use strict";\n\n// Note that we take code points as JS numbers\x2C not JS strings.\n\nfunction isASCIIDigit(c) {\n  return c >= 0x30 && c <= 0x39;\n}\n\nfunction isASCIIAlpha(c) {\n  return (c >= 0x41 && c <= 0x5A) || (c >= 0x61 && c <= 0x7A);\n}\n\nfunction isASCIIAlphanumeric(c) {\n  return isASCIIAlpha(c) || isASCIIDigit(c);\n}\n\nfunction isASCIIHex(c) {\n  return isASCIIDigit(c) || (c >= 0x41 && c <= 0x46) || (c >= 0x61 && c <= 0x66);\n}\n\nmodule.exports = {\n  isASCIIDigit\x2C\n  isASCIIAlpha\x2C\n  isASCIIAlphanumeric\x2C\n  isASCIIHex\n};\n
