ndFrame(list\x2C cb) {\n    if (list.length === 2) {\n      this._socket.cork();\n      this._socket.write(list[0]);\n      this._socket.write(list[1]\x2C cb);\n      this._socket.uncork();\n    } else {\n      this._socket.write(list[0]\x2C cb);\n    }\n  }\n}\n\nmodule.exports = Sender;\n
