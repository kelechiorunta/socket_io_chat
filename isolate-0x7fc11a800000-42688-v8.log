script-source,688,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/utils/esm/getArgumentValues.js,import { inspect } from 'cross-inspect';\nimport { isNonNullType\x2C Kind\x2C print\x2C valueFromAST\x2C } from 'graphql';\nimport { createGraphQLError } from './errors.js';\nimport { hasOwnProperty } from './jsutils.js';\n/**\n * Prepares an object map of argument values given a list of argument\n * definitions and list of argument AST nodes.\n *\n * Note: The returned value is a plain Object with a prototype\x2C since it is\n * exposed to user code. Care should be taken to not pull values from the\n * Object prototype.\n */\nexport function getArgumentValues(def\x2C node\x2C variableValues = {}) {\n    const coercedValues = {};\n    const argumentNodes = node.arguments ?? [];\n    const argNodeMap = argumentNodes.reduce((prev\x2C arg) => ({\n        ...prev\x2C\n        [arg.name.value]: arg\x2C\n    })\x2C {});\n    for (const { name\x2C type: argType\x2C defaultValue } of def.args) {\n        const argumentNode = argNodeMap[name];\n        if (!argumentNode) {\n            if (defaultValue !== undefined) {\n                coercedValues[name] = defaultValue;\n            }\n            else if (isNonNullType(argType)) {\n                throw createGraphQLError(`Argument "${name}" of required type "${inspect(argType)}" ` + 'was not provided.'\x2C {\n                    nodes: [node]\x2C\n                });\n            }\n            continue;\n        }\n        const valueNode = argumentNode.value;\n        let isNull = valueNode.kind === Kind.NULL;\n        if (valueNode.kind === Kind.VARIABLE) {\n            const variableName = valueNode.name.value;\n            if (variableValues == null || !hasOwnProperty(variableValues\x2C variableName)) {\n                if (defaultValue !== undefined) {\n                    coercedValues[name] = defaultValue;\n                }\n                else if (isNonNullType(argType)) {\n                    throw createGraphQLError(`Argument "${name}" of required type "${inspect(argType)}" ` +\n                        `was provided the variable "$${variableName}" which was not provided a runtime value.`\x2C {\n                        nodes: [valueNode]\x2C\n                    });\n                }\n                continue;\n            }\n            isNull = variableValues[variableName] == null;\n        }\n        if (isNull && isNonNullType(argType)) {\n            throw createGraphQLError(`Argument "${name}" of non-null type "${inspect(argType)}" ` + 'must not be null.'\x2C {\n                nodes: [valueNode]\x2C\n            });\n        }\n        const coercedValue = valueFromAST(valueNode\x2C argType\x2C variableValues);\n        if (coercedValue === undefined) {\n            // Note: ValuesOfCorrectTypeRule validation should catch this before\n            // execution. This is a runtime check to ensure execution does not\n            // continue with an invalid argument value.\n            throw createGraphQLError(`Argument "${name}" has invalid value ${print(valueNode)}.`\x2C {\n                nodes: [valueNode]\x2C\n            });\n        }\n        coercedValues[name] = coercedValue;\n    }\n    return coercedValues;\n}\n
