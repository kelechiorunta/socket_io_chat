script-source,414,file:///Users/mac/Kelechi/node-chat-app/server/middleware.js,import rateLimit from './config/ratelimit.js';\n\nexport const loginSession = (req\x2C res\x2C next) => {\n  console.log('Authenticated?'\x2C req.isAuthenticated());\n  console.log('Session:'\x2C req.session);\n  console.log('User:'\x2C req.user);\n\n  // Check if user is authenticated with Passport\n  if (!req.isAuthenticated() || !req.user) {\n    return res.redirect('/login');\n  }\n  // if (!req.isAuthenticated() || !req.user) {\n  //     return res.status(401).json({ error: 'Unauthorized' }); // \u2b05\ufe0f return JSON instead of redirect\n  //   }\n  next();\n};\n\nexport const rateLimitMiddleware = async (req\x2C res\x2C next) => {\n  try {\n    const { success } = await rateLimit.limit(req.user?._id);\n\n    if (!success) {\n      return res.status(429).json({\n        error: `Too many requests. ${req.user?.username}\x2C you have exceeded your rate limit! Please wait after a minute.`\n      });\n    }\n    next();\n  } catch (error) {\n    console.error(error);\n    next(error);\n  }\n};\n
