script-source,425,file:///Users/mac/Kelechi/node-chat-app/server/passport.js,import { Strategy as LocalStrategy } from 'passport-local';\nimport User from './model/User.js';\nimport { Strategy as GoogleStrategy } from 'passport-google-oauth20';\nimport dotenv from 'dotenv';\ndotenv.config();\n// import passport from 'passport'\n\nexport const configureLocalPassport = (passport) => {\n  passport.use(\n    new LocalStrategy(\n      {\n        usernameField: 'username'\x2C\n        passwordField: 'password'\n      }\x2C\n      async (username\x2C password\x2C done) => {\n        try {\n          const user = await User.findOne({ username });\n          if (!user) {\n            return done(null\x2C false\x2C { message: 'No subscriber found' });\n          }\n\n          const isValid = await user.comparePassword(password);\n          if (!isValid) {\n            return done(null\x2C false\x2C { message: 'Incorrect password' });\n          }\n\n          return done(null\x2C user);\n        } catch (err) {\n          return done(err);\n        }\n      }\n    )\n  );\n\n  passport.use(\n    passport.serializeUser((user\x2C done) => {\n      done(null\x2C user.id); // or user._id depending on your DB\n      // console.log(user.id)\n    })\x2C\n\n    passport.deserializeUser(async (id\x2C done) => {\n      try {\n        const user = await User.findById(id); // or your user model\n        done(null\x2C user);\n        // console.log("serialized"\x2C user)\n      } catch (err) {\n        done(err);\n      }\n    })\n  );\n};\n\n// process.env.NODE_ENV === 'development'\n//   ? 'http://localhost:7334/oauth2/redirect/google'\n//   :\nexport const configureGooglePassport = (passport) => {\n  passport.use(\n    new GoogleStrategy(\n      {\n        clientID: process.env.GOOGLE_CLIENT_ID_NEW\x2C\n        clientSecret: process.env.GOOGLE_CLIENT_SECRET_NEW\x2C\n        callbackURL: 'https://socketiochat-production.up.railway.app/api/oauth2/redirect/google'\x2C\n        scope: ['profile'\x2C 'email']\n      }\x2C\n      async (accessToken\x2C refreshToken\x2C profile\x2C done) => {\n        const newUser = {\n          username: profile.displayName\x2C\n          email: profile.emails[0].value\x2C\n          'google.name': profile.displayName\x2C // Use displayName for the name\n          'google.email': profile.emails[0].value\x2C // Use emails[0].value for email\n          'google.accessToken': accessToken\x2C // \u2705 save token\n          active: true\n        };\n        const googleUser = await User.findOne({ 'google.email': profile.emails[0].value });\n        const localUser = await User.findOne({ email: profile.emails[0].value });\n\n        try {\n          if (googleUser && localUser) {\n            return done(null\x2C googleUser);\n          } else if (googleUser) {\n            return done(null\x2C googleUser);\n          } else if (localUser) {\n            localUser.google = {\n              email: profile.emails[0].value\x2C\n              displayName: profile.displayName\x2C\n              accessToken\n            };\n            await localUser.save();\n            console.log('Local user updated with Google info');\n            done(null\x2C localUser);\n          } else {\n            //User is new\n            const user = await User.create(newUser);\n            done(null\x2C user);\n          }\n        } catch (err) {\n          console.error('Google authentication error:'\x2C err.message);\n          done(err\x2C null);\n        }\n      }\n    )\n  );\n\n  passport.use(\n    passport.serializeUser((user\x2C done) => {\n      done(null\x2C user.id); // or user._id depending on your DB\n      // console.log(user.id)\n    })\x2C\n\n    passport.deserializeUser(async (id\x2C done) => {\n      try {\n        const user = await User.findById(id); // or your user model\n        done(null\x2C user);\n        // console.log("serialized"\x2C user)\n      } catch (err) {\n        done(err);\n      }\n    })\n  );\n};\n
