script-source,2162,/Users/mac/Kelechi/node-chat-app/node_modules/nodemailer/lib/shared/index.js,/* eslint no-console: 0 */\n\n'use strict';\n\nconst urllib = require('url');\nconst util = require('util');\nconst fs = require('fs');\nconst nmfetch = require('../fetch');\nconst dns = require('dns');\nconst net = require('net');\nconst os = require('os');\n\nconst DNS_TTL = 5 * 60 * 1000;\n\nlet networkInterfaces;\ntry {\n    networkInterfaces = os.networkInterfaces();\n} catch (err) {\n    // fails on some systems\n}\n\nmodule.exports.networkInterfaces = networkInterfaces;\n\nconst isFamilySupported = (family\x2C allowInternal) => {\n    let networkInterfaces = module.exports.networkInterfaces;\n    if (!networkInterfaces) {\n        // hope for the best\n        return true;\n    }\n\n    const familySupported =\n        // crux that replaces Object.values(networkInterfaces) as Object.values is not supported in nodejs v6\n        Object.keys(networkInterfaces)\n            .map(key => networkInterfaces[key])\n            // crux that replaces .flat() as it is not supported in older Node versions (v10 and older)\n            .reduce((acc\x2C val) => acc.concat(val)\x2C [])\n            .filter(i => !i.internal || allowInternal)\n            .filter(i => i.family === 'IPv' + family || i.family === family).length > 0;\n\n    return familySupported;\n};\n\nconst resolver = (family\x2C hostname\x2C options\x2C callback) => {\n    options = options || {};\n    const familySupported = isFamilySupported(family\x2C options.allowInternalNetworkInterfaces);\n\n    if (!familySupported) {\n        return callback(null\x2C []);\n    }\n\n    const resolver = dns.Resolver ? new dns.Resolver(options) : dns;\n    resolver['resolve' + family](hostname\x2C (err\x2C addresses) => {\n        if (err) {\n            switch (err.code) {\n                case dns.NODATA:\n                case dns.NOTFOUND:\n                case dns.NOTIMP:\n                case dns.SERVFAIL:\n                case dns.CONNREFUSED:\n                case dns.REFUSED:\n                case 'EAI_AGAIN':\n                    return callback(null\x2C []);\n            }\n            return callback(err);\n        }\n        return callback(null\x2C Array.isArray(addresses) ? addresses : [].concat(addresses || []));\n    });\n};\n\nconst dnsCache = (module.exports.dnsCache = new Map());\n\nconst formatDNSValue = (value\x2C extra) => {\n    if (!value) {\n        return Object.assign({}\x2C extra || {});\n    }\n\n    return Object.assign(\n        {\n            servername: value.servername\x2C\n            host:\n                !value.addresses || !value.addresses.length\n                    ? null\n                    : value.addresses.length === 1\n                    ? value.addresses[0]\n                    : value.addresses[Math.floor(Math.random() * value.addresses.length)]\n        }\x2C\n        extra || {}\n    );\n};\n\nmodule.exports.resolveHostname = (options\x2C callback) => {\n    options = options || {};\n\n    if (!options.host && options.servername) {\n        options.host = options.servername;\n    }\n\n    if (!options.host || net.isIP(options.host)) {\n        // nothing to do here\n        let value = {\n            addresses: [options.host]\x2C\n            servername: options.servername || false\n        };\n        return callback(\n            null\x2C\n            formatDNSValue(value\x2C {\n                cached: false\n            })\n        );\n    }\n\n    let cached;\n    if (dnsCache.has(options.host)) {\n        cached = dnsCache.get(options.host);\n\n        if (!cached.expires || cached.expires >= Date.now()) {\n            return callback(\n                null\x2C\n                formatDNSValue(cached.value\x2C {\n                    cached: true\n                })\n            );\n        }\n    }\n\n    resolver(4\x2C options.host\x2C options\x2C (err\x2C addresses) => {\n        if (err) {\n            if (cached) {\n                // ignore error\x2C use expired value\n                return callback(\n                    null\x2C\n                    formatDNSValue(cached.value\x2C {\n                        cached: true\x2C\n                        error: err\n                    })\n                );\n            }\n            return callback(err);\n        }\n\n        if (addresses && addresses.length) {\n            let value = {\n                addresses\x2C\n                servername: options.servername || options.host\n            };\n\n            dnsCache.set(options.host\x2C {\n                value\x2C\n                expires: Date.now() + (options.dnsTtl || DNS_TTL)\n            });\n\n            return callback(\n                null\x2C\n                formatDNSValue(value\x2C {\n                    cached: false\n                })\n            );\n        }\n\n        resolver(6\x2C options.host\x2C options\x2C (err\x2C addresses) => {\n            if (err) {\n                if (cached) {\n                    // ignore error\x2C use expired value\n                    return callback(\n                        null\x2C\n                        formatDNSValue(cached.value\x2C {\n                            cached: true\x2C\n                            error: err\n                        })\n                    );\n                }\n                return callback(err);\n            }\n\n            if (addresses && addresses.length) {\n                let value = {\n                    addresses\x2C\n                    servername: options.servername || options.host\n                };\n\n                dnsCache.set(options.host\x2C {\n                    value\x2C\n                    expires: Date.now() + (options.dnsTtl || DNS_TTL)\n                });\n\n                return callback(\n                    null\x2C\n                    formatDNSValue(value\x2C {\n                        cached: false\n                    })\n                );\n            }\n\n            try {\n                dns.lookup(options.host\x2C { all: true }\x2C (err\x2C addresses) => {\n                    if (err) {\n                        if (cached) {\n                            // ignore error\x2C use expired value\n                            return callback(\n                                null\x2C\n                                formatDNSValue(cached.value\x2C {\n                                    cached: true\x2C\n                                    error: err\n                                })\n                            );\n                        }\n                        return callback(err);\n                    }\n\n                    let address = addresses\n                        ? addresses\n                              .filter(addr => isFamilySupported(addr.family))\n                              .map(addr => addr.address)\n                              .shift()\n                        : false;\n\n                    if (addresses && addresses.length && !address) {\n                        // there are addresses but none can be used\n                        console.warn(`Failed to resolve IPv${addresses[0].family} addresses with current network`);\n                    }\n\n                    if (!address && cached) {\n                        // nothing was found\x2C fallback to cached value\n                        return callback(\n                            null\x2C\n                            formatDNSValue(cached.value\x2C {\n                                cached: true\n                            })\n                        );\n                    }\n\n                    let value = {\n                        addresses: address ? [address] : [options.host]\x2C\n                        servername: options.servername || options.host\n                    };\n\n                    dnsCache.set(options.host\x2C {\n                        value\x2C\n                        expires: Date.now() + (options.dns