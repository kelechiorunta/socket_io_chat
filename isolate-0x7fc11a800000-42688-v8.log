script-source,397,file:///Users/mac/Kelechi/node-chat-app/server/router.js,import express from 'express';\nimport {\n  emailValidationSchema\x2C\n  forgotPasswordController\x2C\n  signupController\x2C\n  validateRequest\n} from './controllers.js';\nimport passport from 'passport';\nimport User from './model/User.js';\nimport { configureGooglePassport\x2C configureLocalPassport } from './passport.js';\nimport { loginSession } from './middleware.js';\n// import { isAuthenticatedUser } from './controllers.js';\nimport Chat from './model/Chat.js';\nimport UnreadMsg from './model/UnreadMsg.js';\n\nconst authRouter = express.Router();\n\nconfigureLocalPassport(passport);\n\nconfigureGooglePassport(passport);\n\nauthRouter.get('/logout'\x2C function (req\x2C res\x2C next) {\n  req.logout(function (err) {\n    if (err) {\n      return next(err);\n    }\n    res.redirect('/login');\n  });\n});\n\nauthRouter.get('/google'\x2C passport.authenticate('google'\x2C { scope: ['profile'\x2C 'email'] }));\nauthRouter.get('/oauth2/redirect/google'\x2C passport.authenticate('google')\x2C (req\x2C res\x2C next) => {\n  try {\n    req.session.user = req.user;\n    req.session.authenticated = req.isAuthenticated();\n    // res.json({ message: 'Login successful'\x2C user: req.user\x2C isValid: req.isAuthenticated() });\n    res.redirect('/');\n  } catch (err) {\n    res.redirect('/login');\n  }\n});\n\nauthRouter.post('/signup'\x2C signupController);\n\nauthRouter.post('/signin'\x2C (req\x2C res\x2C next) => {\n  passport.authenticate('local'\x2C (err\x2C user\x2C info) => {\n    if (err || !user) {\n      return res.status(401).json({ error: info?.message || 'Unauthorized' });\n    }\n\n    req.logIn(user\x2C (err) => {\n      if (err) return res.status(500).json({ error: 'Login error' });\n\n      req.session.user = user;\n      req.session.authenticated = true;\n      return res.json({ message: 'Login successful'\x2C user: user });\n    });\n  })(req\x2C res\x2C next);\n});\n\nauthRouter.post(\n  '/forgot_password'\x2C\n  emailValidationSchema\x2C\n  validateRequest\x2C\n  forgotPasswordController\n);\n\nauthRouter.get('/getChatHistory'\x2C async (req\x2C res) => {\n  try {\n    const { userId\x2C currentUserId } = req.query;\n    // const currentUserId = req.session.user?._id;\n    if (!currentUserId) {\n      return res.status(401).json({ error: 'Unauthorized' });\n    }\n\n    if (!userId) {\n      return res.status(400).json({ error: 'Missing userId in query' });\n    }\n\n    const chat = await Chat.findOne({\n      members: { $all: [currentUserId\x2C userId]\x2C $size: 2 }\x2C\n      isGroup: false\n    }).populate({\n      path: 'messages'\x2C\n      model: 'ChatMessage'\x2C\n      options: { sort: { createdAt: 1 } }\x2C // Sort messages chronologically\n      populate: {\n        path: 'sender receiver'\x2C\n        model: 'User'\x2C\n        select: 'username _id picture isOnline lastMessage lastMessageCount unread'\n      }\n    });\n\n    if (!chat) {\n      return res.json({ messages: [] });\n    }\n    const selectedUser = await User.findById(userId);\n    const currentUser = await User.findById(currentUserId);\n    if (selectedUser) {\n      selectedUser.lasMessageCount = 0;\n      await selectedUser.save();\n    }\n\n    const unreadEntry = await UnreadMsg.findOne({\n      recipient: selectedUser._id\x2C\n      sender: currentUser._id\x2C\n      unreadMsgs: { $exists: true\x2C $not: { $size: 0 } }\n    });\n\n    if (unreadEntry) {\n      // Delete the specific unread entry\n      const result = await UnreadMsg.deleteOne({\n        _id: unreadEntry._id\n      });\n\n      console.log(\n        `\ud83d\uddd1\ufe0f Deleted ${result.deletedCount} unread message(s) from ${currentUser.username} to ${selectedUser.username}`\n      );\n    }\n    //   await UnreadMsg.deleteMany({ recipient: selectedUser\x2C sender: currentUser });\n\n    res.json({ messages: chat.messages\x2C notifiedUser: currentUser });\n  } catch (err) {\n    console.error('\u274c Error getting chat history:'\x2C err);\n    res.status(500).json({ error: 'Internal server error' });\n  }\n});\n\nauthRouter.post('/paystack/webhook'\x2C express.json()\x2C (req\x2C res) => {\n  const { event\x2C data } = req.body;\n\n  if (event === 'charge.success') {\n    const reference = data.reference;\n    const email = data.customer.email;\n    console.log(`Payment successful for ${email}\x2C ref: ${reference}`);\n    // You can update DB status here\n  }\n\n  res.sendStatus(200);\n});\n\nauthRouter.get('/isAuthenticated'\x2C loginSession\x2C (req\x2C res) => {\n  // console.log("USER AUTHENTICATED"\x2C req.session?.user)\n  res.json({ user: req.user });\n});\n\nexport var authenticatedUser = {};\n\n// authRouter.post('/login'\x2C loginController);\nauthRouter.use((req\x2C res\x2C next) => {\n  //   console.log("USER AUTHENTICATED"\x2C req.session?.user)\n  //   console.log("USER ISAUTHENTICATED"\x2C req.authenticated())\n  authenticatedUser.user = req.session.user;\n  authenticatedUser.isActive = req.session.authenticated;\n  next();\n});\n\nexport default authRouter;\n
