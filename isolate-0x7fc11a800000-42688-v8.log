script-source,1390,/Users/mac/Kelechi/node-chat-app/node_modules/mongoose/lib/options/virtualOptions.js,'use strict';\n\nconst opts = require('./propertyOptions');\n\nclass VirtualOptions {\n  constructor(obj) {\n    Object.assign(this\x2C obj);\n\n    if (obj != null && obj.options != null) {\n      this.options = Object.assign({}\x2C obj.options);\n    }\n  }\n}\n\n/**\n * Marks this virtual as a populate virtual\x2C and specifies the model to\n * use for populate.\n *\n * @api public\n * @property ref\n * @memberOf VirtualOptions\n * @type {String|Model|Function}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'ref'\x2C opts);\n\n/**\n * Marks this virtual as a populate virtual\x2C and specifies the path that\n * contains the name of the model to populate\n *\n * @api public\n * @property refPath\n * @memberOf VirtualOptions\n * @type {String|Function}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'refPath'\x2C opts);\n\n/**\n * The name of the property in the local model to match to `foreignField`\n * in the foreign model.\n *\n * @api public\n * @property localField\n * @memberOf VirtualOptions\n * @type {String|Function}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'localField'\x2C opts);\n\n/**\n * The name of the property in the foreign model to match to `localField`\n * in the local model.\n *\n * @api public\n * @property foreignField\n * @memberOf VirtualOptions\n * @type {String|Function}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'foreignField'\x2C opts);\n\n/**\n * Whether to populate this virtual as a single document (true) or an\n * array of documents (false).\n *\n * @api public\n * @property justOne\n * @memberOf VirtualOptions\n * @type {Boolean}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'justOne'\x2C opts);\n\n/**\n * If true\x2C populate just the number of documents where `localField`\n * matches `foreignField`\x2C as opposed to the documents themselves.\n *\n * If `count` is set\x2C it overrides `justOne`.\n *\n * @api public\n * @property count\n * @memberOf VirtualOptions\n * @type {Boolean}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'count'\x2C opts);\n\n/**\n * Add an additional filter to populate\x2C in addition to `localField`\n * matches `foreignField`.\n *\n * @api public\n * @property match\n * @memberOf VirtualOptions\n * @type {Object|Function}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'match'\x2C opts);\n\n/**\n * Additional options to pass to the query used to `populate()`:\n *\n * - `sort`\n * - `skip`\n * - `limit`\n *\n * @api public\n * @property options\n * @memberOf VirtualOptions\n * @type {Object}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'options'\x2C opts);\n\n/**\n * If true\x2C add a `skip` to the query used to `populate()`.\n *\n * @api public\n * @property skip\n * @memberOf VirtualOptions\n * @type {Number}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'skip'\x2C opts);\n\n/**\n * If true\x2C add a `limit` to the query used to `populate()`.\n *\n * @api public\n * @property limit\n * @memberOf VirtualOptions\n * @type {Number}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'limit'\x2C opts);\n\n/**\n * The `limit` option for `populate()` has [some unfortunate edge cases](https://mongoosejs.com/docs/populate.html#query-conditions)\n * when working with multiple documents\x2C like `.find().populate()`. The\n * `perDocumentLimit` option makes `populate()` execute a separate query\n * for each document returned from `find()` to ensure each document\n * gets up to `perDocumentLimit` populated docs if possible.\n *\n * @api public\n * @property perDocumentLimit\n * @memberOf VirtualOptions\n * @type {Number}\n * @instance\n */\n\nObject.defineProperty(VirtualOptions.prototype\x2C 'perDocumentLimit'\x2C opts);\n\nmodule.exports = VirtualOptions;\n
