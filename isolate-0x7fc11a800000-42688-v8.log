script-source,426,file:///Users/mac/Kelechi/node-chat-app/server/controllers.js,import User from './model/User.js';\nimport jwt from 'jsonwebtoken';\nimport { body\x2C validationResult } from 'express-validator';\nimport { createTransport } from 'nodemailer';\n\nexport const emailValidationSchema = [body('email').isEmail().withMessage('Invalid email format')];\n\nexport const validateRequest = (req\x2C res\x2C next) => {\n  const errors = validationResult(req);\n  if (!errors.isEmpty()) {\n    return res.status(400).json({ errors: errors.array() });\n  }\n  next();\n};\n\nexport const isAuthenticatedUser = (req\x2C res) => {\n  if (req.user || req.isAuthenticated()) {\n    return res\n      .status(200)\n      .json({ isValid: true\x2C user: req.user\x2C message: 'User still authenticated!' });\n  } else {\n    return res.status(400).json({\n      isValid: false\x2C\n      user: null\x2C\n      message: 'User not authenticated. Please login or signup!'\n    });\n  }\n};\n\nexport const signupController = async (req\x2C res) => {\n  const { username\x2C password\x2C email } = req.body;\n\n  try {\n    if (!username || !password || !email) {\n      return res.status(400).json({ error: 'All fields are required!' });\n    }\n\n    const existingUser = await User.findOne({ username });\n    if (existingUser) {\n      return res.status(400).json({ error: 'User already exists!' });\n    }\n\n    const newUser = new User({ username: username\x2C password: password\x2C email: email });\n    await newUser.save();\n\n    // Optionally log them in immediately:\n    req.login(newUser\x2C (err) => {\n      if (err) return res.status(500).json({ error: 'Auto-login failed after signup' });\n      return res.status(201).json({ message: 'Signup successful'\x2C user: newUser });\n    });\n  } catch (err) {\n    console.error(err);\n    return res.status(500).json({ error: 'Server error during signup' });\n  }\n};\n\n// This needs JWT deserialization. No need for this since Passport.js has its serialization strategy after signup or login\n// export const signupController = async (req\x2C res\x2C next) => {\n//     const { username\x2C email\x2C password } = req.body\n//     try {\n//         if (!email || !password || !username) {\n//             return res.status(401).json({ error: "Invalid or Incomplete entries" })\n//         }\n\n//         const user = await User.findOne({ email });\n\n//         if (user) {\n//             return res.status(401).json({ error: "User already exists"})\n//         }\n\n//         const newUser = new User({ username\x2C email\x2C password })\n//         // newUser.token = token;\n//         await newUser.save()\n//         const token = jwt.sign({id: newUser._id}\x2C process.env.JWT_SECRET\x2C { expiresIn: '1d' })\n\n//         if (req.session) {\n//          req.session.token = token\n//         }\n//         next()\n//         // res.status(200).json({message: "User signed up successfully"\x2C user: req.session.token})\n//     }\n//     catch (err) {\n//         res.status(500).json({error: err})\n//     }\n// }\n\nexport const loginController = async (req\x2C res) => {\n  const { email\x2C password } = req.body;\n  try {\n    if (!email || !password) {\n      return res.status(401).json({ error: 'Invalid or Incomplete entries' });\n    }\n\n    const user = await User.findOne({ email });\n\n    if (!user) {\n      return res.status(401).json({ error: 'User does not exist' });\n    }\n\n    const isValidPassword = await user.comparePassword(password);\n    if (!isValidPassword) {\n      return res.status(400).json({ error: 'Wrong Password' });\n    }\n\n    const token = await jwt.verify(user.token\x2C process.env.JWT_SECRET);\n\n    if (req.session) {\n      if (token) {\n        req.session.token = token;\n      }\n    }\n\n    res.status(200).json({ message: 'User signed up successfully'\x2C user: token });\n  } catch (err) {\n    res.status(500).json({ error: err });\n  }\n};\n\nexport const forgotPasswordController = async (req\x2C res) => {\n  const { email } = req.body;\n  try {\n    if (!email) {\n      return res.status(401).json({ error: 'Please enter in a valid email address' });\n    }\n\n    const user = await User.findOne({ email });\n\n    if (!user) return res.status(401).json({ error: 'User not found' });\n\n    if (user) {\n      const resetTokenExpiry = Date.now() + 10 * 60 * 1000; // Token valid for 10 minutes\n      const token = jwt.sign({ id: user?._id }\x2C process.env.JWT_SECRET\x2C { expiresIn: '10m' });\n      user.resetPasswordToken = token;\n      user.resetPasswordExpires = resetTokenExpiry;\n      await user.save();\n    }\n    // Use nodemailer to send an approval link to reset the password.\n\n    const resetLink = `https://socketiochat-production.up.railway.app/reset-password/${user?.username}`;\n    // Send reset email with token\n    const transporter = createTransport({\n      service: 'gmail'\x2C // Use Gmail or any other email service\n      auth: {\n        user: process.env.EMAIL_USER\x2C // Your email address or app-specific email\n        pass: process.env.EMAIL_PASS // Your email password or app-specific password\n      }\n    });\n\n    const mailOptions = {\n      from: process.env.EMAIL_USER\x2C\n      to: email\x2C\n      subject: 'Password Reset'\x2C\n      html: `<p>You requested a password reset. Click the link below to reset your password:</p>\n             <p>Your token expires in ten minutes:</p>\n             <a href="${resetLink}">Reset Password</a>\n             <p>If you did not request this\x2C please ignore this email.</p>`\n    };\n\n    const response = await transporter.sendMail(mailOptions);\n\n    if (response.rejected && response.rejected.length > 0) {\n      return res.status(552).json({\n        error: `Email could not be delivered to: ${response.rejected.join('\x2C ')}. It is not a registered cloud email.`\n      });\n    }\n\n    res.status(200).json({ message: 'Password reset email sent' });\n\n    // next();\n    // res.status(200).json({message: "User signed up successfully"\x2C user: req.session.token})\n  } catch (err) {\n    if (err?.response?.status === 429) {\n      return res.status(429).json({ error: 'Too many requests.' });\n    }\n    res.status(500).json({ error: err });\n  }\n};\n\n// export const profileController = (req\x2C res) => {\n//   if (!req.session.token) {\n//     return res.status(401).json({ error: 'Unauthorized' });\n//   }\n\n//   // Decode if needed\n//   const decoded = jwt.verify(req.session.token\x2C process.env.JWT_SECRET);\n\n//   res.status(200).json({ message: 'Profile accessed'\x2C user: decoded });\n// };\n\n// import User from "./models/User.js";\n// import jwt from 'jsonwebtoken';\n\n// export const signupController = async (req\x2C res) => {\n//   const { username\x2C email\x2C password } = req.body;\n//   if (!email || !password || !username) {\n//     return res.status(400).json({ error: "Missing fields" });\n//   }\n\n//   const existing = await User.findOne({ email });\n//   if (existing) return res.status(409).json({ error: "User exists" });\n\n//   const newUser = new User({ username\x2C email\x2C password });\n//   await newUser.save();\n\n//   const token = jwt.sign({ id: newUser._id }\x2C process.env.JWT_SECRET\x2C {\n//     expiresIn: '1d'\n//   });\n\n//   res.cookie('token'\x2C token\x2C {\n//     httpOnly: true\x2C\n//     maxAge: 86400000 // 1 day\n//   });\n\n//   res.status(201).json({ message: "Signup successful" });\n// };\n\n// export const loginController = async (req\x2C res) => {\n//   const { email\x2C password } = req.body;\n//   if (!email || !password) {\n//     return res.status(400).json({ error: "Missing credentials" });\n//   }\n\n//   const user = await User.findOne({ email });\n//   if (!user || !(await user.comparePassword(password))) {\n//     return res.status(401).json({ error: "Invalid email or password" });\n//   }\n\n//   const token = jwt.sign({ id: user._id }\x2C process.env.JWT_SECRET\x2C {\n//     expiresIn: '1d'\n//   });\n\n//   res.cookie('token'\x2C token\x2C {\n//     httpOnly: true\x2C\n//     maxAge: 86400000\n//   });\n\n//   res.status(200).json({ message: "Login successful" });\n// };\n\nexport const profileController = (req\x2C res\x2C next) => {\n  if (req.session) {\n    const token = req.session.user;\n    if (!token) return res.status(401).json({ error: 'Not authenticated' });\n\n    try {\n      const decoded = jwt.verify(token\x2C process.env.JWT_SECRET);\n      req.user = decoded;\n      next();\n      // res.status(200).json({ message: "Profile data"\x2C user: decoded });\n    } catch (err) {\n      res.status(403).json({ error: 'Invalid token' });\n    }\n  }\n};\n
