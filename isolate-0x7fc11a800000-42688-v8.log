script-source,1800,/Users/mac/Kelechi/node-chat-app/node_modules/color-convert/conversions.js,/* MIT license */\n/* eslint-disable no-mixed-operators */\nconst cssKeywords = require('color-name');\n\n// NOTE: conversions should only return primitive values (i.e. arrays\x2C or\n//       values that give correct `typeof` results).\n//       do not use box values types (i.e. Number()\x2C String()\x2C etc.)\n\nconst reverseKeywords = {};\nfor (const key of Object.keys(cssKeywords)) {\n\x09reverseKeywords[cssKeywords[key]] = key;\n}\n\nconst convert = {\n\x09rgb: {channels: 3\x2C labels: 'rgb'}\x2C\n\x09hsl: {channels: 3\x2C labels: 'hsl'}\x2C\n\x09hsv: {channels: 3\x2C labels: 'hsv'}\x2C\n\x09hwb: {channels: 3\x2C labels: 'hwb'}\x2C\n\x09cmyk: {channels: 4\x2C labels: 'cmyk'}\x2C\n\x09xyz: {channels: 3\x2C labels: 'xyz'}\x2C\n\x09lab: {channels: 3\x2C labels: 'lab'}\x2C\n\x09lch: {channels: 3\x2C labels: 'lch'}\x2C\n\x09hex: {channels: 1\x2C labels: ['hex']}\x2C\n\x09keyword: {channels: 1\x2C labels: ['keyword']}\x2C\n\x09ansi16: {channels: 1\x2C labels: ['ansi16']}\x2C\n\x09ansi256: {channels: 1\x2C labels: ['ansi256']}\x2C\n\x09hcg: {channels: 3\x2C labels: ['h'\x2C 'c'\x2C 'g']}\x2C\n\x09apple: {channels: 3\x2C labels: ['r16'\x2C 'g16'\x2C 'b16']}\x2C\n\x09gray: {channels: 1\x2C labels: ['gray']}\n};\n\nmodule.exports = convert;\n\n// Hide .channels and .labels properties\nfor (const model of Object.keys(convert)) {\n\x09if (!('channels' in convert[model])) {\n\x09\x09throw new Error('missing channels property: ' + model);\n\x09}\n\n\x09if (!('labels' in convert[model])) {\n\x09\x09throw new Error('missing channel labels property: ' + model);\n\x09}\n\n\x09if (convert[model].labels.length !== convert[model].channels) {\n\x09\x09throw new Error('channel and label counts mismatch: ' + model);\n\x09}\n\n\x09const {channels\x2C labels} = convert[model];\n\x09delete convert[model].channels;\n\x09delete convert[model].labels;\n\x09Object.defineProperty(convert[model]\x2C 'channels'\x2C {value: channels});\n\x09Object.defineProperty(convert[model]\x2C 'labels'\x2C {value: labels});\n}\n\nconvert.rgb.hsl = function (rgb) {\n\x09const r = rgb[0] / 255;\n\x09const g = rgb[1] / 255;\n\x09const b = rgb[2] / 255;\n\x09const min = Math.min(r\x2C g\x2C b);\n\x09const max = Math.max(r\x2C g\x2C b);\n\x09const delta = max - min;\n\x09let h;\n\x09let s;\n\n\x09if (max === min) {\n\x09\x09h = 0;\n\x09} else if (r === max) {\n\x09\x09h = (g - b) / delta;\n\x09} else if (g === max) {\n\x09\x09h = 2 + (b - r) / delta;\n\x09} else if (b === max) {\n\x09\x09h = 4 + (r - g) / delta;\n\x09}\n\n\x09h = Math.min(h * 60\x2C 360);\n\n\x09if (h < 0) {\n\x09\x09h += 360;\n\x09}\n\n\x09const l = (min + max) / 2;\n\n\x09if (max === min) {\n\x09\x09s = 0;\n\x09} else if (l <= 0.5) {\n\x09\x09s = delta / (max + min);\n\x09} else {\n\x09\x09s = delta / (2 - max - min);\n\x09}\n\n\x09return [h\x2C s * 100\x2C l * 100];\n};\n\nconvert.rgb.hsv = function (rgb) {\n\x09let rdif;\n\x09let gdif;\n\x09let bdif;\n\x09let h;\n\x09let s;\n\n\x09const r = rgb[0] / 255;\n\x09const g = rgb[1] / 255;\n\x09const b = rgb[2] / 255;\n\x09const v = Math.max(r\x2C g\x2C b);\n\x09const diff = v - Math.min(r\x2C g\x2C b);\n\x09const diffc = function (c) {\n\x09\x09return (v - c) / 6 / diff + 1 / 2;\n\x09};\n\n\x09if (diff === 0) {\n\x09\x09h = 0;\n\x09\x09s = 0;\n\x09} else {\n\x09\x09s = diff / v;\n\x09\x09rdif = diffc(r);\n\x09\x09gdif = diffc(g);\n\x09\x09bdif = diffc(b);\n\n\x09\x09if (r === v) {\n\x09\x09\x09h = bdif - gdif;\n\x09\x09} else if (g === v) {\n\x09\x09\x09h = (1 / 3) + rdif - bdif;\n\x09\x09} else if (b === v) {\n\x09\x09\x09h = (2 / 3) + gdif - rdif;\n\x09\x09}\n\n\x09\x09if (h < 0) {\n\x09\x09\x09h += 1;\n\x09\x09} else if (h > 1) {\n\x09\x09\x09h -= 1;\n\x09\x09}\n\x09}\n\n\x09return [\n\x09\x09h * 360\x2C\n\x09\x09s * 100\x2C\n\x09\x09v * 100\n\x09];\n};\n\nconvert.rgb.hwb = function (rgb) {\n\x09const r = rgb[0];\n\x09const g = rgb[1];\n\x09let b = rgb[2];\n\x09co