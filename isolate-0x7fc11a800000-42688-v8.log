script-source,960,/Users/mac/Kelechi/node-chat-app/node_modules/engine.io/node_modules/debug/src/common.js,\n/**\n * This is the common logic for both the Node.js and web browser\n * implementations of `debug()`.\n */\n\nfunction setup(env) {\n\x09createDebug.debug = createDebug;\n\x09createDebug.default = createDebug;\n\x09createDebug.coerce = coerce;\n\x09createDebug.disable = disable;\n\x09createDebug.enable = enable;\n\x09createDebug.enabled = enabled;\n\x09createDebug.humanize = require('ms');\n\x09createDebug.destroy = destroy;\n\n\x09Object.keys(env).forEach(key => {\n\x09\x09createDebug[key] = env[key];\n\x09});\n\n\x09/**\n\x09* The currently active debug mode names\x2C and names to skip.\n\x09*/\n\n\x09createDebug.names = [];\n\x09createDebug.skips = [];\n\n\x09/**\n\x09* Map of special "%n" handling functions\x2C for the debug "format" argument.\n\x09*\n\x09* Valid key names are a single\x2C lower or upper-case letter\x2C i.e. "n" and "N".\n\x09*/\n\x09createDebug.formatters = {};\n\n\x09/**\n\x09* Selects a color for a debug namespace\n\x09* @param {String} namespace The namespace string for the debug instance to be colored\n\x09* @return {Number|String} An ANSI color code for the given namespace\n\x09* @api private\n\x09*/\n\x09function selectColor(namespace) {\n\x09\x09let hash = 0;\n\n\x09\x09for (let i = 0; i < namespace.length; i++) {\n\x09\x09\x09hash = ((hash << 5) - hash) + namespace.charCodeAt(i);\n\x09\x09\x09hash |= 0; // Convert to 32bit integer\n\x09\x09}\n\n\x09\x09return createDebug.colors[Math.abs(hash) % createDebug.colors.length];\n\x09}\n\x09createDebug.selectColor = selectColor;\n\n\x09/**\n\x09* Create a debugger with the given `namespace`.\n\x09*\n\x09* @param {String} namespace\n\x09* @return {Function}\n\x09* @api public\n\x09*/\n\x09function createDebug(namespace) {\n\x09\x09let prevTime;\n\x09\x09let enableOverride = null;\n\x09\x09let namespacesCache;\n\x09\x09let enabledCache;\n\n\x09\x09function debug(...args) {\n\x09\x09\x09// Disabled?\n\x09\x09\x09if (!debug.enabled) {\n\x09\x09\x09\x09return;\n\x09\x09\x09}\n\n\x09\x09\x09const self = debug;\n\n\x09\x09\x09// Set `diff` timestamp\n\x09\x09\x09const curr = Number(new Date());\n\x09\x09\x09const ms = curr - (prevTime || curr);\n\x09\x09\x09self.diff = ms;\n\x09\x09\x09self.prev = prevTime;\n\x09\x09\x09self.curr = curr;\n\x09\x09\x09prevTime = curr;\n\n\x09\x09\x09args[0] = createDebug.coerce(args[0]);\n\n\x09\x09\x09if (typeof args[0] !== 'string') {\n\x09\x09\x09\x09// Anything else let's inspect with %O\n\x09\x09\x09\x09args.unshift('%O');\n\x09\x09\x09}\n\n\x09\x09\x09// Apply any `formatters` transformations\n\x09\x09\x09let index = 0;\n\x09\x09\x09args[0] = args[0].replace(/%([a-zA-Z%])/g\x2C (match\x2C format) => {\n\x09\x09\x09\x09// If we encounter an escaped % then don't increase the array index\n\x09\x09\x09\x09if (match === '%%') {\n\x09\x09\x09\x09\x09return '%';\n\x09\x09\x09\x09}\n\x09\x09\x09\x09index++;\n\x09\x09\x09\x09const formatter = createDebug.formatters[format];\n\x09\x09\x09\x09if (typeof formatter === 'function') {\n\x09\x09\x09\x09\x09const val = args[index];\n\x09\x09\x09\x09\x09match = formatter.call(self\x2C val);\n\n\x09\x09\x09\x09\x09// Now we need to remove `args[index]` since it's inlined in the `format`\n\x09\x09\x09\x09\x09args.splice(index\x2C 1);\n\x09\x09\x09\x09\x09index--;\n\x09\x09\x09\x09}\n\x09\x09\x09\x09return match;\n\x09\x09\x09});\n\n\x09\x09\x09// Apply env-specific formatting (colors\x2C etc.)\n\x09\x09\x09createDebug.formatArgs.call(self\x2C args);\n\n\x09\x09\x09const logFn = self.log || createDebug.log;\n\x09\x09\x09logFn.apply(self\x2C args);\n\x09\x09}\n\n\x09\x09debug.namespace = namespace;\n\x09\x09debug.useColors = createDebug.useColors();\n\x09\x09debug.color = createDebug.selectColor(namespace);\n\x09\x09debug.extend = extend;\n\x09\x09debug.destroy = createDebug.destroy; // XXX Temporary. Will be removed in the next major release.\n\n\x09\x09Object.defineProperty(debug\x2C