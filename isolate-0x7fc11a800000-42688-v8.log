script-source,1968,/Users/mac/Kelechi/node-chat-app/node_modules/express-session/session/session.js,/*!\n * Connect - session - Session\n * Copyright(c) 2010 Sencha Inc.\n * Copyright(c) 2011 TJ Holowaychuk\n * MIT Licensed\n */\n\n'use strict';\n\n/**\n * Expose Session.\n */\n\nmodule.exports = Session;\n\n/**\n * Create a new `Session` with the given request and `data`.\n *\n * @param {IncomingRequest} req\n * @param {Object} data\n * @api private\n */\n\nfunction Session(req\x2C data) {\n  Object.defineProperty(this\x2C 'req'\x2C { value: req });\n  Object.defineProperty(this\x2C 'id'\x2C { value: req.sessionID });\n\n  if (typeof data === 'object' && data !== null) {\n    // merge data into this\x2C ignoring prototype properties\n    for (var prop in data) {\n      if (!(prop in this)) {\n        this[prop] = data[prop]\n      }\n    }\n  }\n}\n\n/**\n * Update reset `.cookie.maxAge` to prevent\n * the cookie from expiring when the\n * session is still active.\n *\n * @return {Session} for chaining\n * @api public\n */\n\ndefineMethod(Session.prototype\x2C 'touch'\x2C function touch() {\n  return this.resetMaxAge();\n});\n\n/**\n * Reset `.maxAge` to `.originalMaxAge`.\n *\n * @return {Session} for chaining\n * @api public\n */\n\ndefineMethod(Session.prototype\x2C 'resetMaxAge'\x2C function resetMaxAge() {\n  this.cookie.maxAge = this.cookie.originalMaxAge;\n  return this;\n});\n\n/**\n * Save the session data with optional callback `fn(err)`.\n *\n * @param {Function} fn\n * @return {Session} for chaining\n * @api public\n */\n\ndefineMethod(Session.prototype\x2C 'save'\x2C function save(fn) {\n  this.req.sessionStore.set(this.id\x2C this\x2C fn || function(){});\n  return this;\n});\n\n/**\n * Re-loads the session data _without_ altering\n * the maxAge properties. Invokes the callback `fn(err)`\x2C\n * after which time if no exception has occurred the\n * `req.session` property will be a new `Session` object\x2C\n * although representing the same session.\n *\n * @param {Function} fn\n * @return {Session} for chaining\n * @api public\n */\n\ndefineMethod(Session.prototype\x2C 'reload'\x2C function reload(fn) {\n  var req = this.req\n  var store = this.req.sessionStore\n\n  store.get(this.id\x2C function(err\x2C sess){\n    if (err) return fn(err);\n    if (!sess) return fn(new Error('failed to load session'));\n    store.createSession(req\x2C sess);\n    fn();\n  });\n  return this;\n});\n\n/**\n * Destroy `this` session.\n *\n * @param {Function} fn\n * @return {Session} for chaining\n * @api public\n */\n\ndefineMethod(Session.prototype\x2C 'destroy'\x2C function destroy(fn) {\n  delete this.req.session;\n  this.req.sessionStore.destroy(this.id\x2C fn);\n  return this;\n});\n\n/**\n * Regenerate this request's session.\n *\n * @param {Function} fn\n * @return {Session} for chaining\n * @api public\n */\n\ndefineMethod(Session.prototype\x2C 'regenerate'\x2C function regenerate(fn) {\n  this.req.sessionStore.regenerate(this.req\x2C fn);\n  return this;\n});\n\n/**\n * Helper function for creating a method on a prototype.\n *\n * @param {Object} obj\n * @param {String} name\n * @param {Function} fn\n * @private\n */\nfunction defineMethod(obj\x2C name\x2C fn) {\n  Object.defineProperty(obj\x2C name\x2C {\n    configurable: true\x2C\n    enumerable: false\x2C\n    value: fn\x2C\n    writable: true\n  });\n};\n
