callback(new Error('OAuth 2.0 authentication requires session support when using state. Did you forget to use express-session middleware?')); }\n\n  var key = this._key;\n  if (!req.session[key]) {\n    return callback(null\x2C false\x2C { message: 'Unable to verify authorization request state.' });\n  }\n\n  var state = req.session[key].state;\n  if (!state) {\n    return callback(null\x2C false\x2C { message: 'Unable to verify authorization request state.' });\n  }\n\n  delete req.session[key].state;\n  if (Object.keys(req.session[key]).length === 0) {\n    delete req.session[key];\n  }\n\n  if (state !== providedState) {\n    return callback(null\x2C false\x2C { message: 'Invalid authorization request state.' });\n  }\n\n  return callback(null\x2C true);\n};\n\n// Expose constructor.\nmodule.exports = SessionStore;\n
