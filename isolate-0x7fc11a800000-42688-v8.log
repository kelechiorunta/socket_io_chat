script-source,99,file:///Users/mac/Kelechi/node-chat-app/server/index.js,import http from 'http';\nimport path from 'path';\n// import { WebSocketServer } from 'ws';\nimport express from 'express';\nimport { Server } from 'socket.io';\nimport cors from 'cors';\n// import { createHandler } from 'graphql-http/lib/use/express';\n// import { loadFilesSync } from '@graphql-tools/load-files';\nimport { makeExecutableSchema } from '@graphql-tools/schema';\nimport resolvers from './resolvers.js';\n// import { fileURLToPath } from 'url';\nimport { connectDB } from './db.js';\nimport { graphqlHTTP } from 'express-graphql';\nimport passport from 'passport';\nimport dotenv from 'dotenv';\nimport mongoose from 'mongoose';\nimport sharp from 'sharp';\nimport { GridFSBucket } from 'mongodb';\n// import fs from 'fs';\nimport typeDefs from './schema.js';\n// import Message from './model/Message.js';\nimport ConnectMongoDBSession from 'connect-mongodb-session';\nimport session from 'express-session';\nimport authRouter from './router.js';\nimport pictureRouter from './pictureRouter.js';\nimport cookieParser from 'cookie-parser';\nimport bodyParser from 'body-parser';\nimport ChatMessage from './model/ChatMessage.js';\nimport Chat from './model/Chat.js';\nimport User from './model/User.js';\nimport UnreadMsg from './model/UnreadMsg.js';\nimport { rateLimitMiddleware } from './middleware.js';\n\n// import { loginSession } from './middleware.js';\ndotenv.config();\n\nconnectDB(process.env.MONGO_URI);\n\n// const __filename = fileURLToPath(import.meta.url);\n// const __dirname = path.dirname(__filename);\n\n// const typeDefs = loadFilesSync(path.join(__dirname\x2C './schema.graphql'));\n// const typeDefs = fs.readFileSync(path.join(__dirname\x2C './schema.graphql')\x2C 'utf8');\nconst schema = makeExecutableSchema({\n  typeDefs\x2C\n  resolvers\n});\n\nconst app = express();\nconst PORT = process.env.PORT || 7334;\n\n// const ALLOWED_ORIGINS = 'http://localhost:7334\x2Chttp://localhost:3000\x2Chttp://localhost:3001\x2Chttps://chatvercelsocketio.vercel.app\x2Chttps://socketiochat-production.up.railway.app'\n// const allowedOrigins = ALLOWED_ORIGINS.split('\x2C');\n\nconst ALLOWED_ORIGINS = [\n  'http://localhost:7334'\x2C\n  'http://localhost:3000'\x2C\n  'http://localhost:3001'\x2C\n  'https://chatvercelsocketio.vercel.app'\x2C\n  'https://socketiochat-production.up.railway.app'\n];\n\nconst corsOption = {\n  origin: function (origin\x2C callback) {\n    if (ALLOWED_ORIGINS.includes(origin) || !origin) {\n      return callback(null\x2C true);\n    } else {\n      return callback(false\x2C new Error('Domain not supported'));\n    }\n  }\x2C\n  allowedHeaders: ['Content-Type'\x2C 'Authorization']\x2C\n  method: ['GET'\x2C 'POST'\x2C 'PUT'\x2C 'DELETE'\x2C 'OPTIONS']\x2C\n  credentials: true\x2C\n  optionsSuccessStatus: 200\n};\n\nconst MongoDBStore = ConnectMongoDBSession(session);\nconst store = new MongoDBStore(\n  {\n    uri: process.env.MONGO_URI\x2C\n    collection: 'sessions'\x2C\n    expires: 1000 * 60 * 60 * 24 * 7\n  } // Sessions expire after 1 week}\n);\n\nif (store) {\n  // console.log(store)\n  store.on('error'\x2C (err) => {\n    console.error(err);\n  });\n}\nconst sessionOptions = {\n  name: 'auth_session'\x2C\n  secret: process.env.SESSION_SECRET\x2C\n  resave: false\x2C\n  saveUninitialized: false\x2C\n  cookie: {\n    secure: process.env.NODE_ENV === 'production'\x2C\n    sameSite: process.env.NODE_ENV === 'production' ? 'none' : 'lax'\x2C\n    httpOnly: true\x2C\n    maxAge: 1000 * 60 * 60 * 24 * 7 // 1 week\n  }\x2C\n  store: store\n};\n\napp.use(cors(corsOption));\n// app.use(\n//   cors({\n//     origin: ['http://localhost:7334'\x2C 'https://socketiochat-production.up.railway.app'\x2C 'http://localhost:3000'\x2C 'https://chatvercelsocketio.vercel.app']\x2C\n//     credentials: true\x2C\n//     allowedHeaders: ['Content-Type'\x2C 'Authorization']\x2C\n//     methods: ['GET'\x2C 'POST'\x2C 'PUT'\x2C 'DELETE'\x2C 'OPTIONS']\x2C\n//     optionsSuccessStatus: 200\x2C\n//   })\n// );\n// app.use('/graphql'\x2C createHandler({\n//     schema\x2C\n//     context: async (req) => ({ user: req.user })\x2C // optional\n// }));\napp.use(cookieParser());\napp.use(bodyParser.json());\napp.use(bodyParser.urlencoded({ extended: false }));\napp.use(session(sessionOptions));\n// Initialize passport\napp.use(passport.initialize());\napp.use(passport.session());\n\napp.use('/api'\x2C authRouter);\napp.use('/chat-pictures'\x2C pictureRouter);\n\napp.set('trust proxy'\x2C true); // Trust Railway's proxy\n\nconst server = http.createServer(app);\nconst io = new Server(server\x2C { cors: corsOption });\n\napp.set('io'\x2C io);\n\n// Middleware to enable GraphQL Introspection and Client Queries\napp.use(\n  '/graphql'\x2C\n  graphqlHTTP((req) => {\n    const isDev = process.env.NODE_ENV === 'development';\n    const ioInstance = req.app.get('io');\n    return {\n      schema\x2C\n      context: {\n        isAuthenticated: req.isAuthenticated?.()\x2C\n        user: req.user ?? req.session?.user\x2C\n        ioInstance: ioInstance\n      }\x2C\n      graphiql: isDev // Only enable GraphiQL in development\n    };\n  })\n);\n\nconst onlineUsers = new Map();\nconst signedInUsers = new Set();\n\nio.engine.on('connection'\x2C (socket) => {\n  console.log(socket?.request?.url);\n});\n\nio.engine.on('connection_error'\x2C (err) => {\n  console.error(err.message);\n});\n\nio.on('connection'\x2C (socket) => {\n  console.log('\u2705 Client connected:'\x2C socket.id);\n\n  socket.on('signedIn'\x2C async ({ userId }) => {\n    if (!signedInUsers.has(userId)) {\n      signedInUsers.add(userId);\n      const signedInUser = await User.findById(userId);\n      if (signedInUser) {\n        socket.broadcast.emit('SigningIn'\x2C { status: 'ok'\x2C loggedInUser: signedInUser });\n      }\n    }\n  });\n\n  socket.on('isLoggedIn'\x2C async ({ userId }) => {\n    socket.data.userId = userId;\n    onlineUsers.set(userId\x2C socket.id);\n    const signedInUser = await User.findById(userId);\n    if (signedInUser) {\n      signedInUser.isOnline = true;\n      await signedInUser.save();\n      socket.broadcast.emit('userOnline'\x2C { userId\x2C online: signedInUser.isOnline });\n      socket.broadcast.emit('isConnected'\x2C { currentUser: userId });\n\n      // socket.broadcast.emit('LoggingIn'\x2C { status: 'ok'\x2C loggedInUser: signedInUser }); // to others\n      socket.emit('LoggingIn'\x2C { status: 'ok'\x2C loggedInUser: signedInUser }); // to current client\n    }\n\n    // Notify others this user came online\n\n    // \u2705 Send current online users to the newly logged-in user\n    const otherOnlineUsers = [...onlineUsers.keys()].filter((id) => id !== userId);\n    // Set isOnline = true in DB for others (optional if you want to persist status)\n    for (const id of otherOnlineUsers) {\n      const userDoc = await User.findById(id);\n      if (userDoc) {\n        userDoc.isOnline = true;\n        await userDoc.save();\n      }\n    }\n    socket.emit('currentlyOnline'\x2C { userIds: otherOnlineUsers\x2C online: true });\n  });\n\n  socket.on('isOnline'\x2C ({ receiverId\x2C senderId }) => {\n    //const senderId = socket.data.userId;\n    if (!receiverId || !senderId) return;\n\n    const receiverSocketId = onlineUsers.get(receiverId);\n    if (receiverSocketId) {\n      io.to(receiverSocketId).emit('isConnected'\x2C { currentUser: senderId });\n    }\n  });\n\n  socket.on('joinChat'\x2C ({ userId }) => {\n    if (!userId) return;\n    console.log(`${userId} joined chat`);\n    socket.data.userId = userId;\n    socket.join(userId); // Join personal room\n  });\n\n  socket.on('markAsRead'\x2C async ({ senderId\x2C receiverId }) => {\n    if (!senderId || !receiverId) {\n      console.warn('\u2757 senderId or receiverId not provided');\n      return;\n    }\n\n    try {\n      const sender = await User.findById(senderId);\n      const recipient = await User.findById(receiverId);\n\n      if (!sender || !recipient) {\n        console.warn('\u2757 Sender or recipient not found in DB');\n        return;\n      }\n\n      // Check if there are unread messages from sender to this recipient\n      const unreadEntry = await UnreadMsg.findOne({\n        recipient: recipient._id\x2C\n        sender: sender._id\x2C\n        unreadMsgs: { $exists: true\x2C $not: { $size: 0 } }\n      });\n\n      if (unreadEntry) {\n        // Delete the specific unread entry\n        const result = await UnreadMsg.deleteOne({\n          _id: unreadEntry._id\n        });\n\n        console.log(\n          `\ud83d\uddd1\ufe0f Deleted ${result.deletedCount} unread message(s) from ${sender.username} to ${recipient.username}`\n        );\n\n        // Emit confirmation only if deletion was successful\n        socket.emit('messagesMarkedAsRead'\x2C { senderId });\n      } else {\n        console.log(`\u2705 No unread messages found from ${sender.username} to ${recipient.username}`);\n      }\n    } catch (error) {\n      console.error('\u274c Error in markAsRead socket handler:'\x2C error);\n    }\n  });\n\n  // socket.on('sendMessage'\x2C async ({ content\x2C receiverId }) => {\n  //   const senderId = socket.data.userId;\n  //   if (!senderId || !receiverId || !content) return;\n\n  //   try {\n  //     // \u2705 Find or create the 1-to-1 chat\n  //     let chat = await Chat.findOne({\n  //       members: { $all: [senderId\x2C receiverId]\x2C $size: 2 }\x2C\n  //       isGroup: false\n  //     });\n\n  //     if (!chat) {\n  //       chat = new Chat({ members: [senderId\x2C receiverId]\x2C isGroup: false });\n  //       await chat.save();\n  //     }\n\n  //     // \u2705 Create and save new message\n  //     let message = new ChatMessage({\n  //       chat: chat._id\x2C\n  //       sender: senderId\x2C\n  //       receiver: receiverId\x2C\n  //       content\n  //     });\n\n  //     await message.save();\n\n  //     // \u2705 Update sender/receiver user data\n  //     const recipientUser = await User.findById(receiverId);\n  //     const senderUser = await User.findById(senderId);\n\n  //     // \u2705 Track unread only if recipient is offline\n  //     //   const isRecipientOnline = onlineUsers && onlineUsers.has(receiverId);\n  //     // if (!isRecipientOnline) {\n  //     // Update sender metadata\n  //     senderUser.lastMessage = content;\n  //     senderUser.lastMessageCount = (senderUser.lastMessageCount || 0) + 1;\n\n  //     // \u2705 Add to or update UnreadMsg collection\n  //     let unreadEntry = await UnreadMsg.findOne({\n  //       recipient: receiverId\x2C\n  //       sender: senderId\n  //     });\n\n  //     if (!unreadEntry) {\n  //       unreadEntry = new UnreadMsg({\n  //         recipient: recipientUser\x2C\n  //         sender: senderUser\x2C\n  //         count: 1\x2C\n  //         lastMessage: content\n  //       });\n  //     } else {\n  //       unreadEntry.count += 1;\n  //       unreadEntry.lastMessage = content;\n  //     }\n\n  //     await unreadEntry.save();\n  //     console.log('Saved successfully to Unread messages');\n\n  //     // Attach to user if not already present\n  //     if (!recipientUser.unread.includes(unreadEntry._id)) {\n  //       recipientUser.unread.push(unreadEntry._id);\n  //       await recipientUser.save();\n  //     }\n  //     // }\n\n  //     // \u2705 Add message to chat\n  //     chat.messages.push(message._id);\n  //     await chat.save();\n\n  //     // \u2705 Populate sender/receiver for frontend\n  //     message = await message.populate([\n  //       { path: 'sender'\x2C select: 'username picture isOnline lastMessage lastMessageCount' }\x2C\n  //       { path: 'receiver'\x2C select: 'username picture isOnline' }\n  //     ]);\n\n  //     // \u2705 Emit updated message to both users\n  //     [senderId\x2C receiverId].forEach((id) => {\n  //       io.to(id).emit('newMessage'\x2C {\n  //         _id: message._id\x2C\n  //         chatId: chat._id\x2C\n  //         sender: message.sender\x2C\n  //         receiver: message.receiver\x2C\n  //         content: message.content\x2C\n  //         createdAt: message.createdAt\x2C\n  //         lastMessage: content\x2C\n  //         unreadCounts: recipientUser.unreadCounts\x2C\n  //         unreadMsgs: recipientUser.unread\n  //       });\n  //     });\n  //   } catch (error) {\n  //     console.error('\u274c sendMessage error:'\x2C error);\n  //   }\n  // });\n\n  socket.on('sendMessage'\x2C async ({ content\x2C receiverId\x2C file\x2C hasFile }) => {\n    const senderId = socket.data.userId;\n    if (!senderId || !receiverId || !content) return;\n    const recipientUser = await User.findById(receiverId);\n    const senderUser = await User.findById(senderId);\n\n    try {\n      // \u2705 Find or create the 1-to-1 chat\n      let chat = await Chat.findOne({\n        members: { $all: [senderId\x2C receiverId]\x2C $size: 2 }\x2C\n        isGroup: false\n      });\n\n      if (!chat) {\n        chat = new Chat({ members: [senderId\x2C receiverId]\x2C isGroup: false });\n        await chat.save();\n      }\n      //\n      let fileId = null;\n      let placeholderImgId = null;\n\n      if (hasFile && file) {\n        const db = mongoose.connection.db;\n        const bucket = new GridFSBucket(db\x2C { bucketName: 'chatPictures' });\n\n        const buffer = Buffer.from(file.data);\n\n        // \u2705 Create a placeholder (tiny blurred thumbnail)\n        const placeholderBuffer = await sharp(buffer)\n          .resize({ width: 20 }) // small thumbnail\n          .blur() // add blur effect for lazy loading\n          .toBuffer();\n\n        // Upload main file\n        const uploadStream = bucket.openUploadStream(file.name\x2C {\n          contentType: file.type\x2C\n          metadata: { senderId\x2C receiverId }\n        });\n\n        uploadStream.end(buffer);\n\n        uploadStream.on('finish'\x2C async () => {\n          fileId = uploadStream.id;\n\n          // Upload placeholder file\n          const placeholderStream = bucket.openUploadStream(`${file.name}-placeholder`\x2C {\n            contentType: file.type\x2C\n            metadata: { senderId\x2C receiverId\x2C placeholder: true }\n          });\n\n          placeholderStream.end(placeholderBuffer);\n\n          placeholderStream.on('finish'\x2C async () => {\n            placeholderImgId = placeholderStream.id;\n\n            // \u2705 Save message with both full & placeholder image IDs\n            let message = new ChatMessage({\n              chat: chat._id\x2C\n              sender: senderId\x2C\n              receiver: receiverId\x2C\n              content\x2C\n              hasImage: true\x2C\n              imageFileId: fileId\x2C\n              placeholderImgId\x2C // \u2705 new field\n              imageUrl: `/chat-pictures/${fileId.toString()}?t=${Date.now()}`\x2C\n              placeholderUrl: `/chat-pictures/${placeholderImgId.toString()}`\n            });\n\n            await message.save();\n            chat.messages.push(message._id);\n            await chat.save();\n\n            // \u2705 Emit to both users\n            [senderId\x2C receiverId].forEach((id) => {\n              io.to(id).emit('newMessage'\x2C {\n                _id: message._id\x2C\n                chatId: chat._id\x2C\n                sender: message.sender\x2C\n                receiver: message.receiver\x2C\n                content: message.content\x2C\n                createdAt: message.createdAt\x2C\n                hasImage: true\x2C\n                imageId: fileId\x2C\n                placeholderId: placeholderImgId\x2C\n                imageUrl: message.imageUrl\x2C\n                placeholderUrl: message.placeholderUrl\x2C // \u2705 send placeholder to client\n                lastMessage: content\x2C\n                unreadCounts: recipientUser.unreadCounts\x2C\n                unreadMsgs: recipientUser.unread\n              });\n            });\n          });\n        });\n      } else {\n        //\n        // \u2705 Create and save new message\n        let message = new ChatMessage({\n          chat: chat._id\x2C\n          sender: senderId\x2C\n          receiver: receiverId\x2C\n          content\n        });\n\n        await message.save();\n\n        // \u2705 Update sender/receiver user data\n\n        // \u2705 Track unread only if recipient is offline\n        //   const isRecipientOnline = onlineUsers && onlineUsers.has(receiverId);\n        // if (!isRecipientOnline) {\n        // Update sender metadata\n        senderUser.lastMessage = content;\n        senderUser.lastMessageCount = (senderUser.lastMessageCount || 0) + 1;\n\n        // \u2705 Add to or update UnreadMsg collection\n        let unreadEntry = await UnreadMsg.findOne({\n          recipient: receiverId\x2C\n          sender: senderId\n        });\n\n        if (!unreadEntry) {\n          unreadEntry = new UnreadMsg({\n            recipient: recipientUser\x2C\n            sender: senderUser\x2C\n            count: 1\x2C\n            lastMessage: content\n          });\n        } else {\n          unreadEntry.count += 1;\n          unreadEntry.lastMessage = content;\n        }\n\n        await unreadEntry.save();\n        console.log('Saved successfully to Unread messages');\n\n        // Attach to user if not already present\n        if (!recipientUser.unread.includes(unreadEntry._id)) {\n          recipientUser.unread.push(unreadEntry._id);\n          await recipientUser.save();\n        }\n        // }\n\n        // \u2705 Add message to chat\n        chat.messages.push(message._id);\n        await chat.save();\n\n        // \u2705 Populate sender/receiver for frontend\n        message = await message.populate([\n          { path: 'sender'\x2C select: 'username picture isOnline lastMessage lastMessageCount' }\x2C\n          { path: 'receiver'\x2C select: 'username picture isOnline' }\n        ]);\n\n        // \u2705 Emit updated message to both users\n        [senderId\x2C receiverId].forEach((id) => {\n          io.to(id).emit('newMessage'\x2C {\n            _id: message._id\x2C\n            chatId: chat._id\x2C\n            sender: message.sender\x2C\n            receiver: message.receiver\x2C\n            content: message.content\x2C\n            createdAt: message.createdAt\x2C\n            lastMessage: content\x2C\n            unreadCounts: recipientUser.unreadCounts\x2C\n            unreadMsgs: recipientUser.unread\n          });\n        });\n      }\n    } catch (error) {\n      console.error('\u274c sendMessage error:'\x2C error);\n    }\n  });\n\n  socket.on('ProfileUpdated'\x2C ({ updatedUser }) => {\n    if (updatedUser) {\n      // Don't broadcast\n      socket.broadcast.emit('UpdatedProfile'\x2C { updatedProfileUser: updatedUser });\n    }\n  });\n\n  // socket.on('typing'\x2C ({ receiverId }) => {\n  //     const senderId = socket.data.userId;\n  //     if (!receiverId || !senderId) return;\n\n  //     // Emit 'typing' to the receiver's room\n  //     io.to(receiverId).emit('typing'\x2C { from: senderId });\n  // });\n\n  socket.on('typing'\x2C ({ receiverId }) => {\n    const senderId = socket.data.userId;\n    const receiverSocketId = onlineUsers.get(receiverId);\n    if (receiverSocketId) {\n      io.to(receiverSocketId).emit('typing'\x2C { from: senderId });\n    }\n  });\n\n  socket.on('disconnect'\x2C async () => {\n    console.log('\ud83d\udd34 Client disconnected:'\x2C socket.id);\n    const userId = socket.data.userId;\n    if (userId) {\n      const signedOutUser = await User.findById(userId);\n      if (signedOutUser) {\n        signedOutUser.isOnline = false;\n        await signedOutUser.save();\n        onlineUsers.delete(userId);\n        signedInUsers.delete(userId);\n        socket.broadcast.emit('userOffline'\x2C { userId\x2C signedOutUser });\n        socket.broadcast.emit('LoggingOut'\x2C { signedOutUser: signedOutUser });\n      }\n    }\n  });\n});\n\napp.use(express.static(path.resolve('build')));\n\napp.get('*'\x2C (req\x2C res) => {\n  res.sendFile(path.resolve('build'\x2C 'index.html'));\n});\n\napp.use(rateLimitMiddleware);\n\nserver.listen(PORT\x2C () => {\n  console.log(`WebSocket server listening on ws://localhost:${PORT}`);\n});\n
