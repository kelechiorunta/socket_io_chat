script-source,432,file:///Users/mac/Kelechi/node-chat-app/server/model/ChatPicture.js,import mongoose from 'mongoose';\n\nconst chatPictureSchema = new mongoose.Schema({\n  fileId: {\n    type: mongoose.Schema.Types.ObjectId\x2C // GridFS file _id\n    required: true\n  }\x2C\n  senderId: {\n    type: mongoose.Schema.Types.ObjectId\x2C\n    ref: 'User'\x2C\n    required: true\n  }\x2C\n  receiverId: {\n    type: mongoose.Schema.Types.ObjectId\x2C\n    ref: 'User'\x2C\n    required: true\n  }\x2C\n  messageId: {\n    type: mongoose.Schema.Types.ObjectId\x2C\n    ref: 'Message'\x2C\n    required: true\n  }\x2C\n  pictureUrl: {\n    type: String\x2C // optional streaming endpoint\x2C e.g. /api/chat-pictures/:id\n    required: false\n  }\x2C\n  createdAt: {\n    type: Date\x2C\n    default: Date.now\n  }\n});\n\n// Auto-populate sender/receiver/message info\nchatPictureSchema.pre(/^find/\x2C function (next) {\n  this.populate('senderId'\x2C 'username picture')\n    .populate('receiverId'\x2C 'username picture')\n    .populate('messageId'\x2C 'content createdAt');\n  next();\n});\n\nconst ChatPicture = mongoose.models.ChatPicture || mongoose.model('ChatPicture'\x2C chatPictureSchema);\n\nexport default ChatPicture;\n
