script-source,1799,/Users/mac/Kelechi/node-chat-app/node_modules/color-convert/index.js,const conversions = require('./conversions');\nconst route = require('./route');\n\nconst convert = {};\n\nconst models = Object.keys(conversions);\n\nfunction wrapRaw(fn) {\n\x09const wrappedFn = function (...args) {\n\x09\x09const arg0 = args[0];\n\x09\x09if (arg0 === undefined || arg0 === null) {\n\x09\x09\x09return arg0;\n\x09\x09}\n\n\x09\x09if (arg0.length > 1) {\n\x09\x09\x09args = arg0;\n\x09\x09}\n\n\x09\x09return fn(args);\n\x09};\n\n\x09// Preserve .conversion property if there is one\n\x09if ('conversion' in fn) {\n\x09\x09wrappedFn.conversion = fn.conversion;\n\x09}\n\n\x09return wrappedFn;\n}\n\nfunction wrapRounded(fn) {\n\x09const wrappedFn = function (...args) {\n\x09\x09const arg0 = args[0];\n\n\x09\x09if (arg0 === undefined || arg0 === null) {\n\x09\x09\x09return arg0;\n\x09\x09}\n\n\x09\x09if (arg0.length > 1) {\n\x09\x09\x09args = arg0;\n\x09\x09}\n\n\x09\x09const result = fn(args);\n\n\x09\x09// We're assuming the result is an array here.\n\x09\x09// see notice in conversions.js; don't use box types\n\x09\x09// in conversion functions.\n\x09\x09if (typeof result === 'object') {\n\x09\x09\x09for (let len = result.length\x2C i = 0; i < len; i++) {\n\x09\x09\x09\x09result[i] = Math.round(result[i]);\n\x09\x09\x09}\n\x09\x09}\n\n\x09\x09return result;\n\x09};\n\n\x09// Preserve .conversion property if there is one\n\x09if ('conversion' in fn) {\n\x09\x09wrappedFn.conversion = fn.conversion;\n\x09}\n\n\x09return wrappedFn;\n}\n\nmodels.forEach(fromModel => {\n\x09convert[fromModel] = {};\n\n\x09Object.defineProperty(convert[fromModel]\x2C 'channels'\x2C {value: conversions[fromModel].channels});\n\x09Object.defineProperty(convert[fromModel]\x2C 'labels'\x2C {value: conversions[fromModel].labels});\n\n\x09const routes = route(fromModel);\n\x09const routeModels = Object.keys(routes);\n\n\x09routeModels.forEach(toModel => {\n\x09\x09const fn = routes[toModel];\n\n\x