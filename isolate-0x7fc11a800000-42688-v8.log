script-source,796,node:internal/crypto/webcrypto,'use strict';\n\nconst {\n  ArrayPrototypeIncludes\x2C\n  JSONParse\x2C\n  JSONStringify\x2C\n  ObjectDefineProperties\x2C\n  ObjectDefineProperty\x2C\n  ReflectApply\x2C\n  ReflectConstruct\x2C\n  SafeSet\x2C\n  StringPrototypeRepeat\x2C\n  SymbolToStringTag\x2C\n} = primordials;\n\nconst {\n  kWebCryptoKeyFormatRaw\x2C\n  kWebCryptoKeyFormatPKCS8\x2C\n  kWebCryptoKeyFormatSPKI\x2C\n  kWebCryptoCipherEncrypt\x2C\n  kWebCryptoCipherDecrypt\x2C\n} = internalBinding('crypto');\n\nconst {\n  getOptionValue\x2C\n} = require('internal/options');\n\nconst { TextDecoder\x2C TextEncoder } = require('internal/encoding');\n\nconst {\n  codes: {\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\n    ERR_INVALID_THIS\x2C\n  }\x2C\n} = require('internal/errors');\n\nconst {\n  CryptoKey\x2C\n  InternalCryptoKey\x2C\n  createSecretKey\x2C\n} = require('internal/crypto/keys');\n\nconst {\n  asyncDigest\x2C\n} = require('internal/crypto/hash');\n\nconst {\n  getBlockSize\x2C\n  hasAnyNotIn\x2C\n  normalizeAlgorithm\x2C\n  normalizeHashName\x2C\n  validateMaxBufferLength\x2C\n  kHandle\x2C\n  kKeyObject\x2C\n} = require('internal/crypto/util');\n\nconst {\n  kEnumerableProperty\x2C\n  lazyDOMException\x2C\n} = require('internal/util');\n\nconst {\n  getRandomValues: _getRandomValues\x2C\n  randomUUID: _randomUUID\x2C\n} = require('internal/crypto/random');\n\nlet webidl;\n\nasync function digest(algorithm\x2C data) {\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\n\n  webidl ??= require('internal/crypto/webidl');\n  const prefix = "Failed to execute 'digest' on 'SubtleCrypto'";\n  webidl.requiredArguments(arguments.length\x2C 2\x2C { prefix });\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\n    prefix\x2C\n    context: '1st argument'\x2C\n  });\n  data = webidl.converters.BufferSource(data\x2C {\n    prefix\x2C\n    context: '2nd argument'\x2C\n  });\n\n  algorithm = normalizeAlgorithm(algorithm\x2C 'digest'