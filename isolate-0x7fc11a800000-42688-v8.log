ariations of MOD 11 algorithmic checks.\n */\nfunction reverseMultiplyAndSum(digits\x2C base) {\n  var total = 0;\n  for (var i = 0; i < digits.length; i++) {\n    total += digits[i] * (base - i);\n  }\n  return total;\n}\n\n/*\n * Verhoeff validation helper function\n * Called with a string of numbers\n * to validate according to the Verhoeff algorithm.\n */\nfunction verhoeffCheck(str) {\n  var d_table = [[0\x2C 1\x2C 2\x2C 3\x2C 4\x2C 5\x2C 6\x2C 7\x2C 8\x2C 9]\x2C [1\x2C 2\x2C 3\x2C 4\x2C 0\x2C 6\x2C 7\x2C 8\x2C 9\x2C 5]\x2C [2\x2C 3\x2C 4\x2C 0\x2C 1\x2C 7\x2C 8\x2C 9\x2C 5\x2C 6]\x2C [3\x2C 4\x2C 0\x2C 1\x2C 2\x2C 8\x2C 9\x2C 5\x2C 6\x2C 7]\x2C [4\x2C 0\x2C 1\x2C 2\x2C 3\x2C 9\x2C 5\x2C 6\x2C 7\x2C 8]\x2C [5\x2C 9\x2C 8\x2C 7\x2C 6\x2C 0\x2C 4\x2C 3\x2C 2\x2C 1]\x2C [6\x2C 5\x2C 9\x2C 8\x2C 7\x2C 1\x2C 0\x2C 4\x2C 3\x2C 2]\x2C [7\x2C 6\x2C 5\x2C 9\x2C 8\x2C 2\x2C 1\x2C 0\x2C 4\x2C 3]\x2C [8\x2C 7\x2C 6\x2C 5\x2C 9\x2C 3\x2C 2\x2C 1\x2C 0\x2C 4]\x2C [9\x2C 8\x2C 7\x2C 6\x2C 5\x2C 4\x2C 3\x2C 2\x2C 1\x2C 0]];\n  var p_table = [[0\x2C 1\x2C 2\x2C 3\x2C 4\x2C 5\x2C 6\x2C 7\x2C 8\x2C 9]\x2C [1\x2C 5\x2C 7\x2C 6\x2C 2\x2C 8\x2C 3\x2C 0\x2C 9\x2C 4]\x2C [5\x2C 8\x2C 0\x2C 3\x2C 7\x2C 9\x2C 6\x2C 1\x2C 4\x2C 2]\x2C [8\x2C 9\x2C 1\x2C 6\x2C 0\x2C 4\x2C 3\x2C 5\x2C 2\x2C 7]\x2C [9\x2C 4\x2C 5\x2C 3\x2C 1\x2C 2\x2C 6\x2C 8\x2C 7\x2C 0]\x2C [4\x2C 2\x2C 8\x2C 6\x2C 5\x2C 7\x2C 3\x2C 9\x2C 0\x2C 1]\x2C [2\x2C 7\x2C 9\x2C 3\x2C 8\x2C 0\x2C 6\x2C 4\x2C 1\x2C 5]\x2C [7\x2C 0\x2C 4\x2C 6\x2C 9\x2C 1\x2C 3\x2C 2\x2C 5\x2C 8]];\n\n  // Copy (to prevent replacement) and reverse\n  var str_copy = str.split('').reverse().join('');\n  var checksum = 0;\n  for (var i = 0; i < str_copy.length; i++) {\n    checksum = d_table[checksum][p_table[i % 8][parseInt(str_copy[i]\x2C 10)]];\n  }\n  return checksum === 0;\n}
