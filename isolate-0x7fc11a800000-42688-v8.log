\x2C\n//         //         }\x2C\n//         //       ]\x2C\n//         //     });\n\n//         //     return user;\n//         //   }\n//         //   return null;\n//         // }\x2C\n//         users: async (parent\x2C args\x2C context) => {\n//             if (!context?.user) return [];\n\n//             try {\n//               const users = await User.find({ _id: { $ne: context.user._id } });\n\n//               const enhancedUsers = users.map(user => {\n//                 const userObj = user.toObject();\n//                 userObj.unreadCounts = formatUnreadCounts(user.unreadCounts);\n//                 return userObj;\n//               });\n\n//               return enhancedUsers;\n//             } catch (error) {\n//               console.error(error);\n//               throw new Error('Failed to fetch users');\n//             }\n//           }\x2C\n\n//           auth: async (parent\x2C args\x2C context) => {\n//             if (!context?.user) return null;\n\n//             const user = await User.findById(context.user._id);\n//             const userObj = user.toObject();\n//             userObj.unreadCounts = formatUnreadCounts(user.unreadCounts);\n\n//             return userObj;\n//           }\x2C\n\n//           getUnread: async (_\x2C { senderId\x2C recipientId }) => {\n//             try {\n//               const user = await User.findById(recipientId);\n//               if (!user) throw new Error("Recipient not found");\n\n//               if (!user.unreadCounts) {\n//                 user.unreadCounts = new Map();\n//               }\n\n//               // Get existing or initialize with defaults\n//               let existingData = user.unreadCounts.get(senderId);\n\n//               if (\n//                 !existingData ||\n//                 typeof existingData !== "object" ||\n//                 existingData.count === undefined\n//               ) {\n//                 existingData = {\n//                   count: 0\x2C\n//                   lastMessage: ""\x2C\n//                 };\n//               }\n\n//               // Set the valid structure\n//               user.unreadCounts.set(senderId\x2C existingData);\n//               user.markModified("unreadCounts");\n//               await user.save();\n\n//               return user.unreadCounts.get(senderId);\n//             } catch (err) {\n//               console.error("\u274c getUnread error:"\x2C err);\n//               throw new Error("Failed to get unread count");\n//             }\n//           }\x2C\n\n//     }\x2C\n\n//     Mutation: {\n//         createUnread: async (_\x2C { senderId\x2C recipientId\x2C newMessage }) => {\n//             try {\n//               const user = await User.findById(recipientId);\n//               if (!user) throw new Error('Recipient not found');\n\n//               const currentCount = user.unreadCounts?.get(senderId) || 0;\n//               const currentMsg = user.unreadCounts?.get(newMessage) || 'No Messages';\n//               user.unreadCounts.set(senderId\x2C currentCount + 1);\n//               user.unreadCounts.set(newMessage\x2C currentMsg);\n//               await user.save();\n\n//               return user.unreadCounts.get(senderId);\n//             } catch (err) {\n//               console.error('\u274c createUnread error:'\x2C err);\n//               throw new Error('Failed to update unread count');\n//             }\n//           }\x2C\n\n//           clearUnread: async (_\x2C { senderId\x2C recipientId }) => {\n//             try {\n//               const user = await User.findById(recipientId);\n//               if (!user) throw new Error('Recipient not found');\n\n//               const existingData = user.unreadCounts?.get(senderId) || { count: 0\x2C lastMessage: '' };\n\n//               user.unreadCounts.set(senderId\x2C {\n//                 count: 0\x2C\n//                 lastMessage: existingData.lastMessage || ''\x2C\n//               });\n\n//               await user.save();\n\n//               return true;\n//             } catch (err) {\n//               console.error('\u274c clearUnread error:'\x2C err);\n//               return false;\n//             }\n//           }\x2C\n\n//         markMessagesAsRead: async (_\x2C { senderId }\x2C { user }) => {\n//             if (!user) throw new Error("Unauthorized");\n\n//             const sender = await User.findById(senderId)\n//             const recipient = await User.findById(user._id)\n\n//             await UnreadMsg.deleteMany({ recipient\x2C sender });\n\n//             return true;\n//           }\n//       }\n\n// }\n\n// export default resolvers\n\nimport ChatMessage from './model/ChatMessage.js';\nimport UnreadMsg from './model/UnreadMsg.js';\nimport User from './model/User.js';\n\nconst formatUnreadCounts = (unreadMap) => {\n  if (!(unreadMap instanceof Map)) return [];\n\n  return Array.from(unreadMap.entries()).map(([senderId\x2C data]) => ({\n    senderId\x2C\n    data\n  }));\n};\n\nconst resolvers = {\n  Query: {\n    users: async (_\x2C args\x2C context) => {\n      if (!context?.user) return [];\n\n      // if (context.ioInstance && context.user) {\n      //   context.ioInstance.emit('LoggingIn'\x2C {\n      //     status: 'ok'\x2C\n      //     loggedInUser: context.user\n      //   });\n      //   console.log('loggingin');\n      // }\n\n      try {\n        const users = await User.find({ _id: { $ne: context.user._id } });\n\n        const enhancedUsers = users.map((user) => {\n          const userObj = user.toObject();\n          userObj.unreadCounts = formatUnreadCounts(user.unreadCounts);\n          return userObj;\n        });\n\n        return enhancedUsers;\n      } catch (error) {\n        console.error(error);\n        throw new Error('Failed to fetch users');\n      }\n    }\x2C\n\n    auth: async (_\x2C args\x2C context) => {\n      if (!context?.user) return null;\n\n      const user = await User.findById(context.user._id);\n      const userObj = user.toObject();\n      userObj.unreadCounts = formatUnreadCounts(user.unreadCounts);\n      // // Example usage: emit to a room\n      // io.to(user._id.toString()).emit('user:authCheck'\x2C { status: 'ok' });\n      // io.broadcast.emit('LoggingIn'\x2C { status: 'ok'\x2C loggedInUser: user });\n\n      return userObj;\n    }\x2C\n\n    getUnread: async (_\x2C { senderId\x2C recipientId }) => {\n      try {\n        // Validate recipient\n        const recipient = await User.findById(recipientId);\n        if (!recipient) throw new Error('Recipient not found');\n\n        // Look for UnreadMsg document between sender and recipient\n        const unreadEntry = await UnreadMsg.findOne({\n          sender: senderId\x2C\n          recipient: recipientId\n        });\n\n        // Return UnreadResult format\n        return {\n          count: unreadEntry?.count || 0\x2C\n          lastMessage: unreadEntry?.lastMessage || ''\x2C\n          updatedAt: unreadEntry?.updatedAt || ''\x2C\n          createdAt: unreadEntry?.createdAt || ''\n        };\n      } catch (err) {\n        console.error('\u274c getUnread error:'\x2C err);\n        throw new Error('Failed to get unread count');\n      }\n    }\x2C\n    messages: async (_\x2C { chatId }\x2C context) => {\n      try {\n        if (!context?.user) throw new Error('Unauthorized');\n\n        const msgs = await ChatMessage.find({ chat: chatId })\n          .populate('sender')\n          .populate('receiver')\n          .sort({ createdAt: 1 });\n\n        // \u2705 attach imageUrl dynamically here\n        return msgs.map((m) => ({\n          ...m.toObject()\x2C\n          imageUrl: m.imageFileId\n            ? `https://socketiochat-production.up.railway.app/chat-pictures/${m.imageFileId.toString()}?t=${Date.now()}`\n            : null\n        }));\n      } catch (err) {\n        console.error('\u274c messages resolver error:'\x2C err);\n        throw new Error('Failed to fetch messages');\n      }\n    }\x2C\n    fetch_chats: async (_\x2C { userId\x2C currentUserId }) => {\n      try {\n        // \u2705 Fetch sender and receiver messages with lean (plain JS objects\x2C much faster)\n        const messages = await ChatMessage.find({\n          $or: [\n            { sender: userId\x2C receiver: currentUserId }\x2C\n            { sender: currentUserId\x2C receiver: userId }\n          ]\n        })\n          .sort({ createdAt: 1 }) // oldest \u2192 newest\n          .populate('sender'\x2C '_id username picture')\n          .populate('receiver'\x2C '_id username picture')\n          .lean(); // \u26a1 returns plain JS objects instead of full mongoose docs\n\n        // \u2705 Optionally fetch "notifiedUser" with lean\n        const notifiedUser = await User.findById(userId).lean();\n\n        // \u2705 Transform messages to include image/placeholder URLs\n        const enhancedMessages = messages.map((msg) => ({\n          ...msg\x2C\n          imageUrl: msg.imageFileId\n            ? `https://socketiochat-production.up.railway.app/chat-pictures/${msg.imageFileId.toString()}?t=${Date.now()}`\n            : null\x2C\n          placeholderUrl: msg.placeholderImgId\n            ? `https://socketiochat-production.up.railway.app/chat-pictures/${msg.placeholderImgId.toString()}?t=${Date.now()}`\n            : null\n        }));\n\n        return {\n          messages: enhancedMessages\x2C\n          notifiedUser\n        };\n      } catch (err) {\n        console.error('\u274c fetch_chats error:'\x2C err);\n        throw new Error('Failed to fetch chat history');\n      }\n    }\n    // fetch_chats: async (_\x2C { userId\x2C currentUserId }) => {\n    //   try {\n    //     // \u2705 Fetch sender and receiver messages\n    //     const messages = await ChatMessage.find({\n    //       $or: [\n    //         { sender: userId\x2C receiver: currentUserId }\x2C\n    //         { sender: currentUserId\x2C receiver: userId }\n    //       ]\n    //     })\n    //       .sort({ createdAt: 1 }) // oldest \u2192 newest\n    //       .populate('sender'\x2C '_id username picture')\n    //       .populate('receiver'\x2C '_id username picture');\n\n    //     // \u2705 Optionally fetch "notifiedUser"\n    //     const notifiedUser = await User.findById(userId);\n\n    //     // \u2705 Transform messages to include imageUrl from GridFS\n    //     const enhancedMessages = messages.map((msg) => ({\n    //       ...msg.toObject()\x2C\n    //       imageUrl: msg.imageFileId\n    //         ? `https://socketiochat-production.up.railway.app/chat-pictures/${msg.imageFileId.toString()}?t=${Date.now()}`\n    //         : null\x2C\n    //       placeholderUrl: msg.placeholderImgId\n    //         ? `https://socketiochat-production.up.railway.app/chat-pictures/${msg.placeholderImgId.toString()}?t=${Date.now()}`\n    //         : null\n    //     }));\n\n    //     return {\n    //       messages: enhancedMessages\x2C\n    //       notifiedUser\n    //     };\n    //   } catch (err) {\n    //     console.error('\u274c fetch_chats error:'\x2C err);\n    //     throw new Error('Failed to fetch chat history');\n    //   }\n    // }\n  }\x2C\n\n  Mutation: {\n    updateProfile: async (_\x2C { input }\x2C { user\x2C ioInstance }) => {\n      if (!user) throw new Error('Not authenticated');\n\n      try {\n        if (input.email) {\n          const existingEmailUser = await User.findOne({ email: input.email });\n\n          // // If the email exists and doesn't belong to the current user\x2C block it\n          // if (existingEmailUser && existingEmailUser._id.toString() !== user._id.toString()) {\n          //   throw new Error("Email is already taken by another user");\n          // }\n          if (existingEmailUser) {\n            const updated = await User.findByIdAndUpdate(existingEmailUser._id\x2C input\x2C {\n              new: true\x2C\n              runValidators: true\n            });\n\n            if (ioInstance && existingEmailUser) {\n              ioInstance.emit('Updating'\x2C { updatedUser: updated });\n            }\n            return {\n              success: true\x2C\n              message: 'Profile updated successfully'\x2C\n              user: updated\n            };\n          }\n        }\n      } catch (err) {\n        return {\n          success: false\x2C\n          message: err.message || 'Failed to update profile'\x2C\n          user: null\n        };\n      }\n    }\x2C\n\n    createUnread: async (_\x2C { input }) => {\n      const { senderId\x2C recipientId\x2C newMessage } = input;\n      try {\n        // Find existing unread record for this recipient/sender pair\n        let unread = await UnreadMsg.findOne({ sender: senderId\x2C recipient: recipientId });\n        if (!unread) {\n          // Create a new one if it doesn't exist\n          unread = new UnreadMsg({\n            sender: senderId\x2C\n            recipient: recipientId\x2C\n            count: 1\x2C\n            lastMessage: newMessage\n          });\n        } else {\n          // Update existing one\n          unread.count += 1;\n          unread.lastMessage = newMessage;\n        }\n        await unread.save();\n        return {\n          count: unread.count\x2C\n          lastMessage: unread.lastMessage\n        };\n      } catch (err) {\n        console.error('\u274c createUnread error:'\x2C err);\n        throw new Error('Failed to update unread count');\n      }\n    }\x2C\n\n    clearUnread: async (_\x2C { senderId\x2C recipientId }) => {\n      try {\n        const unread = await UnreadMsg.findOne({ sender: senderId\x2C recipient: recipientId });\n\n        if (!unread) return true; // Nothing to clear\n\n        unread.count = 0;\n        await unread.save();\n\n        return true;\n      } catch (err) {\n        console.error('\u274c clearUnread error:'\x2C err);\n        return false;\n      }\n    }\x2C\n\n    markMessagesAsRead: async (_\x2C { senderId }\x2C context) => {\n      const recipientId = context.user?._id;\n      if (!recipientId) throw new Error('Unauthorized');\n\n      try {\n        await UnreadMsg.deleteMany({\n          sender: senderId\x2C\n          recipient: recipientId\n        });\n\n        return true;\n      } catch (err) {\n        console.error('\u274c markMessagesAsRead error:'\x2C err);\n        return false;\n      }\n    }\n  }\n};\n\nexport default resolvers;\n
