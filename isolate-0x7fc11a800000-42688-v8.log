script-source,984,/Users/mac/Kelechi/node-chat-app/node_modules/engine.io/node_modules/ws/lib/stream.js,'use strict';\n\nconst { Duplex } = require('stream');\n\n/**\n * Emits the `'close'` event on a stream.\n *\n * @param {Duplex} stream The stream.\n * @private\n */\nfunction emitClose(stream) {\n  stream.emit('close');\n}\n\n/**\n * The listener of the `'end'` event.\n *\n * @private\n */\nfunction duplexOnEnd() {\n  if (!this.destroyed && this._writableState.finished) {\n    this.destroy();\n  }\n}\n\n/**\n * The listener of the `'error'` event.\n *\n * @param {Error} err The error\n * @private\n */\nfunction duplexOnError(err) {\n  this.removeListener('error'\x2C duplexOnError);\n  this.destroy();\n  if (this.listenerCount('error') === 0) {\n    // Do not suppress the throwing behavior.\n    this.emit('error'\x2C err);\n  }\n}\n\n/**\n * Wraps a `WebSocket` in a duplex stream.\n *\n * @param {WebSocket} ws The `WebSocket` to wrap\n * @param {Object} [options] The options for the `Duplex` constructor\n * @return {Duplex} The duplex stream\n * @public\n */\nfunction createWebSocketStream(ws\x2C options) {\n  let terminateOnDestroy = true;\n\n  const duplex = new Duplex({\n    ...options\x2C\n    autoDestroy: false\x2C\n    emitClose: false\x2C\n    objectMode: false\x2C\n    writableObjectMode: false\n  });\n\n  ws.on('message'\x2C function message(msg\x2C isBinary) {\n    const data =\n      !isBinary && duplex._readableState.objectMode ? msg.toString() : msg;\n\n    if (!duplex.push(data)) ws.pause();\n  });\n\n  ws.once('error'\x2C function error(err) {\n    if (duplex.destroyed) return;\n\n    // Prevent `ws.terminate()` from being called by `duplex._destroy()`.\n    //\n    // - If the `'error'` event is emitted before the `'open'` event\x2C then\n    //   `ws.terminate()` is a noop as no socket is assigned.\n    // - Otherwise\x2C the error is re-emitted by the listener of the `'error'`\n    //   event of the `Receiver` object. The listener already closes the\n    //   connection by calling `ws.close()`. This allows a close frame to be\n    //   sent to the other peer. If `ws.terminate()` is called right after this\x2C\n    //   then the close frame might not be sent.\n    terminateOnDestroy = false;\n    duplex.destroy(err);\n  });\n\n  ws.once('close'\x2C function close() {\n    if (duplex.destroyed) return;\n\n    duplex.push(null);\n  });\n\n  duplex._destroy = function (err\x2C callback) {\n    if (ws.readyState === ws.CLOSED) {\n      callback(err);\n      process.nextTick(emitClose\x2C duplex);\n      return;\n    }\n\n    let called = false;\n\n    ws.once('error'\x2C function error(err) {\n      called = true;\n      callback(err);\n    });\n\n    ws.once('close'\x2C function close() {\n      if (!called) callback(err);\n      process.nextTick(emitClose\x2C duplex);\n    });\n\n    if (terminateOnDestroy) ws.terminate();\n  };\n\n  duplex._final = function (callback) {\n    if (ws.readyState === ws.CONNECTING) {\n      ws.once('open'\x2C function open() {\n        duplex._final(callback);\n      });\n      return;\n    }\n\n    // If the value of the `_socket` property is `null` it means that `ws` is a\n    // client websocket and the handshake failed. In fact\x2C when this happens\x2C a\n    // socket is never assigned to the websocket. Wait for the `'error'` event\n    // that will be emitted by the websocket.\n    if (ws._socket === null) return;\n\n    if (ws._socket._writableState.finished) {\n      callback();\n      if (duplex._readableState.endEmitted) duplex.destroy();\n    } else {\n      ws._socket.once('finish'\x2C function finish() {\n        // `duplex` is not destroyed here because the `'end'` event will be\n        // emitted on `duplex` after this `'finish'` event. The EOF signaling\n        // `null` chunk is\x2C in fact\x2C pushed when the websocket emits `'close'`.\n        callback();\n      });\n      ws.close();\n    }\n  };\n\n  duplex._read = function () {\n    if (ws.isPaused) ws.resume();\n  };\n\n  duplex._write = function (chunk\x2C encoding\x2C callback) {\n    if (ws.readyState === ws.CONNECTING) {\n      ws.once('open'\x2C function open() {\n        duplex._write(chunk\x2C encoding\x2C callback);\n      });\n      return;\n    }\n\n    ws.send(chunk\x2C callback);\n  };\n\n  duplex.on('end'\x2C duplexOnEnd);\n  duplex.on('error'\x2C duplexOnError);\n  return duplex;\n}\n\nmodule.exports = createWebSocketStream;\n
