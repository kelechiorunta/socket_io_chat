script-source,2002,/Users/mac/Kelechi/node-chat-app/node_modules/semver/ranges/min-satisfying.js,'use strict'\n\nconst SemVer = require('../classes/semver')\nconst Range = require('../classes/range')\nconst minSatisfying = (versions\x2C range\x2C options) => {\n  let min = null\n  let minSV = null\n  let rangeObj = null\n  try {\n    rangeObj = new Range(range\x2C options)\n  } catch (er) {\n    return null\n  }\n  versions.forEach((v) => {\n    if (rangeObj.test(v)) {\n      // satisfies(v\x2C range\x2C options)\n      if (!min || minSV.compare(v) === 1) {\n        // compare(min\x2C v\x2C true)\n        min = v\n        minSV = new SemVer(min\x2C options)\n      }\n    }\n  })\n  return min\n}\nmodule.exports = minSatisfying\n
