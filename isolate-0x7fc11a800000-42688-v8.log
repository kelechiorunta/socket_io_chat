script-source,2199,/Users/mac/Kelechi/node-chat-app/node_modules/passport-oauth2/lib/strategy.js,// Load modules.\nvar passport = require('passport-strategy')\n  \x2C url = require('url')\n  \x2C uid = require('uid2')\n  \x2C crypto = require('crypto')\n  \x2C base64url = require('base64url')\n  \x2C util = require('util')\n  \x2C utils = require('./utils')\n  \x2C OAuth2 = require('oauth').OAuth2\n  \x2C NullStore = require('./state/null')\n  \x2C NonceStore = require('./state/session')\n  \x2C StateStore = require('./state/store')\n  \x2C PKCEStateStore = require('./state/pkcesession')\n  \x2C AuthorizationError = require('./errors/authorizationerror')\n  \x2C TokenError = require('./errors/tokenerror')\n  \x2C InternalOAuthError = require('./errors/internaloautherror');\n\n\n/**\n * Creates an instance of `OAuth2Strategy`.\n *\n * The OAuth 2.0 authentication strategy authenticates requests using the OAuth\n * 2.0 framework.\n *\n * OAuth 2.0 provides a facility for delegated authentication\x2C whereby users can\n * authenticate using a third-party service such as Facebook.  Delegating in\n * this manner involves a sequence of events\x2C including redirecting the user to\n * the third-party service for authorization.  Once authorization has been\n * granted\x2C the user is redirected back to the application and an authorization\n * code can be used to obtain credentials.\n *\n * Applications must supply a `verify` callback\x2C for which the function\n * signature is:\n *\n *     function(accessToken\x2C refreshToken\x2C profile\x2C done) { ... }\n *\n * The verify callback is responsible for finding or creating the user\x2C and\n * invoking `done` with the following arguments:\n *\n *     done(err\x2C user\x2C info);\n *\n * `user` should be set to `false` to indicate an authentication failure.\n * Additional `info` can optionally be passed as a third argument\x2C typically\n * used to display informational messages.  If an exception occured\x2C `err`\n * should be set.\n *\n * Options:\n *\n *   - `authorizationURL`  URL used to obtain an authorization grant\n *   - `tokenURL`          URL used to obtain an access token\n *   - `clientID`          identifies client to service provider\n *   - `clientSecret`      secret used to establish ownership of the client identifer\n *   - `callbackURL`       URL to which the service provider will redirect the user after obtaining authorization\n *   - `passReqToCallback` when `true`\x2C `req` is the first argument to the verify callback (default: `false`)\n *\n * Examples:\n *\n *     passport.use(new OAuth2Strategy({\n *         authorizationURL: 'https://www.example.com/oauth2/authorize'\x2C\n *         tokenURL: 'https://www.example.com/oauth2/token'\x2C\n *         clientID: '123-456-789'\x2C\n *         clientSecret: 'shhh-its-a-secret'\n *         callbackURL: 'https://www.example.net/auth/example/callback'\n *       }\x2C\n *       function(accessToken\x2C refreshToken\x2C profile\x2C done) {\n *         User.findOrCreate(...\x2C function (err\x2C user) {\n *           done(err\x2C user);\n *         });\n *       }\n *     ));\n *\n * @constructor\n * @param {Object} options\n * @param {Function} verify\n * @api public\n */\nfunction OAuth2Strategy(options\x2C verify) {\n  if (typeof options == 'function') {\n    verify = options;\n    options = undefined;\n  }\n  options = options || {};\n\n  if (!verify) { throw new TypeError('OAuth2Strategy requires a verify callback'); }\n  if (!options.authorizationURL) { throw new TypeError('OAuth2Strategy requires a authorizationURL option'); }\n  if (!options.tokenURL) { throw new TypeError('OAuth2Strategy requires a tokenURL option'); }\n  if (!options.clientID) { throw new TypeError('OAuth2Strategy requires a clientID option'); }\n\n  passport.Strategy.call(this);\n  this.name = 'oauth2';\n  this._verify = verify;\n\n  // NOTE: The _oauth2 property is considered "protected".  Subclasses are\n  //       allowed to use it when making protected resource requests to retrieve\n  //       the user profile.\n  this._oauth2 = new OAuth2(options.clientID\x2C  options.clientSecret\x2C\n                            ''\x2C options.authorizationURL\x2C options.tokenURL\x2C options.customHeaders);\n\n  this._callbackURL = options.callbackURL;\n  this._scope = options.scope;\n  this._scopeSeparator = options.scopeSeparator || ' ';\n  this._pkceMethod = (options.pkce === true) ? 'S256' : options.pkce;\n  this._key = options.sessionKey || ('oauth2:' + url.parse(options.authorizationURL).hostname);\n\n  if (options.store && typeof options.store == 'object') {\n    this._stateStore = options.store;\n  } else if (options.store) {\n    this._stateStore = options.pkce ? new PKCEStateStore({ key: this._key }) : new StateStore({ key: this._key });\n  } else if (options.state) {\n    this._stateStore = options.pkce ? new PKCEStateStore({ key: this._key }) : new NonceStore({ key: this._key });\n  } else {\n    if (options.pkce) { throw new TypeError('OAuth2Strategy requires `state: true` option when PKCE is enabled'); }\n    this._stateStore = new NullStore();\n  }\n  this._trustProxy = options.proxy;\n  this._passReqToCallback = options.passReqToCallback;\n  this._skipUserProfile = (options.skipUserProfile === undefined) ? false : options.skipUserProfile;\n}\n\n// Inherit from `passport.Strategy`.\nutil.inherits(OAuth2Strategy\x2C passport.Strategy);\n\n\n/**\n * Authenticate request by delegating to a service provider using OAuth 2.0.\n *\n * @param {Object} req\n * @api protected\n */\nOAuth2Strategy.prototype.authenticate = function(req\x2C options) {\n  options = options || {};\n  var self = this;\n\n  if (req.query && req.query.error) {\n    if (req.query.error == 'access_denied') {\n      return this.fail({ message: req.query.error_description });\n    } else {\n      return this.error(new AuthorizationError(req.query.error_description\x2C req.query.error\x2C req.query.error_uri));\n    }\n  }\n\n  var callbackUR