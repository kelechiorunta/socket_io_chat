script-source,415,file:///Users/mac/Kelechi/node-chat-app/server/model/UnreadMsg.js,// models/UnreadMsg.js\nimport mongoose\x2C { Schema } from 'mongoose';\n\nconst unreadMsgSchema = new Schema(\n  {\n    recipient: {\n      type: Schema.Types.ObjectId\x2C\n      ref: 'User'\x2C\n      required: true // Who receives the messages\n    }\x2C\n    sender: {\n      type: Schema.Types.ObjectId\x2C\n      ref: 'User'\x2C\n      required: true // Who sent them\n    }\x2C\n    count: {\n      type: Number\x2C\n      default: 0\n    }\x2C\n    lastMessage: {\n      type: String\x2C\n      default: ''\n    }\n  }\x2C\n  { timestamps: true }\n);\n\nexport default mongoose.models.UnreadMsg || mongoose.model('UnreadMsg'\x2C unreadMsgSchema);\n
