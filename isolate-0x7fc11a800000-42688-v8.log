script-source,417,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/schema/esm/checkForResolveTypeResolver.js,import { MapperKind\x2C mapSchema } from '@graphql-tools/utils';\n// If we have any union or interface types throw if no there is no resolveType resolver\nexport function checkForResolveTypeResolver(schema\x2C requireResolversForResolveType) {\n    mapSchema(schema\x2C {\n        [MapperKind.ABSTRACT_TYPE]: type => {\n            if (!type.resolveType) {\n                const message = `Type "${type.name}" is missing a "__resolveType" resolver. Pass 'ignore' into ` +\n                    '"resolverValidationOptions.requireResolversForResolveType" to disable this error.';\n                if (requireResolversForResolveType === 'error') {\n                    throw new Error(message);\n                }\n                if (requireResolversForResolveType === 'warn') {\n                    console.warn(message);\n                }\n            }\n            return undefined;\n        }\x2C\n    });\n}\n
