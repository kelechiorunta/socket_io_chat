script-source,416,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/schema/esm/chainResolvers.js,import { defaultFieldResolver } from 'graphql';\nexport function chainResolvers(resolvers) {\n    return (root\x2C args\x2C ctx\x2C info) => resolvers.reduce((prev\x2C curResolver) => {\n        if (curResolver != null) {\n            return curResolver(prev\x2C args\x2C ctx\x2C info);\n        }\n        return defaultFieldResolver(prev\x2C args\x2C ctx\x2C info);\n    }\x2C root);\n}\n
