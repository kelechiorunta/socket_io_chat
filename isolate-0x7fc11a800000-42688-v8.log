script-source,408,file:///Users/mac/Kelechi/node-chat-app/server/model/User.js,import mongoose from 'mongoose';\nimport bcrypt from 'bcrypt';\nimport validator from 'validator';\n\n// const unreadSchema = new mongoose.Schema({\n//     count: { type: Number\x2C default: 0 }\x2C\n//     lastMessage: { type: String\x2C default: '' }\n//   }\x2C { _id: false }); // Disable _id for subdocs inside Map\n\nconst userSchema = new mongoose.Schema({\n  username: { type: String\x2C required: false\x2C default: '' }\x2C\n  email: { type: String\x2C required: false\x2C validate: validator.isEmail }\x2C\n  password: { type: String\x2C required: false }\x2C\n  createdAt: { type: Date\x2C default: Date.now }\x2C\n  picture: { type: String\x2C required: false\x2C default: '' }\x2C\n  lastMessage: { type: String\x2C required: false\x2C default: '' }\x2C\n  lastMessageCount: { type: Number\x2C required: false\x2C default: 0 }\x2C\n  isOnline: { type: Boolean\x2C required: false\x2C default: null }\x2C\n  unread: [{ type: mongoose.Schema.Types.ObjectId\x2C ref: 'UnreadMsg'\x2C required: false }]\x2C\n  token: { type: String\x2C required: false }\x2C\n  birthday: { type: String\x2C required: false }\x2C\n  phone: { type: String\x2C required: false }\x2C\n  gender: { type: String\x2C required: false }\x2C\n  address: { type: String\x2C required: false }\x2C\n  otp: {\n    type: String\x2C\n    default: 'otp'\x2C\n    required: false\n    // required: true\x2C\n  }\x2C\n  expireAt: {\n    type: Date\x2C\n    default: () => new Date(Date.now() + 300 * 1000)\x2C // Set to 5 minutes from now\n    required: false\n  }\x2C\n  resetPasswordToken: { type: String\x2C required: false }\x2C\n  resetPasswordExpires: { type: Date\x2C required: false }\x2C\n  google: {\n    name: { type: String\x2C required: false }\x2C\n    email: { type: String\x2C required: false\x2C validate: validator.isEmail }\x2C\n    accessToken: { type: String\x2C required: false }\x2C\n    active: { type: Boolean\x2C required: false }\n  }\n  // Example schema update\n  // unreadCounts: {\n  //     type: Map\x2C\n  //     of: unreadSchema\x2C\n  //     default: () => new Map()\n  //   }\x2C\n});\n\n// Pre-save hook to hash the password before saving the user\nuserSchema.pre('save'\x2C async function (next) {\n  if (!this.isModified('password')) return next();\n  this.password = await bcrypt.hash(this.password\x2C 10);\n  next();\n});\n\n// Method to check if entered password matches the hashed password\nuserSchema.methods.comparePassword = async function (enteredPassword) {\n  return await bcrypt.compare(enteredPassword\x2C this.password);\n};\n\n// Ensure unique email index\nuserSchema.index({ email: 1 }\x2C { unique: true });\n\nconst User = mongoose.models.User || mongoose.model('User'\x2C userSchema);\n\nexport default User;\n
