script-source,694,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/utils/esm/comments.js,import { TokenKind\x2C visit\x2C } from 'graphql';\nconst MAX_LINE_LENGTH = 80;\nlet commentsRegistry = {};\nexport function resetComments() {\n    commentsRegistry = {};\n}\nexport function collectComment(node) {\n    const entityName = node.name?.value;\n    if (entityName == null) {\n        return;\n    }\n    pushComment(node\x2C entityName);\n    switch (node.kind) {\n        case 'EnumTypeDefinition':\n            if (node.values) {\n                for (const value of node.values) {\n                    pushComment(value\x2C entityName\x2C value.name.value);\n                }\n            }\n            break;\n        case 'ObjectTypeDefinition':\n        case 'InputObjectTypeDefinition':\n        case 'InterfaceTypeDefinition':\n            if (node.fields) {\n                for (const field of node.fields) {\n                    pushComment(field\x2C entityName\x2C field.name.value);\n                    if (isFieldDefinitionNode(field) && field.arguments) {\n                        for (const arg of field.arguments) {\n                            pushComment(arg\x2C entityName\x2C field.name.value\x2C arg.name.value);\n                        }\n                    }\n                }\n            }\n            break;\n    }\n}\nexport function pushComment(node\x2C entity\x2C field\x2C argument) {\n    const comment = getComment(node);\n    if (typeof comment !== 'string' || comment.length === 0) {\n        return;\n    }\n    const keys = [entity];\n    if (field) {\n        keys.push(field);\n        if (argument) {\n            keys.push(argument);\n        }\n    }\n    const path = keys.join('.');\n    if (!commentsRegistry[path]) {\n        commentsRegistry[path] = [];\n    }\n    commentsRegistry[path].push(comment);\n}\nexport function printComment(comment) {\n    return '\\n# ' + comment.replace(/\\n/g\x2C '\\n# ');\n}\n/**\n * Copyright (c) 2015-present\x2C Facebook\x2C Inc.\n *\n * This source code is licensed under the MIT license found in the\n * LICENSE file in the root directory of this source tree.\n */\n/**\n * NOTE: ==> This file has been modified just to add comments to the printed AST\n * This is a temp measure\x2C we will move to using the original non modified printer.js ASAP.\n */\n/**\n * Given maybeArray\x2C print an empty string if it is null or empty\x2C otherwise\n * print all items together separated by separator if provided\n */\nfunction join(maybeArray\x2C separator) {\n    return maybeArray ? maybeArray.filter(x => x).join(separator || '') : '';\n}\nfunction hasMultilineItems(maybeArray) {\n    return maybeArray?.some(str => str.includes('\\n')) ?? false;\n}\nfunction addDescription(cb) {\n    return (node\x2C _key\x2C _parent\x2C path\x2C ancestors) => {\n        const keys = [];\n        const parent = path.reduce((prev\x2C key) => {\n            if (['fields'\x2C 'arguments'\x2C 'values'].includes(key) && prev.name) {\n                keys.push(prev.name.value);\n            }\n            return prev[key];\n        }\x2C ancestors[0]);\n        const key = [...keys\x2C parent?.name?.value].filter(Boolean).join('.');\n        const items = [];\n        if (node.kind.includes('Definition') && commentsRegistry[key]) {\n            items.push(...commentsRegistry[key]);\n        }\n        return join([...items.map(printComment)\x2C node.description\x2C cb(node\x2C _key\x2C _parent\x2C path\x2C ancestors)]\x2C '\\n');\n    };\n}\nfunction indent(maybeString) {\n    return maybeString && `  ${maybeString.replace(/\\n/g\x2C '\\n  ')}`;\n}\n/**\n * Given array\x2C print each item on its own line\x2C wrapped in an\n * indented "{ }" block.\n */\nfunction block(array) {\n    return array && array.length !== 0 ? `{\\n${indent(join(array\x2C '\\n'))}\\n}` : '';\n}\n/**\n * If maybeString is not null or empty\x2C then wrap with start and end\x2C otherwise\n * print an empty string.\n */\nfunction wrap(start\x2C maybeString\x2C end) {\n    return maybeString ? start + maybeString + (end || '') : '';\n}\n/**\n * Print a block string in the indented block form by adding a leading and\n * trailing blank line. However\x2C if a block string starts with whitespace and is\n * a single-line\x2C adding a leading blank line would strip that whitespace.\n */\nfunction printBlockString(value\x2C isDescription = false) {\n    const escaped = value.replace(/\\\\/g\x2C '\\\\\\\\').replace(/"""/g\x2C '\\\\"""');\n    return (value[0] === ' ' || value[0] === '\\t') && value.indexOf('\\n') === -1\n        ? `"""${escaped.replace(/"$/\x2C '"\\n')}"""`\n        : `"""\\n${isDescription ? escaped : indent(escaped)}\\n"""`;\n}\nconst printDocASTReducer = {\n    Name: { leave: node => node.value }\x2C\n    Variable: { leave: node => '$' + node.name }\x2C\n    // Document\n    Document: {\n        leave: node => join(node.definitions\x2C '\\n\\n')\x2C\n    }\x2C\n    OperationDefinition: {\n        leave: node => {\n            const varDefs = wrap('('\x2C join(node.variableDefinitions\x2C '\x2C ')\x2C ')');\n            const prefix = join([node.operation\x2C join([node.name\x2C varDefs])\x2C join(node.directives\x2C ' ')]\x2C ' ');\n            // the query short form.\n            return prefix + ' ' + node.selectionSet;\n        }\x2C\n    }\x2C\n    VariableDefinition: {\n        leave: ({ variable\x2C type\x2C defaultValue\x2C directives }) => variable + ': ' + type + wrap(' = '\x2C defaultValue) + wrap(' '\x2C join(directives\x2C ' '))\x2C\n    }\x2C\n    SelectionSet: { leave: ({ selections }) => block(selections) }\x2C\n    Field: {\n        leave({ alias\x2C name\x2C arguments: args\x2C directives\x2C selectionSet }) {\n            const prefix = wrap(''\x2C alias\x2C ': ') + name;\n            let argsLine = prefix + wrap('('\x2C join(args\x2C '\x2C ')\x2C ')');\n            if (argsLine.length > MAX_LINE_LENGTH) {\n                argsLine = prefix + wrap('(\\n'\x2C indent(join(args\x2C '\\n'))\x2C '\\n)');\n            }\n            return join([argsLine\x2C join(directives\x2C ' ')\x2C selectionSet]\x2C ' ');\n        }\x2C\n    }\x2C\n    Argument: { leave: ({ name\x2C value }) => name + ': ' + value }\x2C\n    // Fragments\n    FragmentSpread: {\n        leave: ({ name\x2C directives }) => '...' + name + wrap(' '\x2C join(directives\x2C ' '))\x2C\n    }\x2C\n    InlineFragment: {\n        leave: ({ typeCondition\x2C directives\x2C selectionSet }) => join(['...'\x2C wrap('on '\x2C typeCondition)\x2C join(directives\x2C ' ')\x2C selectionSet]\x2C ' ')\x2C\n    }\x2C\n    FragmentDefinition: {\n        leave: ({ name\x2C typeCondition\x2C variableDefinitions\x2C directives\x2C selectionSet }) => \n        // Note: fragment variable definitions are experimental and may be changed\n        // or removed in the future.\n        `fragment ${name}${wrap('('\x2C join(variableDefinitions\x2C '\x2C ')\x2C ')')} ` +\n            `on ${typeCondition} ${wrap(''\x2C join(directives\x2C ' ')\x2C ' ')}` +\n            selectionSet\x2C\n    }\x2C\n    // Value\n    IntValue: { leave: ({ value }) => value }\x2C\n    FloatValue: { leave: ({ value }) => value }\x2C\n    StringValue: {\n        leave: ({ value\x2C block: isBlockString }) => {\n            if (isBlockString) {\n                return printBlockString(value);\n            }\n            return JSON.stringify(value);\n        }\x2C\n    }\x2C\n    BooleanValue: { leave: ({ value }) => (value ? 'true' : 'false') }\x2C\n    NullValue: { leave: () => 'null' }\x2C\n    EnumValue: { leave: ({ value }) => value }\x2C\n    ListValue: { leave: ({ values }) => '[' + join(values\x2C '\x2C ') + ']' }\x2C\n    ObjectValue: { leave: ({ fields }) => '{' + join(fields\x2C '\x2C ') + '}' }\x2C\n    ObjectField: { leave: ({ name\x2C value }) => name + ': ' + value }\x2C\n    // Directive\n    Directive: {\n        leave: ({ name\x2C arguments: args }) => '@' + name + wrap('('\x2C join(