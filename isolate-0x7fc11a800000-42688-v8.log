script-source,661,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/utils/esm/parse-graphql-sdl.js,import { Source as GraphQLSource\x2C isTypeSystemDefinitionNode\x2C Kind\x2C parse\x2C print\x2C visit\x2C } from 'graphql';\nimport { dedentBlockStringValue\x2C getLeadingCommentBlock } from './comments.js';\nexport function parseGraphQLSDL(location\x2C rawSDL\x2C options = {}) {\n    let document;\n    try {\n        if (options.commentDescriptions && rawSDL.includes('#')) {\n            document = transformCommentsToDescriptions(rawSDL\x2C options);\n            // If noLocation=true\x2C we need to make sure to print and parse it again\x2C to remove locations\x2C\n            // since `transformCommentsToDescriptions` must have locations set in order to transform the comments\n            // into descriptions.\n            if (options.noLocation) {\n                document = parse(print(document)\x2C options);\n            }\n        }\n        else {\n            document = parse(new GraphQLSource(rawSDL\x2C location)\x2C options);\n        }\n    }\n    catch (e) {\n        if (e.message.includes('EOF') && rawSDL.replace(/(\\#[^*]*)/g\x2C '').trim() === '') {\n            document = {\n                kind: Kind.DOCUMENT\x2C\n                definitions: []\x2C\n            };\n        }\n        else {\n            throw e;\n        }\n    }\n    return {\n        location\x2C\n        document\x2C\n    };\n}\nexport function transformCommentsToDescriptions(sourceSdl\x2C options = {}) {\n    const parsedDoc = parse(sourceSdl\x2C {\n        ...options\x2C\n        noLocation: false\x2C\n    });\n    const modifiedDoc = visit(parsedDoc\x2C {\n        leave: (node) => {\n            if (isDescribable(node)) {\n                const rawValue = getLeadingCommentBlock(node);\n                if (rawValue !== undefined) {\n                    const commentsBlock = dedentBlockStringValue('\\n' + rawValue);\n                    const isBlock = commentsBlock.includes('\\n');\n                    if (!node.description) {\n                        return {\n                            ...node\x2C\n                            description: {\n                                kind: Kind.STRING\x2C\n                                value: commentsBlock\x2C\n                                block: isBlock\x2C\n                            }\x2C\n                        };\n                    }\n                    else {\n                        return {\n                            ...node\x2C\n                            description: {\n                                ...node.description\x2C\n                                value: node.description.value + '\\n' + commentsBlock\x2C\n                                block: true\x2C\n                            }\x2C\n                        };\n                    }\n                }\n            }\n        }\x2C\n    });\n    return modifiedDoc;\n}\nexport function isDescribable(node) {\n    return (isTypeSystemDefinitionNode(node) ||\n        node.kind === Kind.FIELD_DEFINITION ||\n        node.kind === Kind.INPUT_VALUE_DEFINITION ||\n        node.kind === Kind.ENUM_VALUE_DEFINITION);\n}\n
