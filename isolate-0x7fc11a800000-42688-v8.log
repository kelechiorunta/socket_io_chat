       // if not repeatable and found directive with the same name already in the result set\x2C\n                // then merge the arguments of the existing directive and the new directive\n                const mergedArguments = mergeArguments(directive.arguments ?? []\x2C result[firstAt].arguments ?? []);\n                result[firstAt] = {\n                    ...result[firstAt]\x2C\n                    arguments: mergedArguments.length === 0 ? undefined : mergedArguments\x2C\n                };\n            }\n        }\n    }\n    return result;\n}\nexport function mergeDirective(node\x2C existingNode) {\n    if (existingNode) {\n        return {\n            ...node\x2C\n            arguments: deduplicateLists(existingNode.arguments || []\x2C node.arguments || []\x2C (arg\x2C existingArgs) => !nameAlreadyExists(arg.name\x2C existingArgs.map(a => a.name)))\x2C\n            locations: [\n                ...existingNode.locations\x2C\n                ...node.locations.filter(name => !nameAlreadyExists(name\x2C existingNode.locations))\x2C\n            ]\x2C\n        };\n    }\n    return node;\n}\nfunction deduplicateLists(source\x2C target\x2C filterFn) {\n    return source.concat(target.filter(val => filterFn(val\x2C source)));\n}\n
