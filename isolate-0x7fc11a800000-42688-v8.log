script-source,1776,/Users/mac/Kelechi/node-chat-app/node_modules/semver/functions/parse.js,'use strict'\n\nconst SemVer = require('../classes/semver')\nconst parse = (version\x2C options\x2C throwErrors = false) => {\n  if (version instanceof SemVer) {\n    return version\n  }\n  try {\n    return new SemVer(version\x2C options)\n  } catch (er) {\n    if (!throwErrors) {\n      return null\n    }\n    throw er\n  }\n}\n\nmodule.exports = parse\n
