script-source,1556,/Users/mac/Kelechi/node-chat-app/node_modules/debug/src/node.js,/**\n * Module dependencies.\n */\n\nconst tty = require('tty');\nconst util = require('util');\n\n/**\n * This is the Node.js implementation of `debug()`.\n */\n\nexports.init = init;\nexports.log = log;\nexports.formatArgs = formatArgs;\nexports.save = save;\nexports.load = load;\nexports.useColors = useColors;\nexports.destroy = util.deprecate(\n\x09() => {}\x2C\n\x09'Instance method `debug.destroy()` is deprecated and no longer does anything. It will be removed in the next major version of `debug`.'\n);\n\n/**\n * Colors.\n */\n\nexports.colors = [6\x2C 2\x2C 3\x2C 4\x2C 5\x2C 1];\n\ntry {\n\x09// Optional dependency (as in\x2C doesn't need to be installed\x2C NOT like optionalDependencies in package.json)\n\x09// eslint-disable-next-line import/no-extraneous-dependencies\n\x09const supportsColor = require('supports-color');\n\n\x09if (supportsColor && (supportsColor.stderr || supportsColor).level >= 2) {\n\x09\x09exports.colors = [\n\x09\x09\x0920\x2C\n\x09\x09\x0921\x2C\n\x09\x09\x0926\x2C\n\x09\x09\x0927\x2C\n\x09\x09\x0932\x2C\n\x09\x09\x0933\x2C\n\x09\x09\x0938\x2C\n\x09\x09\x0939\x2C\n\x09\x09\x0940\x2C\n\x09\x09\x0941\x2C\n\x09\x09\x0942\x2C\n\x09\x09\x0943\x2C\n\x09\x09\x0944\x2C\n\x09\x09\x0945\x2C\n\x09\x09\x0956\x2C\n\x09\x09\x0957\x2C\n\x09\x09\x0962\x2C\n\x09\x09\x0963\x2C\n\x09\x09\x0968\x2C\n\x09\x09\x0969\x2C\n\x09\x09\x0974\x2C\n\x09\x09\x0975\x2C\n\x09\x09\x0976\x2C\n\x09\x09\x0977\x2C\n\x09\x09\x0978\x2C\n\x09\x09\x0979\x2C\n\x09\x09\x0980\x2C\n\x09\x09\x0981\x2C\n\x09\x09\x0992\x2C\n\x09\x09\x0993\x2C\n\x09\x09\x0998\x2C\n\x09\x09\x0999\x2C\n\x09\x09\x09112\x2C\n\x09\x09\x09113\x2C\n\x09\x09\x09128\x2C\n\x09\x09\x09129\x2C\n\x09\x09\x09134\x2C\n\x09\x09\x09135\x2C\n\x09\x09\x09148\x2C\n\x09\x09\x09149\x2C\n\x09\x09\x09160\x2C\n\x09\x09\x09161\x2C\n\x09\x09\x09162\x2C\n\x09\x09\x09163\x2C\n\x09\x09\x09164\x2C\n\x09\x09\x09165\x2C\n\x09\x09\x09166\x2C\n\x09\x09\x