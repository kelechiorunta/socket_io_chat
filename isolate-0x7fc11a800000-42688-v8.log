script-source,1475,/Users/mac/Kelechi/node-chat-app/node_modules/mongoose/lib/cast/double.js,'use strict';\n\nconst assert = require('assert');\nconst BSON = require('bson');\nconst isBsonType = require('../helpers/isBsonType');\n\n/**\n * Given a value\x2C cast it to a IEEE 754-2008 floating point\x2C or throw an `Error` if the value\n * cannot be casted. `null`\x2C `undefined`\x2C and `NaN` are considered valid inputs.\n *\n * @param {Any} value\n * @return {Number}\n * @throws {Error} if `value` does not represent a IEEE 754-2008 floating point. If casting from a string\x2C see [BSON Double.fromString API documentation](https://mongodb.github.io/node-mongodb-native/Next/classes/BSON.Double.html#fromString)\n * @api private\n */\n\nmodule.exports = function castDouble(val) {\n  if (val == null || val === '') {\n    return null;\n  }\n\n  let coercedVal;\n  if (isBsonType(val\x2C 'Long')) {\n    coercedVal = val.toNumber();\n  } else if (typeof val === 'string') {\n    try {\n      coercedVal = BSON.Double.fromString(val);\n      return coercedVal;\n    } catch {\n      assert.ok(false);\n    }\n  } else if (typeof val === 'object') {\n    const tempVal = val.valueOf() ?? val.toString();\n    // ex: { a: 'im an object\x2C valueOf: () => 'helloworld' } // throw an error\n    if (typeof tempVal === 'string') {\n      try {\n        coercedVal = BSON.Double.fromString(val);\n        return coercedVal;\n      } catch {\n        assert.ok(false);\n      }\n    } else {\n      coercedVal = Number(tempVal);\n    }\n  } else {\n    coercedVal = Number(val);\n  }\n\n  return new BSON.Double(coercedVal);\n};\n
