script-source,1564,/Users/mac/Kelechi/node-chat-app/node_modules/mongoose/lib/helpers/update/removeUnusedArrayFilters.js,'use strict';\n\n/**\n * MongoDB throws an error if there's unused array filters. That is\x2C if `options.arrayFilters` defines\n * a filter\x2C but none of the `update` keys use it. This should be enough to filter out all unused array\n * filters.\n */\n\nmodule.exports = function removeUnusedArrayFilters(update\x2C arrayFilters) {\n  const updateKeys = Object.keys(update).\n    map(key => Object.keys(update[key])).\n    reduce((cur\x2C arr) => cur.concat(arr)\x2C []);\n  return arrayFilters.filter(obj => {\n    return _checkSingleFilterKey(obj\x2C updateKeys);\n  });\n};\n\nfunction _checkSingleFilterKey(arrayFilter\x2C updateKeys) {\n  const firstKey = Object.keys(arrayFilter)[0];\n\n  if (firstKey === '$and' || firstKey === '$or') {\n    if (!Array.isArray(arrayFilter[firstKey])) {\n      return false;\n    }\n    return arrayFilter[firstKey].find(filter => _checkSingleFilterKey(filter\x2C updateKeys)) != null;\n  }\n\n  const firstDot = firstKey.indexOf('.');\n  const arrayFilterKey = firstDot === -1 ? firstKey : firstKey.slice(0\x2C firstDot);\n\n  return updateKeys.find(key => key.includes('$[' + arrayFilterKey + ']')) != null;\n}\n
