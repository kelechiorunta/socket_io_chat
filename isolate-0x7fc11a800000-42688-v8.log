script-source,413,file:///Users/mac/Kelechi/node-chat-app/server/model/ChatMessage.js,import mongoose from 'mongoose';\nimport ChatPicture from './ChatPicture.js';\n\nconst chatMessageSchema = new mongoose.Schema(\n  {\n    chat: { type: mongoose.Schema.Types.ObjectId\x2C ref: 'Chat' }\x2C\n    sender: { type: mongoose.Schema.Types.ObjectId\x2C ref: 'User' }\x2C\n    receiver: { type: mongoose.Schema.Types.ObjectId\x2C ref: 'User' }\x2C\n    content: { type: String\x2C required: true }\x2C\n    hasImage: { type: Boolean\x2C default: false }\x2C\n    imageFileId: { type: mongoose.Schema.Types.ObjectId\x2C ref: 'ChatPicture'\x2C required: false }\x2C\n    imageUrl: { type: String\x2C required: false }\x2C\n    placeholderImgId: { type: mongoose.Schema.Types.ObjectId\x2C required: false }\x2C\n    placeholderUrl: { type: String\x2C required: false }\n  }\x2C\n  { timestamps: true }\n);\n\n// \ud83d\udc47 After saving\x2C if message has an imageFileId\x2C create ChatPicture entry\nchatMessageSchema.post('save'\x2C async function (doc\x2C next) {\n  try {\n    if (doc.hasImage && doc.imageFileId) {\n      await ChatPicture.create({\n        fileId: doc.imageFileId\x2C\n        senderId: doc.sender\x2C\n        receiverId: doc.receiver\x2C\n        messageId: doc._id\x2C\n        pictureUrl: `/chat-pictures/${doc.imageFileId.toString()}`\n      });\n    }\n    next();\n  } catch (err) {\n    next(err);\n  }\n});\nconst ChatMessage = mongoose.Model.ChatMessage || mongoose.model('ChatMessage'\x2C chatMessageSchema);\nexport default ChatMessage;\n
