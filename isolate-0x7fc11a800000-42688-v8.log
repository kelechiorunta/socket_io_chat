script-source,778,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/merge/esm/typedefs-mergers/scalar.js,import { Kind\x2C } from 'graphql';\nimport { mergeDirectives } from './directives.js';\nexport function mergeScalar(node\x2C existingNode\x2C config\x2C directives) {\n    if (existingNode) {\n        return {\n            name: node.name\x2C\n            description: node['description'] || existingNode['description']\x2C\n            kind: config?.convertExtensions ||\n                node.kind === 'ScalarTypeDefinition' ||\n                existingNode.kind === 'ScalarTypeDefinition'\n                ? 'ScalarTypeDefinition'\n                : 'ScalarTypeExtension'\x2C\n            loc: node.loc\x2C\n            directives: mergeDirectives(node.directives\x2C existingNode.directives\x2C config\x2C directives)\x2C\n        };\n    }\n    return config?.convertExtensions\n        ? {\n            ...node\x2C\n            kind: Kind.SCALAR_TYPE_DEFINITION\x2C\n        }\n        : node;\n}\n
