script-source,2001,/Users/mac/Kelechi/node-chat-app/node_modules/semver/ranges/max-satisfying.js,'use strict'\n\nconst SemVer = require('../classes/semver')\nconst Range = require('../classes/range')\n\nconst maxSatisfying = (versions\x2C range\x2C options) => {\n  let max = null\n  let maxSV = null\n  let rangeObj = null\n  try {\n    rangeObj = new Range(range\x2C options)\n  } catch (er) {\n    return null\n  }\n  versions.forEach((v) => {\n    if (rangeObj.test(v)) {\n      // satisfies(v\x2C range\x2C options)\n      if (!max || maxSV.compare(v) === -1) {\n        // compare(max\x2C v\x2C true)\n        max = v\n        maxSV = new SemVer(max\x2C options)\n      }\n    }\n  })\n  return max\n}\nmodule.exports = maxSatisfying\n
