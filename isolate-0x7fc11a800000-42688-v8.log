script-source,418,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/schema/esm/assertResolversPresent.js,import { getNamedType\x2C isScalarType } from 'graphql';\nimport { forEachField } from '@graphql-tools/utils';\nexport function assertResolversPresent(schema\x2C resolverValidationOptions = {}) {\n    const { requireResolversForArgs\x2C requireResolversForNonScalar\x2C requireResolversForAllFields } = resolverValidationOptions;\n    if (requireResolversForAllFields && (requireResolversForArgs || requireResolversForNonScalar)) {\n        throw new TypeError('requireResolversForAllFields takes precedence over the more specific assertions. ' +\n            'Please configure either requireResolversForAllFields or requireResolversForArgs / ' +\n            'requireResolversForNonScalar\x2C but not a combination of them.');\n    }\n    forEachField(schema\x2C (field\x2C typeName\x2C fieldName) => {\n        // requires a resolver for *every* field.\n        if (requireResolversForAllFields) {\n            expectResolver('requireResolversForAllFields'\x2C requireResolversForAllFields\x2C field\x2C typeName\x2C fieldName);\n        }\n        // requires a resolver on every field that has arguments\n        if (requireResolversForArgs && field.args.length > 0) {\n            expectResolver('requireResolversForArgs'\x2C requireResolversForArgs\x2C field\x2C typeName\x2C fieldName);\n        }\n        // requires a resolver on every field that returns a non-scalar type\n        if (requireResolversForNonScalar !== 'ignore' && !isScalarType(getNamedType(field.type))) {\n            expectResolver('requireResolversForNonScalar'\x2C requireResolversForNonScalar\x2C field\x2C typeName\x2C fieldName);\n        }\n    });\n}\nfunction expectResolver(validator\x2C behavior\x2C field\x2C typeName\x2C fieldName) {\n    if (!field.resolve) {\n        const message = `Resolver missing for "${typeName}.${fieldName}".\nTo disable this validator\x2C use:\n  resolverValidationOptions: {\n    ${validator}: 'ignore'\n  }`;\n        if (behavior === 'error') {\n            throw new Error(message);\n        }\n        if (behavior === 'warn') {\n            console.warn(message);\n        }\n        return;\n    }\n    if (typeof field.resolve !== 'function') {\n        throw new Error(`Resolver "${typeName}.${fieldName}" must be a function`);\n    }\n}\n
