fakeRejectPromise(err);\n                }\n            }\n            return this;\n        }\x2C\n        [Symbol.toStringTag]: 'Promise'\x2C\n        __fakePromiseValue: value\x2C\n        [kFakePromise]: 'resolved'\x2C\n    };\n}\nexport function createDeferredPromise() {\n    if (Promise.withResolvers) {\n        return Promise.withResolvers();\n    }\n    let resolveFn;\n    let rejectFn;\n    const promise = new Promise(function deferredPromiseExecutor(resolve\x2C reject) {\n        resolveFn = resolve;\n        rejectFn = reject;\n    });\n    return {\n        promise\x2C\n        get resolve() {\n            return resolveFn;\n        }\x2C\n        get reject() {\n            return rejectFn;\n        }\x2C\n    };\n}\nexport { iterateAsync as iterateAsyncVoid };\nexport function iterateAsync(iterable\x2C callback\x2C results) {\n    if (iterable?.length === 0) {\n        return;\n    }\n    const iterator = iterable[Symbol.iterator]();\n    let index = 0;\n    function iterate() {\n        const { done: endOfIterator\x2C value } = iterator.next();\n        if (endOfIterator) {\n            return;\n        }\n        let endedEarly = false;\n        function endEarly() {\n            endedEarly = true;\n        }\n        return handleMaybePromise(function handleCallback() {\n            return callback(value\x2C endEarly\x2C index++);\n        }\x2C function handleCallbackResult(result) {\n            if (result) {\n                results?.push(result);\n            }\n            if (endedEarly) {\n                return;\n            }\n            return iterate();\n        });\n    }\n    return iterate();\n}\nexport function fakeRejectPromise(error) {\n    return {\n        then(_resolve\x2C reject) {\n            if (reject) {\n                try {\n                    return fakePromise(reject(error));\n                }\n                catch (err) {\n                    return fakeRejectPromise(err);\n                }\n            }\n       