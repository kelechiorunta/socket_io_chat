script-source,664,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/utils/esm/filterSchema.js,import { GraphQLInputObjectType\x2C GraphQLInterfaceType\x2C GraphQLObjectType\x2C } from 'graphql';\nimport { MapperKind\x2C } from './Interfaces.js';\nimport { mapSchema } from './mapSchema.js';\nexport function filterSchema({ schema\x2C typeFilter = () => true\x2C fieldFilter = undefined\x2C rootFieldFilter = undefined\x2C objectFieldFilter = undefined\x2C interfaceFieldFilter = undefined\x2C inputObjectFieldFilter = undefined\x2C argumentFilter = undefined\x2C directiveFilter = undefined\x2C enumValueFilter = undefined\x2C }) {\n    const filteredSchema = mapSchema(schema\x2C {\n        [MapperKind.QUERY]: (type) => filterRootFields(type\x2C 'Query'\x2C rootFieldFilter\x2C argumentFilter)\x2C\n        [MapperKind.MUTATION]: (type) => filterRootFields(type\x2C 'Mutation'\x2C rootFieldFilter\x2C argumentFilter)\x2C\n        [MapperKind.SUBSCRIPTION]: (type) => filterRootFields(type\x2C 'Subscription'\x2C rootFieldFilter\x2C argumentFilter)\x2C\n        [MapperKind.OBJECT_TYPE]: (type) => typeFilter(type.name\x2C type)\n            ? filterElementFields(GraphQLObjectType\x2C type\x2C objectFieldFilter || fieldFilter\x2C argumentFilter)\n            : null\x2C\n        [MapperKind.INTERFACE_TYPE]: (type) => typeFilter(type.name\x2C type)\n            ? filterElementFields(GraphQLInterfaceType\x2C type\x2C interfaceFieldFilter || fieldFilter\x2C argumentFilter)\n            : null\x2C\n        [MapperKind.INPUT_OBJECT_TYPE]: (type) => typeFilter(type.name\x2C type)\n            ? filterElementFields(GraphQLInputObjectType\x2C type\x2C inputObjectFieldFilter || fieldFilter)\n            : null\x2C\n        [MapperKind.UNION_TYPE]: (type) => typeFilter(type.name\x2C type) ? undefined : null\x2C\n        [MapperKind.ENUM_TYPE]: (type) => typeFilter(type.name\x2C type) ? undefined : null\x2C\n        [MapperKind.SCALAR_TYPE]: (type) => typeFilter(type.name\x2C type) ? undefined : null\x2C\n        [MapperKind.DIRECTIVE]: directive => directiveFilter && !directiveFilter(directive.name\x2C directive) ? null : undefined\x2C\n        [MapperKind.ENUM_VALUE]: (valueConfig\x2C typeName\x2C _schema\x2C externalValue) => enumValueFilter && !enumValueFilter(typeName\x2C externalValue\x2C valueConfig) ? null : undefined\x2C\n    });\n    return filteredSchema;\n}\nfunction filterRootFields(type\x2C operation\x2C rootFieldFilter\x2C argumentFilter) {\n    if (rootFieldFilter || argumentFilter) {\n        const config = type.toConfig();\n        for (const fieldName in config.fields) {\n            const field = config.fields[fieldName];\n            if (rootFieldFilter && !rootFieldFilter(operation\x2C fieldName\x2C config.fields[fieldName])) {\n                delete config.fields[fieldName];\n            }\n            else if (argumentFilter && field.args) {\n                for (const argName in field.args) {\n                    if (!argumentFilter(type.name\x2C fieldName\x2C argName\x2C field.args[argName])) {\n                        delete field.args[argName];\n                    }\n                }\n            }\n        }\n        return new GraphQLObjectType(config);\n    }\n    return type;\n}\nfunction filterElementFields(ElementConstructor\x2C type\x2C fieldFilter\x2C argumentFilter) {\n    if (fieldFilter || argumentFilter) {\n        const config = type.toConfig();\n        for (const fieldName in config.fields) {\n            const field = config.fields[fieldName];\n            if (fieldFilter && !fieldFilter(type.name\x2C fieldName\x2C config.fields[fieldName])) {\n                delete config.fields[fieldName];\n            }\n            else if (argumentFilter && 'args' in field) {\n                for (const argName in field.args) {\n                    if (!argumentFilter(type.name\x2C fieldName\x2C argName\x2C field.args[argName])) {\n                        delete field.args[argName];\n                    }\n                }\n            }\n        }\n        return new ElementConstructor(config);\n    }\n}\n
