object') {\n    throw typeError(MSG_INVALID_SECRET);\n  }\n\n  if (key.type !== 'secret') {\n    throw typeError(MSG_INVALID_SECRET);\n  }\n\n  if (typeof key.export !== 'function') {\n    throw typeError(MSG_INVALID_SECRET);\n  }\n}\n\nfunction fromBase64(base64) {\n  return base64\n    .replace(/=/g\x2C '')\n    .replace(/\\+/g\x2C '-')\n    .replace(/\\//g\x2C '_');\n}\n\nfunction toBase64(base64url) {\n  base64url = base64url.toString();\n\n  var padding = 4 - base64url.length % 4;\n  if (padding !== 4) {\n    for (var i = 0; i < padding; ++i) {\n      base64url += '=';\n    }\n  }\n\n  return base64url\n    .replace(/\\-/g\x2C '+')\n    .replace(/_/g\x2C '/');\n}\n\nfunction typeError(template) {\n  var args = [].slice.call(arguments\x2C 1);\n  var errMsg = util.format.bind(util\x2C template).apply(null\x2C args);\n  return new TypeError(errMsg);\n}\n\nfunction bufferOrString(obj) {\n  return Buffer.isBuffer(obj) || typeof obj === 'string';\n}\n\nfunction normalizeInput(thing) {\n  if (!bufferOrString(thing))\n    thing = JSON.stringify(thing);\n  return thing;\n}\n\nfunction createHmacSigner(bits) {\n  return function sign(thing\x2C secret) {\n    checkIsSecretKey(secret);\n    thing = normalizeInput(thing);\n    var hmac = crypto.createHmac('sha' + bits\x2C secret);\n    var sig = (hmac.update(thing)\x2C hmac.digest('base64'))\n    return fromBase64(sig);\n  }\n}\n\nvar bufferEqual;\nvar timingSafeEqual = 'timingSafeEqual' in crypto ? function timingSafeEqual(a\x2C b) {\n  if (a.byteLength !== b.byteLength) {\n    return false;\n  }\n\n  return crypto.timingSafeEqual(a\x2C b)\n} : function timingSafeEqual(a\x2C b) {\n  if (!bufferEqual) {\n    bufferEqual = require('buffer-equal-constant-time');\n  }\n\n  return bufferEqual(a\x2C b)\n}\n\nfunction createHmacVerifier(bits) {\n  return function verify(thing\x2C signature\x2C secret) {\n    var computedSig = createHmacSigner(bits)(thing\x2C secret);\n    return timingSafeEqual(Buffer.from(signature)\x2C Buffer.f