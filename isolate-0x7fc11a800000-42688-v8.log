script-source,2183,/Users/mac/Kelechi/node-chat-app/node_modules/nodemailer/lib/smtp-pool/pool-resource.js,'use strict';\n\nconst SMTPConnection = require('../smtp-connection');\nconst assign = require('../shared').assign;\nconst XOAuth2 = require('../xoauth2');\nconst EventEmitter = require('events');\n\n/**\n * Creates an element for the pool\n *\n * @constructor\n * @param {Object} options SMTPPool instance\n */\nclass PoolResource extends EventEmitter {\n    constructor(pool) {\n        super();\n\n        this.pool = pool;\n        this.options = pool.options;\n        this.logger = this.pool.logger;\n\n        if (this.options.auth) {\n            switch ((this.options.auth.type || '').toString().toUpperCase()) {\n                case 'OAUTH2': {\n                    let oauth2 = new XOAuth2(this.options.auth\x2C this.logger);\n                    oauth2.provisionCallback = (this.pool.mailer && this.pool.mailer.get('oauth2_provision_cb')) || oauth2.provisionCallback;\n                    this.auth = {\n                        type: 'OAUTH2'\x2C\n                        user: this.options.auth.user\x2C\n                        oauth2\x2C\n                        method: 'XOAUTH2'\n                    };\n                    oauth2.on('token'\x2C token => this.pool.mailer.emit('token'\x2C token));\n                    oauth2.on('error'\x2C err => this.emit('error'\x2C err));\n                    break;\n                }\n                default:\n                    if (!this.options.auth.user && !this.options.auth.pass) {\n                        break;\n                    }\n                    this.auth = {\n                        type: (this.options.auth.type || '').toString().toUpperCase() || 'LOGIN'\x2C\n                        user: this.options.auth.user\x2C\n                        credentials: {\n                            user: this.options.auth.user || ''\x2C\n                            pass: this.options.auth.pass\x2C\n                            options: this.options.auth.options\n                        }\x2C\n                        method: (this.options.auth.method || '').trim().toUpperCase() || this.options.authMethod || false\n                    };\n            }\n        }\n\n        this._connection = false;\n        this._connected = false;\n\n        this.messages = 0;\n        this.available = true;\n    }\n\n    /**\n     * Initiates a connection to the SMTP server\n     *\n     * @param {Function} callback Callback function to run once the connection is established or failed\n     */\n    connect(callback) {\n        this.pool.getSocket(this.options\x2C (err\x2C socketOptions) => {\n            if (err) {\n                return callback(err);\n            }\n\n            let returned = false;\n            let options = this.options;\n            if (socketOptions && socketOptions.connection) {\n                this.logger.info(\n                    {\n                        tnx: 'proxy'\x2C\n                        remoteAddress: socketOptions.connection.remoteAddress\x2C\n                        remotePort: socketOptions.connection.remotePort\x2C\n                        destHost: options.host || ''\x2C\n                        destPort: options.port || ''\x2C\n                        action: 'connected'\n                    }\x2C\n                    'Using proxied socket from %s:%s to %s:%s'\x2C\n                    socketOptions.connection.remoteAddress\x2C\n                    socketOptions.connection.remotePort\x2C\n                    options.host || ''\x2C\n                    options.port || ''\n                );\n\n                options = assign(false\x2C options);\n                Object.keys(socketOptions).forEach(key => {\n                    options[key] = socketOptions[key];\n                });\n            }\n\n            this.connection = new SMTPConnection(options);\n\n            this.connection.once('error'\x2C err => {\n                this.emit('error'\x2C err);\n                if (returned) {\n                    return;\n                }\n                returned = true;\n                return callback(err);\n            });\n\n            this.connection.once('end'\x2C () => {\n                this.close();\n                if (returned) {\n                    return;\n                }\n                returned = true;\n\n                let timer = setTimeout(() => {\n                    if (returned) {\n                        return;\n                    }\n                    // still have not returned\x2C this means we have an unexpected connection close\n                    let err = new Error('Unexpected socket close');\n                    if (this.connection && this.connection._socket && this.connection._socket.upgrading) {\n                        // starttls connection errors\n                        err.code = 'ETLS';\n                    }\n                    callback(err);\n                }\x2C 1000);\n\n                try {\n                    timer.unref();\n                } catch (E) {\n                    // Ignore. Happens on envs with non-node timer implementation\n                }\n            });\n\n            this.connection.connect(() => {\n                if (returned) {\n                    return;\n                }\n\n                if (this.auth && (this.connection.allowsAuth || options.forceAuth)) {\n                    this.connection.login(this.auth\x2C err => {\n                        if (returned) {\n                            return;\n                        }\n                        returned = true;\n\n                        if (err) {\n                            this.connection.close();\n                            this.emit('error'\x2C err);\n                            return callback(err);\n                        }\n\n                        this._connected = true;\n                        callback(null\x2C true);\n                    });\n                } else {\n                    returned = true;\n                    this._connected = true;\n                    return callback(null\x2C true);\n                }\n            });\n        });\n    }\n\n    /**\n     * Sends an e-mail to be sent using the selected settings\n     *\n     * @param {Object} mail Mail object\n     * @param {Function} callback Callback function\n     */\n    send(mail\x2C callback) {\n        if (!this._connected) {\n            return this.connect(err => {\n                if (err) {\n                    return callback(err);\n                }\n                return this.send(mail\x2C callback);\n            });\n        }\n\n        let envelope = mail.message.getEnvelope();\n        let messageId = mail.message.messageId();\n\n        let recipients = [].concat(envelope.to || []);\n        if (recipients.length > 3) {\n            recipients.push('...and ' + recipients.splice(2).length + ' more');\n        }\n        this.logger.info(\n            {\n                tnx: 'send'\x2C\n                messageId\x2C\n                cid: this.id\n            }\x2C\n            'Sending message %s using #%s to <%s>'\x2C\n            messageId\x2C\n            this.id\x2C\n            recipients.join('\x2C ')\n        );\n\n        if (mail.data.dsn) {\n            envelope.dsn = mail.data.dsn;\n        }\n\n        this.connection.send(envelope\x2C mail.message.createReadStream()\x2C (err\x2C info) => {\n            this.messages++;\n\n            if (err) {\n                this.connection.close();\n                this.emit('error'\x2C err);\n                return callback(err);\n            }\n\n            info.envelope = {\n                from: envelope.from\x2C\n                to: envelope.to\n            };\n            info.messageId = messageId;\n\n            setImmediate(() => {\n                let err;\n                if (this.messages >= this.options.maxMessages) {\n                    err = new Error('Resource exhausted');\n                    err.code = 'EMAXLIMIT';\n                    this.connection.close();\n                    this.emit('error'\x2C err);\n                } else {\n                    this.pool._checkRateLimit(() => {\n                        this.available = true;\n                        this.emit('available');\n                    });\n                }\n            });\n\n            callback(null\x2C info);\n        });\n    }\n\n    /**\n     * Closes the connection\n     */\n    close() {\n        this._connected = false;\n        if (this.auth && this.auth.oauth2) {\n            this.auth.oauth2.removeAllListeners();\n        }\n        if (this.connection) {\n            this.connection.close();\n        }\n        this.emit('close');\n    }\n}\n\nmodule.exports = PoolResource;\n
