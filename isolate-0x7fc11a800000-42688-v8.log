script-source,659,file:///Users/mac/Kelechi/node-chat-app/node_modules/@graphql-tools/utils/esm/print-schema-with-directives.js,import { GraphQLDeprecatedDirective\x2C isEnumType\x2C isInputObjectType\x2C isInterfaceType\x2C isIntrospectionType\x2C isObjectType\x2C isScalarType\x2C isSpecifiedDirective\x2C isSpecifiedScalarType\x2C isUnionType\x2C Kind\x2C print\x2C specifiedDirectives\x2C } from 'graphql';\nimport { astFromType } from './astFromType.js';\nimport { astFromValue } from './astFromValue.js';\nimport { astFromValueUntyped } from './astFromValueUntyped.js';\nimport { getDescriptionNode } from './descriptionFromObject.js';\nimport { getDirectivesInExtensions\x2C } from './get-directives.js';\nimport { isSome } from './helpers.js';\nimport { getRootTypeMap } from './rootTypes.js';\nexport function getDocumentNodeFromSchema(schema\x2C options = {}) {\n    const pathToDirectivesInExtensions = options.pathToDirectivesInExtensions;\n    const typesMap = schema.getTypeMap();\n    const schemaNode = astFromSchema(schema\x2C pathToDirectivesInExtensions);\n    const definitions = schemaNode != null ? [schemaNode] : [];\n    const directives = schema.getDirectives();\n    for (const directive of directives) {\n        if (isSpecifiedDirective(directive)) {\n            continue;\n        }\n        definitions.push(astFromDirective(directive\x2C schema\x2C pathToDirectivesInExtensions));\n    }\n    for (const typeName in typesMap) {\n        const type = typesMap[typeName];\n        const isPredefinedScalar = isSpecifiedScalarType(type);\n        const isIntrospection = isIntrospectionType(type);\n        if (isPredefinedScalar || isIntrospection) {\n            continue;\n        }\n        if (isObjectType(type)) {\n            definitions.push(astFromObjectType(type\x2C schema\x2C pathToDirectivesInExtensions));\n        }\n        else if (isInterfaceType(type)) {\n            definitions.push(astFromInterfaceType(type\x2C schema\x2C pathToDirectivesInExtensions));\n        }\n        else if (isUnionType(type)) {\n            definitions.push(astFromUnionType(type\x2C schema\x2C pathToDirectivesInExtensions));\n        }\n        else if (isInputObjectType(type)) {\n            definitions.push(astFromInputObjectType(type\x2C schema\x2C pathToDirectivesInExtensions));\n        }\n        else if (isEnumType(type)) {\n            definitions.push(astFromEnumType(type\x2C schema\x2C pathToDirectivesInExtensions));\n        }\n        else if (isScalarType(type)) {\n            definitions.push(astFromScalarType(type\x2C schema\x2C pathToDirectivesInExtensions));\n        }\n        else {\n            throw new Error(`Unknown type ${type}.`);\n        }\n    }\n    return {\n        kind: Kind.DOCUMENT\x2C\n        definitions\x2C\n    };\n}\n// this approach uses the default schema printer rather than a custom solution\x2C so may be more backwards compatible\n// currently does not allow customization of printSchema options having to do with comments.\nexport function printSchemaWithDirectives(schema\x2C options = {}) {\n    const documentNode = getDocumentNodeFromSchema(schema\x2C options);\n    return print(documentNode);\n}\nexport function astFromSchema(schema\x2C pathToDirectivesInExtensions) {\n    const operationTypeMap = new Map([\n        ['query'\x2C undefined]\x2C\n        ['mutation'\x2C undefined]\x2C\n        ['subscription'\x2C undefined]\x2C\n    ]);\n    const nodes = [];\n    if (schema.astNode != null) {\n        nodes.push(schema.astNode);\n    }\n    if (schema.extensionASTNodes != null) {\n        for (const extensionASTNode of schema.extensionASTNodes) {\n            nodes.push(extensionASTNode);\n        }\n    }\n    for (const node of nodes) {\n        if (node.operationTypes) {\n            for (const operationTypeDefinitionNode of node.operationTypes) {\n                operationTypeMap.set(operationTypeDefinitionNode.operation\x2C operationTypeDefinitionNode);\n            }\n        }\n    }\n    const rootTypeMap = getRootTypeMap(schema);\n    for (const [operationTypeNode\x2C operationTypeDefinitionNode] of operationTypeMap) {\n        const rootType = rootTypeMap.get(operationTypeNode);\n        if (rootType != null) {\n            const rootTypeAST = astFromType(rootType);\n            if (operationTypeDefinitionNode != null) {\n                operationTypeDefinitionNode.type = rootTypeAST;\n            }\n            else {\n                operationTypeMap.set(operationTypeNode\x2C {\n                    kind: Kind.OPERATION_TYPE_DEFINITION\x2C\n                    operation: operationTypeNode\x2C\n                    type: rootTypeAST\x2C\n                });\n            }\n        }\n    }\n    const operationTypes = [...operationTypeMap.values()].filter(isSome);\n    const directives = getDirectiveNodes(schema\x2C schema\x2C pathToDirectivesInExtensions);\n    if (!operationTypes.length && !directives.length) {\n        return null;\n    }\n    const schemaNode = {\n        kind: operationTypes != null ? Kind.SCHEMA_DEFINITION : Kind.SCHEMA_EXTENSION\x2C\n        operationTypes\x2C\n        // ConstXNode has been introduced in v16 but it is not compatible with XNode so we do `as any` for backwards compatibility\n        directives: directives\x2C\n    };\n    const descriptionNode = getDescriptionNode(schema);\n    if (descriptionNode) {\n        schemaNode.description = descriptionNode;\n    }\n    return schemaNode;\n}\nexport function astFromDirective(directive\x2C schema\x2C pathToDirectivesInExtensions) {\n    return {\n        kind: Kind.DIRECTIVE_DEFINITION\x2C\n        description: getDescriptionNode(directive)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: directive.name\x2C\n        }\x2C\n        arguments: directive.args?.map(arg => astFromArg(arg\x2C schema\x2C pathToDirectivesInExtensions))\x2C\n        repeatable: directive.isRepeatable\x2C\n        locations: directive.locations?.map(location => ({\n            kind: Kind.NAME\x2C\n            value: location\x2C\n        })) || []\x2C\n    };\n}\nexport function getDirectiveNodes(entity\x2C schema\x2C pathToDirectivesInExtensions) {\n    let directiveNodesBesidesNativeDirectives = [];\n    const directivesInExtensions = getDirectivesInExtensions(entity\x2C pathToDirectivesInExtensions);\n    let directives;\n    if (directivesInExtensions != null) {\n        directives = makeDirectiveNodes(schema\x2C directivesInExtensions);\n    }\n    let deprecatedDirectiveNode = null;\n    let specifiedByDirectiveNode = null;\n    let oneOfDirectiveNode = null;\n    if (directives != null) {\n        directiveNodesBesidesNativeDirectives = directives.filter(directive => specifiedDirectives.every(specifiedDirective => specifiedDirective.name !== directive.name.value));\n        deprecatedDirectiveNode = directives.find(directive => directive.name.value === 'deprecated');\n        specifiedByDirectiveNode = directives.find(directive => directive.name.value === 'specifiedBy');\n        oneOfDirectiveNode = directives.find(directive => directive.name.value === 'oneOf');\n    }\n    if (entity.deprecationReason != null && deprecatedDirectiveNode == null) {\n        deprecatedDirectiveNode = makeDeprecatedDirective(entity.deprecationReason);\n    }\n    if (entity.specifiedByUrl != null ||\n        (entity.specifiedByURL != null && specifiedByDirectiveNode == null)) {\n        const specifiedByValue = entity.specifiedByUrl || entity.specifiedByURL;\n        const specifiedByArgs = {\n            url: specifiedByValue\x2C\n        };\n        specifiedByDirectiveNode = makeDirectiveNode('specifiedBy'\x2C specifiedByArgs);\n    }\n    if (entity.isOneOf && oneOfDirectiveNode == null) {\n        oneOfDirectiveNode = makeDirectiveNode('oneOf');\n    }\n    if (deprecatedDirectiveNode != null) {\n        directiveNodesBesidesNativeDirectives.push(deprecatedDirectiveNode);\n    }\n    if (specifiedByDirectiveNode != null) {\n        directiveNodesBesidesNativeDirectives.push(specifiedByDirectiveNode);\n    }\n    if (oneOfDirectiveNode != null) {\n        directiveNodesBesidesNativeDirectives.push(oneOfDirectiveNode);\n    }\n    return directiveNodesBesidesNativeDirectives;\n}\nexport function astFromArg(arg\x2C schema\x2C pathToDirectivesInExtensions) {\n    return {\n        kind: Kind.INPUT_VALUE_DEFINITION\x2C\n        description: getDescriptionNode(arg)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: arg.name\x2C\n        }\x2C\n        type: astFromType(arg.type)\x2C\n        // ConstXNode has been introduced in v16 but it is not compatible with XNode so we do `as any` for backwards compatibility\n        defaultValue: arg.defaultValue !== undefined\n            ? (astFromValue(arg.defaultValue\x2C arg.type) ?? undefined)\n            : undefined\x2C\n        directives: getDirectiveNodes(arg\x2C schema\x2C pathToDirectivesInExtensions)\x2C\n    };\n}\nexport function astFromObjectType(type\x2C schema\x2C pathToDirectivesInExtensions) {\n    return {\n        kind: Kind.OBJECT_TYPE_DEFINITION\x2C\n        description: getDescriptionNode(type)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: type.name\x2C\n        }\x2C\n        fields: Object.values(type.getFields()).map(field => astFromField(field\x2C schema\x2C pathToDirectivesInExtensions))\x2C\n        interfaces: Object.values(type.getInterfaces()).map(iFace => astFromType(iFace))\x2C\n        directives: getDirectiveNodes(type\x2C schema\x2C pathToDirectivesInExtensions)\x2C\n    };\n}\nexport function astFromInterfaceType(type\x2C schema\x2C pathToDirectivesInExtensions) {\n    const node = {\n        kind: Kind.INTERFACE_TYPE_DEFINITION\x2C\n        description: getDescriptionNode(type)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: type.name\x2C\n        }\x2C\n        fields: Object.values(type.getFields()).map(field => astFromField(field\x2C schema\x2C pathToDirectivesInExtensions))\x2C\n        directives: getDirectiveNodes(type\x2C schema\x2C pathToDirectivesInExtensions)\x2C\n    };\n    if ('getInterfaces' in type) {\n        node.interfaces = Object.values(type.getInterfaces()).map(iFace => astFromType(iFace));\n    }\n    return node;\n}\nexport function astFromUnionType(type\x2C schema\x2C pathToDirectivesInExtensions) {\n    return {\n        kind: Kind.UNION_TYPE_DEFINITION\x2C\n        description: getDescriptionNode(type)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: type.name\x2C\n        }\x2C\n        // ConstXNode has been introduced in v16 but it is not compatible with XNode so we do `as any` for backwards compatibility\n        directives: getDirectiveNodes(type\x2C schema\x2C pathToDirectivesInExtensions)\x2C\n        types: type.getTypes().map(type => astFromType(type))\x2C\n    };\n}\nexport function astFromInputObjectType(type\x2C schema\x2C pathToDirectivesInExtensions) {\n    return {\n        kind: Kind.INPUT_OBJECT_TYPE_DEFINITION\x2C\n        description: getDescriptionNode(type)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: type.name\x2C\n        }\x2C\n        fields: Object.values(type.getFields()).map(field => astFromInputField(field\x2C schema\x2C pathToDirectivesInExtensions))\x2C\n        // ConstXNode has been introduced in v16 but it is not compatible with XNode so we do `as any` for backwards compatibility\n        directives: getDirectiveNodes(type\x2C schema\x2C pathToDirectivesInExtensions)\x2C\n    };\n}\nexport function astFromEnumType(type\x2C schema\x2C pathToDirectivesInExtensions) {\n    return {\n        kind: Kind.ENUM_TYPE_DEFINITION\x2C\n        description: getDescriptionNode(type)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: type.name\x2C\n        }\x2C\n        values: Object.values(type.getValues()).map(value => astFromEnumValue(value\x2C schema\x2C pathToDirectivesInExtensions))\x2C\n        // ConstXNode has been introduced in v16 but it is not compatible with XNode so we do `as any` for backwards compatibility\n        directives: getDirectiveNodes(type\x2C schema\x2C pathToDirectivesInExtensions)\x2C\n    };\n}\nexport function astFromScalarType(type\x2C schema\x2C pathToDirectivesInExtensions) {\n    const directivesInExtensions = getDirectivesInExtensions(type\x2C pathToDirectivesInExtensions);\n    const directives = makeDirectiveNodes(schema\x2C directivesInExtensions);\n    const specifiedByValue = (type['specifiedByUrl'] ||\n        type['specifiedByURL']);\n    if (specifiedByValue &&\n        !directives.some(directiveNode => directiveNode.name.value === 'specifiedBy')) {\n        const specifiedByArgs = {\n            url: specifiedByValue\x2C\n        };\n        directives.push(makeDirectiveNode('specifiedBy'\x2C specifiedByArgs));\n    }\n    return {\n        kind: Kind.SCALAR_TYPE_DEFINITION\x2C\n        description: getDescriptionNode(type)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: type.name\x2C\n        }\x2C\n        // ConstXNode has been introduced in v16 but it is not compatible with XNode so we do `as any` for backwards compatibility\n        directives: directives\x2C\n    };\n}\nexport function astFromField(field\x2C schema\x2C pathToDirectivesInExtensions) {\n    return {\n        kind: Kind.FIELD_DEFINITION\x2C\n        description: getDescriptionNode(field)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: field.name\x2C\n        }\x2C\n        arguments: field.args.map(arg => astFromArg(arg\x2C schema\x2C pathToDirectivesInExtensions))\x2C\n        type: astFromType(field.type)\x2C\n        // ConstXNode has been introduced in v16 but it is not compatible with XNode so we do `as any` for backwards compatibility\n        directives: getDirectiveNodes(field\x2C schema\x2C pathToDirectivesInExtensions)\x2C\n    };\n}\nexport function astFromInputField(field\x2C schema\x2C pathToDirectivesInExtensions) {\n    return {\n        kind: Kind.INPUT_VALUE_DEFINITION\x2C\n        description: getDescriptionNode(field)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: field.name\x2C\n        }\x2C\n        type: astFromType(field.type)\x2C\n        // ConstXNode has been introduced in v16 but it is not compatible with XNode so we do `as any` for backwards compatibility\n        directives: getDirectiveNodes(field\x2C schema\x2C pathToDirectivesInExtensions)\x2C\n        defaultValue: astFromValue(field.defaultValue\x2C field.type) ?? undefined\x2C\n    };\n}\nexport function astFromEnumValue(value\x2C schema\x2C pathToDirectivesInExtensions) {\n    return {\n        kind: Kind.ENUM_VALUE_DEFINITION\x2C\n        description: getDescriptionNode(value)\x2C\n        name: {\n            kind: Kind.NAME\x2C\n            value: value.name\x2C\n        }\x2C\n        directives: getDirectiveNodes(value\x2C schema\x2C pathToDirectivesInExtensions)\x2C\n    };\n}\nexport function makeDeprecatedDirective(deprecationReason) {\n    return makeDirectiveNode('deprecated'\x2C { reason: deprecationReason }\x2C GraphQLDeprecatedDirective);\n}\nexport function makeDirectiveNode(name\x2C args\x2C directive) {\n    const directiveArguments = [];\n    for (const argName in args) {\n        const argValue = args[argName];\n        let value;\n        if (directive != null) {\n            const arg = directive.args.find(arg => arg.name === argName);\n            if (arg) {\n                value = astFromValue(argValue\x2C arg.type);\n            }\n        }\n        if (value == null) {\n            value = astFromValueUntyped(argValue);\n        }\n        if (value != null) {\n            directiveArguments.push({\n                kind: Kind.ARGUMENT\x2C\n                name: {\n                    kind: Kind.NAME\x2C\n                    value: argName\x2C\n                }\x2C\n                value\x2C\n         