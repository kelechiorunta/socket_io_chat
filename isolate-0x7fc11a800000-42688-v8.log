script-source,1462,/Users/mac/Kelechi/node-chat-app/node_modules/mongoose/lib/helpers/each.js,'use strict';\n\nmodule.exports = function each(arr\x2C cb\x2C done) {\n  if (arr.length === 0) {\n    return done();\n  }\n\n  let remaining = arr.length;\n  let err = null;\n  for (const v of arr) {\n    cb(v\x2C function(_err) {\n      if (err != null) {\n        return;\n      }\n      if (_err != null) {\n        err = _err;\n        return done(err);\n      }\n\n      if (--remaining <= 0) {\n        return done();\n      }\n    });\n  }\n};\n
