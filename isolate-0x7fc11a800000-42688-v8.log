script-source,1002,/Users/mac/Kelechi/node-chat-app/node_modules/socket.io/dist/namespace.js,"use strict";\nvar __importDefault = (this && this.__importDefault) || function (mod) {\n    return (mod && mod.__esModule) ? mod : { "default": mod };\n};\nObject.defineProperty(exports\x2C "__esModule"\x2C { value: true });\nexports.Namespace = exports.RESERVED_EVENTS = void 0;\nconst socket_1 = require("./socket");\nconst typed_events_1 = require("./typed-events");\nconst debug_1 = __importDefault(require("debug"));\nconst broadcast_operator_1 = require("./broadcast-operator");\nconst debug = (0\x2C debug_1.default)("socket.io:namespace");\nexports.RESERVED_EVENTS = new Set(["connect"\x2C "connection"\x2C "new_namespace"]);\n/**\n * A Namespace is a communication channel that allows you to split the logic of your application over a single shared\n * connection.\n *\n * Each namespace has its own:\n *\n * - event handlers\n *\n * ```\n * io.of("/orders").on("connection"\x2C (socket) => {\n *   socket.on("order:list"\x2C () => {});\n *   socket.on("order:create"\x2C () => {});\n * });\n *\n * io.of("/users").on("connection"\x2C (socket) => {\n *   socket.on("user:list"\x2C () => {});\n * });\n * ```\n *\n * - rooms\n *\n * ```\n * const orderNamespace = io.of("/orders");\n *\n * orderNamespace.on("connection"\x2C (socket) => {\n *   socket.join("room1");\n *   orderNamespace.to("room1").emit("hello");\n * });\n *\n * const userNamespace = io.of("/users");\n *\n * userNamespace.on("connection"\x2C (socket) => {\n *   socket.join("room1"); // distinct from the room in the "orders" namespace\n *   userNamespace.to("room1").emit("hol\xe0");\n * });\n * ```\n *\n * - middlewares\n *\n * ```\n * const orderNamespace = io.of("/orders");\n *\n * orderNamespace.use((socket\x2C next) => {\n *   // ensure the socket has access to the "orders" namespace\n * });\n *\n * const userNamespace = io.of("/users");\n *\n * userNamespace.use((socket\x2C next) => {\n *   // ensure the socket has